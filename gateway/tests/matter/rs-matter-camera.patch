+// The current media hooks admit one stream of each kind. Preserve that limit
+// when a revision-2 controller uses the list fields instead of the legacy ID.
+fn requested_stream(
+    legacy: Option<Nullable<u16>>,
+    streams: Option<TLVArray<'_, u16>>,
+) -> Result<Option<Option<u16>>, Error> {
+    let Some(streams) = streams else {
+        return Ok(legacy.map(|value| value.into_option()));
+    };
+    let mut ids = streams.iter();
+    let first = ids.next().transpose()?.ok_or(ErrorCode::ConstraintError)?;
+    if ids.next().transpose()?.is_some() {
+        return Err(ErrorCode::DynamicConstraintError.into());
+    }
+    Ok(Some(Some(first)))
+}
