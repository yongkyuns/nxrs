+#[cfg(test)]
+mod nxrs_reference_tests {
+    use super::*;
+    use crate::tlv::TLVElement;
+
+    #[test]
+    fn stream_lists_keep_ids_and_reject_empty_multi_and_malformed() {
+        // Anonymous TLV arrays containing one, zero, two, or a truncated uint16.
+        let one = TLVArray::new(TLVElement::new(&[0x16, 0x04, 7, 0x18])).unwrap();
+        assert_eq!(requested_stream(None, Some(one)).unwrap(), Some(Some(7)));
+        for bytes in [
+            &[0x16, 0x18][..],
+            &[0x16, 0x04, 7, 0x04, 9, 0x18],
+            &[0x16, 0x05, 7],
+        ] {
+            let values = TLVArray::new(TLVElement::new(bytes)).unwrap();
+            assert!(requested_stream(None, Some(values)).is_err());
+        }
+        assert_eq!(
+            requested_stream(Some(Nullable::some(11)), None).unwrap(),
+            Some(Some(11))
+        );
+        assert_eq!(
+            requested_stream(Some(Nullable::none()), None).unwrap(),
+            Some(None)
+        );
+        assert_eq!(requested_stream(None, None).unwrap(), None);
+    }
+
+    #[test]
+    fn candidate_snapshot_retains_media_index_and_bounds() {
+        let mut buf = Vec::<(String<32>, u16), 1>::new();
+        let mut sink = VecCandidateSink { buf: &mut buf };
+        sink.push("candidate:test", 3).unwrap();
+        assert_eq!(
+            sink.push("candidate:overflow", 0),
+            Err(WebRtcError::ResourceExhausted)
+        );
+        assert_eq!(buf[0].0.as_str(), "candidate:test");
+        assert_eq!(buf[0].1, 3);
+        let mut buf = Vec::<(String<1>, u16), 1>::new();
+        assert_eq!(
+            VecCandidateSink { buf: &mut buf }.push("long", 0),
+            Err(WebRtcError::ResourceExhausted)
+        );
+        assert!(buf.is_empty());
+    }
+}
