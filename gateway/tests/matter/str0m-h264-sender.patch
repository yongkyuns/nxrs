+    /// Keep one compatible H.264 payload and its RTX format on the video m-line.
+    /// Other media sections retain their original indices and parameters.
+    pub fn select_h264_receiver(&mut self, profile_level_id: u32) -> Option<PayloadParams> {
+        let mut video = self.0.media_lines.iter_mut().filter(|line| {
+            line.typ == MediaType::Video && !line.disabled && line.direction() == Direction::RecvOnly
+        });
+        let line = video.next()?;
+        if video.next().is_some() {
+            return None;
+        }
+        let params = line.rtp_params().into_iter().find(|p| {
+            line.pts.contains(&p.pt()) && p.accepts_h264_source(profile_level_id)
+        })?;
+        line.pts.retain(|pt| *pt == params.pt() || Some(*pt) == params.resend());
+        line.attrs.retain(|attr| match attr {
+            MediaAttribute::RtpMap { pt, .. }
+            | MediaAttribute::Fmtp { pt, .. }
+            | MediaAttribute::RtcpFb { pt, .. } => line.pts.contains(pt),
+            _ => true,
+        });
+        Some(params)
+    }
