+    /// Whether this receiver can decode the source SPS in packetization mode 1.
+    pub fn accepts_h264_source(&self, profile_level_id: u32) -> bool {
+        self.spec.codec == Codec::H264
+            && self.spec.clock_rate == Frequency::NINETY_KHZ
+            && self.spec.format.profile_level_id.is_some()
+            && Self::match_h264_score(self.spec, CodecSpec {
+                format: FormatParams {
+                    packetization_mode: Some(1),
+                    profile_level_id: Some(profile_level_id),
+                    ..Default::default()
+                },
+                ..self.spec
+            }).is_some()
     }

