             Store::open(path)
         }
         .map_err(|_| ErrorCode::StdIoError)?;
+        factory.bind(&mut inner, key, initialize).map_err(|_| ErrorCode::Invalid)?;
         let (failure, receiver) = async_channel::bounded(1);
         Ok((Self { inner, failure }, receiver))
     }
