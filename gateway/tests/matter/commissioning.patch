+    pub fn open(
+        path: &Path, initialize: bool, factory: &nxrs_gateway_matter::commissioning::FactoryData, key: u16,
+    ) -> Result<(Self, Receiver<()>), Error> {
+        let mut inner = if initialize {
             Store::initialize(path)
