+//! Generated-source bridge qualification. The private datagram socket lets a
+//! test drive Matter attribute reports independently of camera playback.
+use async_io::Async;
+use rs_matter::dm::clusters::decl::{
+    bridged_device_basic_information as bridge, occupancy_sensing as occ,
+};
+use rs_matter::dm::{AttrChangeNotifier, Cluster, Dataver, InvokeContext, ReadContext};
+use rs_matter::error::{Error, ErrorCode};
+use rs_matter::tlv::{TLVBuilderParent, Utf8StrBuilder};
+use rs_matter::with;
+use std::cell::Cell;
+use std::os::unix::net::UnixDatagram;
+use std::path::Path;
+
+pub struct Bridged {
+    version: Dataver,
+    id: &'static str,
+    pub reachable: Cell<bool>,
+}
+impl Bridged {
+    pub fn new(version: Dataver, id: &'static str, reachable: bool) -> Self {
+        Self {
+            version,
+            id,
+            reachable: Cell::new(reachable),
+        }
+    }
+}
+impl bridge::ClusterHandler for Bridged {
+    const CLUSTER: Cluster<'static> = bridge::FULL_CLUSTER
+        .with_features(0)
+        .with_attrs(with!(required; bridge::AttributeId::UniqueID))
+        .with_cmds(with!());
+    fn dataver(&self) -> u32 {
+        self.version.get()
+    }
+    fn dataver_changed(&self) {
+        self.version.changed();
+    }
+    fn reachable(&self, _: impl ReadContext) -> Result<bool, Error> {
+        Ok(self.reachable.get())
+    }
+    fn unique_id<P: TLVBuilderParent>(
+        &self,
+        _: impl ReadContext,
+        b: Utf8StrBuilder<P>,
+    ) -> Result<P, Error> {
+        b.set(self.id)
+    }
+    fn handle_keep_active(
+        &self,
+        _: impl InvokeContext,
+        _: bridge::KeepActiveRequest<'_>,
+    ) -> Result<(), Error> {
+        Err(ErrorCode::CommandNotFound.into())
+    }
+}
+
+pub struct Occupancy {
+    version: Dataver,
+    occupied: Cell<bool>,
+}
+impl Occupancy {
+    pub fn new(version: Dataver) -> Self {
+        Self {
+            version,
+            occupied: Cell::new(false),
+        }
+    }
+}
+impl occ::ClusterHandler for Occupancy {
+    const CLUSTER: Cluster<'static> = occ::FULL_CLUSTER
+        .with_features(occ::Feature::VISION.bits())
+        .with_attrs(with!(required))
+        .with_cmds(with!());
+    fn dataver(&self) -> u32 {
+        self.version.get()
+    }
+    fn dataver_changed(&self) {
+        self.version.changed();
+    }
+    fn occupancy(&self, _: impl ReadContext) -> Result<occ::OccupancyBitmap, Error> {
+        Ok(if self.occupied.get() {
+            occ::OccupancyBitmap::OCCUPIED
+        } else {
+            occ::OccupancyBitmap::empty()
+        })
+    }
+    fn occupancy_sensor_type(
+        &self,
+        _: impl ReadContext,
+    ) -> Result<occ::OccupancySensorTypeEnum, Error> {
+        Ok(occ::OccupancySensorTypeEnum::PIR)
+    }
+    fn occupancy_sensor_type_bitmap(
+        &self,
+        _: impl ReadContext,
+    ) -> Result<occ::OccupancySensorTypeBitmap, Error> {
+        Ok(occ::OccupancySensorTypeBitmap::empty())
+    }
+}
+
+pub async fn drive(
+    directory: &Path,
+    notifier: &impl AttrChangeNotifier,
+    status: &Bridged,
+    occupancy: &Occupancy,
+) -> Result<(), Error> {
+    let socket = Async::new(UnixDatagram::bind(directory.join("occupancy.sock"))?)?;
+    let mut bytes = [0; 16];
+    loop {
+        let size = socket.recv(&mut bytes).await?;
+        let state = match &bytes[..size] {
+            b"person" => Some(true),
+            b"clear" => Some(false),
+            b"unavailable" => None,
+            _ => continue,
+        };
+        if let Some(value) = state {
+            if value != occupancy.occupied.replace(value) {
+                occupancy.version.changed();
+                notifier.notify_cluster_changed(3, occ::FULL_CLUSTER.id);
+            }
+        }
+        if state.is_some() != status.reachable.replace(state.is_some()) {
+            status.version.changed();
+            notifier.notify_cluster_changed(3, bridge::FULL_CLUSTER.id);
+        }
+    }
+}
