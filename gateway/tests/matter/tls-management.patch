diff --git a/examples/src/bin/tls/mod.rs b/examples/src/bin/tls/mod.rs
new file mode 100644
index 0000000..bca2a72
--- /dev/null
+++ b/examples/src/bin/tls/mod.rs
@@ -0,0 +1,533 @@
+//! Matter command adapters. Storage and certificate admission belong to Nxrs.
+use std::num::NonZeroU8;
+
+use nxrs_gateway_matter::{persistence, tls};
+use rs_matter::{
+    dm::{
+        ArrayAttributeRead, Dataver, HandlerContext, InvokeContext, LifecycleOp, ReadContext,
+        clusters::decl::{tls_certificate_management as cert, tls_client_management as client},
+    },
+    error::{Error, ErrorCode},
+    persist::FABRIC_KEYS_START,
+    tlv::{Nullable, Octets, TLVBuilderParent},
+    utils::epoch::MATTER_EPOCH_SECS,
+};
+
+use super::persistence::StoreAdapter;
+
+pub struct Cluster {
+    store: StoreAdapter,
+    dataver: Dataver,
+}
+
+impl Cluster {
+    pub fn new(store: StoreAdapter, dataver: Dataver) -> Self {
+        Self { store, dataver }
+    }
+
+    fn read_fabrics(&self, ctx: &impl ReadContext) -> Vec<u8> {
+        let attr = ctx.attr();
+        if attr.fab_idx == 0 {
+            Vec::new()
+        } else if attr.fab_filter {
+            vec![attr.fab_idx]
+        } else {
+            self.store
+                .fabric_indices()
+                .map(|key| (key - FABRIC_KEYS_START) as u8)
+                .collect()
+        }
+    }
+
+    fn roots<T>(
+        &self,
+        fabric: u8,
+        f: impl FnOnce(tls::RootCertificates<'_>) -> Result<T, tls::Error>,
+    ) -> Result<T, Error> {
+        self.store
+            .tls(|store| f(tls::RootCertificates::open(store, fabric)?))
+            .map_err(status)
+    }
+
+    fn clients<T>(
+        &self,
+        fabric: u8,
+        f: impl FnOnce(tls::ClientCertificates<'_>) -> Result<T, tls::Error>,
+    ) -> Result<T, Error> {
+        self.store
+            .tls(|store| f(tls::ClientCertificates::open(store, fabric)?))
+            .map_err(status)
+    }
+
+    fn endpoints<T>(
+        &self,
+        fabric: u8,
+        f: impl FnOnce(tls::Endpoints<'_>) -> Result<T, tls::Error>,
+    ) -> Result<T, tls::Error> {
+        self.store
+            .tls(|store| f(tls::Endpoints::open(store, fabric)?))
+    }
+}
+
+fn fabric(ctx: &impl InvokeContext) -> Result<u8, Error> {
+    NonZeroU8::new(ctx.cmd().fab_idx)
+        .map(NonZeroU8::get)
+        .ok_or_else(|| ErrorCode::UnsupportedAccess.into())
+}
+
+fn utc(ctx: &impl HandlerContext) -> Option<i64> {
+    ctx.utc_time()
+        .reliable_secs()?
+        .checked_add(MATTER_EPOCH_SECS)?
+        .try_into()
+        .ok()
+}
+
+fn status(err: tls::Error) -> Error {
+    use tls::Error as T;
+    match err {
+        T::Constraint => ErrorCode::ConstraintError,
+        T::InvalidCertificate | T::InvalidTime => ErrorCode::DynamicConstraintError,
+        T::AlreadyExists => ErrorCode::AlreadyExists,
+        T::NotFound => ErrorCode::NotFound,
+        T::Capacity | T::Storage(persistence::Error::Capacity) => ErrorCode::ResourceExhausted,
+        T::InUse | T::CertificatePending => ErrorCode::InvalidInState,
+        _ => ErrorCode::Failure,
+    }
+    .into()
+}
+
+fn endpoint_status(ctx: &impl InvokeContext, error: tls::Error) -> Error {
+    let cluster = match error {
+        tls::Error::EndpointAlreadyInstalled => client::StatusCodeEnum::EndpointAlreadyInstalled,
+        tls::Error::RootCertificateNotFound => client::StatusCodeEnum::RootCertificateNotFound,
+        tls::Error::ClientCertificateNotFound => client::StatusCodeEnum::ClientCertificateNotFound,
+        _ => return status(error),
+    };
+    ctx.cmd().set_cluster_status(NonZeroU8::new(cluster as u8));
+    ErrorCode::Failure.into()
+}
+
+impl cert::ClusterHandler for Cluster {
+    const CLUSTER: rs_matter::dm::Cluster<'static> = cert::FULL_CLUSTER;
+    fn dataver(&self) -> u32 {
+        self.dataver.get()
+    }
+    fn dataver_changed(&self) {
+        self.dataver.changed();
+    }
+    fn lifecycle(&self, ctx: impl HandlerContext, op: LifecycleOp) -> Result<(), Error> {
+        if matches!(
+            op,
+            LifecycleOp::FabricRemoval { .. } | LifecycleOp::FactoryReset
+        ) {
+            self.dataver.changed();
+            ctx.notify_cluster_changed(0, cert::FULL_CLUSTER.id);
+        }
+        Ok(())
+    }
+
+    fn max_root_certificates(&self, _: impl ReadContext) -> Result<u8, Error> {
+        Ok(tls::MAX_ROOT_CERTIFICATES as u8)
+    }
+
+    fn max_client_certificates(&self, _: impl ReadContext) -> Result<u8, Error> {
+        Ok(tls::MAX_CLIENT_CERTIFICATES as u8)
+    }
+
+    fn provisioned_root_certificates<P: TLVBuilderParent>(
+        &self,
+        ctx: impl ReadContext,
+        builder: ArrayAttributeRead<
+            cert::TLSCertStructArrayBuilder<P>,
+            cert::TLSCertStructBuilder<P>,
+        >,
+    ) -> Result<P, Error> {
+        let mut records = Vec::new();
+        for fabric in self.read_fabrics(&ctx) {
+            let include = ctx.supports_large_payload() && fabric == ctx.attr().fab_idx;
+            records.extend(
+                self.roots(fabric, |roots| roots.list())?
+                    .into_iter()
+                    .map(|(id, der)| (fabric, id, include.then_some(der))),
+            );
+        }
+        match builder {
+            ArrayAttributeRead::ReadAll(mut array) => {
+                for (fabric, id, der) in records {
+                    array = root_record(array.push()?, fabric, id, der.as_deref())?;
+                }
+                array.end()
+            }
+            ArrayAttributeRead::ReadOne(index, item) => {
+                let (fabric, id, der) = records
+                    .get(index as usize)
+                    .ok_or(ErrorCode::ConstraintError)?;
+                root_record(item, *fabric, *id, der.as_deref())
+            }
+            ArrayAttributeRead::ReadNone(array) => array.end(),
+        }
+    }
+
+    fn provisioned_client_certificates<P: TLVBuilderParent>(
+        &self,
+        ctx: impl ReadContext,
+        builder: ArrayAttributeRead<
+            cert::TLSClientCertificateDetailStructArrayBuilder<P>,
+            cert::TLSClientCertificateDetailStructBuilder<P>,
+        >,
+    ) -> Result<P, Error> {
+        let mut records = Vec::new();
+        for fabric in self.read_fabrics(&ctx) {
+            let include = ctx.supports_large_payload() && fabric == ctx.attr().fab_idx;
+            records.extend(
+                self.clients(fabric, |clients| clients.list())?
+                    .into_iter()
+                    .map(|record| (fabric, include, record)),
+            );
+        }
+        match builder {
+            ArrayAttributeRead::ReadAll(mut array) => {
+                for (fabric, include, record) in records {
+                    array = client_record(array.push()?, fabric, &record, include)?;
+                }
+                array.end()
+            }
+            ArrayAttributeRead::ReadOne(index, item) => {
+                let (fabric, include, record) = records
+                    .get(index as usize)
+                    .ok_or(ErrorCode::ConstraintError)?;
+                client_record(item, *fabric, record, *include)
+            }
+            ArrayAttributeRead::ReadNone(array) => array.end(),
+        }
+    }
+
+    fn handle_provision_root_certificate<P: TLVBuilderParent>(
+        &self,
+        ctx: impl InvokeContext,
+        request: cert::ProvisionRootCertificateRequest<'_>,
+        response: cert::ProvisionRootCertificateResponseBuilder<P>,
+    ) -> Result<P, Error> {
+        let id = request.caid()?.into_option();
+        let der = request.certificate()?.0;
+        let id = self.roots(fabric(&ctx)?, |mut roots| {
+            roots.provision(id, der, utc(&ctx))
+        })?;
+        ctx.notify_own_attr_changed(cert::AttributeId::ProvisionedRootCertificates as _);
+        response.caid(id)?.end()
+    }
+
+    fn handle_find_root_certificate<P: TLVBuilderParent>(
+        &self,
+        ctx: impl InvokeContext,
+        request: cert::FindRootCertificateRequest<'_>,
+        response: cert::FindRootCertificateResponseBuilder<P>,
+    ) -> Result<P, Error> {
+        let fabric = fabric(&ctx)?;
+        let filter = requested_id(request.caid()?.into_option())?;
+        let records = self.roots(fabric, |roots| roots.list())?;
+        fit_command(|| {
+            let mut records = records
+                .into_iter()
+                .filter(|(id, _)| filter.is_none_or(|wanted| *id == wanted))
+                .peekable();
+            if records.peek().is_none() {
+                return Err(ErrorCode::NotFound.into());
+            }
+            let mut array = response.certificate_details()?;
+            for (id, der) in records {
+                array = root_record(array.push()?, fabric, id, Some(&der))?;
+            }
+            array.end()?.end()
+        })
+    }
+
+    fn handle_lookup_root_certificate<P: TLVBuilderParent>(
+        &self,
+        ctx: impl InvokeContext,
+        request: cert::LookupRootCertificateRequest<'_>,
+        response: cert::LookupRootCertificateResponseBuilder<P>,
+    ) -> Result<P, Error> {
+        let hash = request.fingerprint()?.0;
+        response
+            .caid(self.roots(fabric(&ctx)?, |roots| roots.lookup(hash))?)?
+            .end()
+    }
+
+    fn handle_remove_root_certificate(
+        &self,
+        ctx: impl InvokeContext,
+        request: cert::RemoveRootCertificateRequest<'_>,
+    ) -> Result<(), Error> {
+        let id = request.caid()?;
+        self.roots(fabric(&ctx)?, |mut roots| roots.remove(id))?;
+        ctx.notify_own_attr_changed(cert::AttributeId::ProvisionedRootCertificates as _);
+        Ok(())
+    }
+
+    fn handle_client_csr<P: TLVBuilderParent>(
+        &self,
+        ctx: impl InvokeContext,
+        request: cert::ClientCSRRequest<'_>,
+        response: cert::ClientCSRResponseBuilder<P>,
+    ) -> Result<P, Error> {
+        let id = request.ccdid()?.into_option();
+        let nonce = request.nonce()?.0;
+        let csr = self.clients(fabric(&ctx)?, |mut clients| clients.request_csr(id, nonce))?;
+        if id.is_none() {
+            ctx.notify_own_attr_changed(cert::AttributeId::ProvisionedClientCertificates as _);
+        }
+        response
+            .ccdid(csr.id)?
+            .csr(Octets(&csr.der))?
+            .nonce_signature(Octets(&csr.nonce_signature))?
+            .end()
+    }
+
+    fn handle_provision_client_certificate(
+        &self,
+        ctx: impl InvokeContext,
+        request: cert::ProvisionClientCertificateRequest<'_>,
+    ) -> Result<(), Error> {
+        let id = request.ccdid()?;
+        let leaf = request.client_certificate()?.0;
+        let mut intermediates = Vec::new();
+        for der in request.intermediate_certificates()?.iter() {
+            if intermediates.len() == tls::MAX_INTERMEDIATE_CERTIFICATES {
+                return Err(ErrorCode::ConstraintError.into());
+            }
+            intermediates.push(der?.0);
+        }
+        self.clients(fabric(&ctx)?, |mut clients| {
+            clients.provision(id, leaf, &intermediates, utc(&ctx))
+        })?;
+        ctx.notify_own_attr_changed(cert::AttributeId::ProvisionedClientCertificates as _);
+        Ok(())
+    }
+
+    fn handle_find_client_certificate<P: TLVBuilderParent>(
+        &self,
+        ctx: impl InvokeContext,
+        request: cert::FindClientCertificateRequest<'_>,
+        response: cert::FindClientCertificateResponseBuilder<P>,
+    ) -> Result<P, Error> {
+        let fabric = fabric(&ctx)?;
+        let filter = requested_id(request.ccdid()?.into_option())?;
+        let records = self.clients(fabric, |clients| clients.list())?;
+        fit_command(|| {
+            let mut records = records
+                .into_iter()
+                .filter(|record| filter.is_none_or(|wanted| record.id == wanted))
+                .peekable();
+            if records.peek().is_none() {
+                return Err(ErrorCode::NotFound.into());
+            }
+            let mut array = response.certificate_details()?;
+            for record in records {
+                array = client_record(array.push()?, fabric, &record, true)?;
+            }
+            array.end()?.end()
+        })
+    }
+
+    fn handle_lookup_client_certificate<P: TLVBuilderParent>(
+        &self,
+        ctx: impl InvokeContext,
+        request: cert::LookupClientCertificateRequest<'_>,
+        response: cert::LookupClientCertificateResponseBuilder<P>,
+    ) -> Result<P, Error> {
+        let hash = request.fingerprint()?.0;
+        response
+            .ccdid(self.clients(fabric(&ctx)?, |clients| clients.lookup(hash))?)?
+            .end()
+    }
+
+    fn handle_remove_client_certificate(
+        &self,
+        ctx: impl InvokeContext,
+        request: cert::RemoveClientCertificateRequest<'_>,
+    ) -> Result<(), Error> {
+        let id = request.ccdid()?;
+        self.clients(fabric(&ctx)?, |mut clients| clients.remove(id))?;
+        ctx.notify_own_attr_changed(cert::AttributeId::ProvisionedClientCertificates as _);
+        Ok(())
+    }
+}
+
+impl client::ClusterHandler for Cluster {
+    const CLUSTER: rs_matter::dm::Cluster<'static> = client::FULL_CLUSTER;
+    fn dataver(&self) -> u32 {
+        self.dataver.get()
+    }
+    fn dataver_changed(&self) {
+        self.dataver.changed();
+    }
+    fn lifecycle(&self, ctx: impl HandlerContext, op: LifecycleOp) -> Result<(), Error> {
+        if matches!(
+            op,
+            LifecycleOp::FabricRemoval { .. } | LifecycleOp::FactoryReset
+        ) {
+            self.dataver.changed();
+            ctx.notify_cluster_changed(0, client::FULL_CLUSTER.id);
+        }
+        Ok(())
+    }
+    fn max_provisioned(&self, _: impl ReadContext) -> Result<u8, Error> {
+        Ok(tls::MAX_ENDPOINTS as u8)
+    }
+    fn provisioned_endpoints<P: TLVBuilderParent>(
+        &self,
+        ctx: impl ReadContext,
+        builder: ArrayAttributeRead<
+            client::TLSEndpointStructArrayBuilder<P>,
+            client::TLSEndpointStructBuilder<P>,
+        >,
+    ) -> Result<P, Error> {
+        let mut records = Vec::new();
+        for fabric in self.read_fabrics(&ctx) {
+            records.extend(
+                self.endpoints(fabric, |endpoints| endpoints.list())
+                    .map_err(status)?
+                    .into_iter()
+                    .map(|item| (fabric, item)),
+            );
+        }
+        match builder {
+            ArrayAttributeRead::ReadAll(mut array) => {
+                for (fabric, record) in records {
+                    array = endpoint_record(array.push()?, fabric, &record)?;
+                }
+                array.end()
+            }
+            ArrayAttributeRead::ReadOne(index, item) => {
+                let (fabric, record) = records
+                    .get(index as usize)
+                    .ok_or(ErrorCode::ConstraintError)?;
+                endpoint_record(item, *fabric, record)
+            }
+            ArrayAttributeRead::ReadNone(array) => array.end(),
+        }
+    }
+
+    fn handle_provision_endpoint<P: TLVBuilderParent>(
+        &self,
+        ctx: impl InvokeContext,
+        request: client::ProvisionEndpointRequest<'_>,
+        response: client::ProvisionEndpointResponseBuilder<P>,
+    ) -> Result<P, Error> {
+        let id = request.endpoint_id()?.into_option();
+        let settings = tls::EndpointSettings {
+            hostname: std::str::from_utf8(request.hostname()?.0)
+                .map_err(|_| ErrorCode::ConstraintError)?
+                .to_owned(),
+            port: request.port()?,
+            root_certificate: request.caid()?,
+            client_certificate: request.ccdid()?.into_option(),
+        };
+        let id = self
+            .endpoints(fabric(&ctx)?, |mut endpoints| {
+                endpoints.provision(id, settings)
+            })
+            .map_err(|error| endpoint_status(&ctx, error))?;
+        ctx.notify_own_attr_changed(client::AttributeId::ProvisionedEndpoints as _);
+        response.endpoint_id(id)?.end()
+    }
+
+    fn handle_find_endpoint<P: TLVBuilderParent>(
+        &self,
+        ctx: impl InvokeContext,
+        request: client::FindEndpointRequest<'_>,
+        response: client::FindEndpointResponseBuilder<P>,
+    ) -> Result<P, Error> {
+        let id = request.endpoint_id()?;
+        let fabric = fabric(&ctx)?;
+        let record = self
+            .endpoints(fabric, |endpoints| endpoints.find(id))
+            .map_err(status)?;
+        endpoint_record(response.endpoint()?, fabric, &record)?.end()
+    }
+
+    fn handle_remove_endpoint(
+        &self,
+        ctx: impl InvokeContext,
+        request: client::RemoveEndpointRequest<'_>,
+    ) -> Result<(), Error> {
+        let id = request.endpoint_id()?;
+        self.endpoints(fabric(&ctx)?, |mut endpoints| endpoints.remove(id))
+            .map_err(status)?;
+        ctx.notify_own_attr_changed(client::AttributeId::ProvisionedEndpoints as _);
+        Ok(())
+    }
+}
+
+fn requested_id(id: Option<u16>) -> Result<Option<u16>, Error> {
+    if id == Some(u16::MAX) {
+        return Err(ErrorCode::ConstraintError.into());
+    }
+    Ok(id)
+}
+
+// An Invoke result is one structure. Return a status if the complete list
+// will not fit. The provisioned attribute also supports chunked list reads.
+fn fit_command<T>(write: impl FnOnce() -> Result<T, Error>) -> Result<T, Error> {
+    write().map_err(|error| {
+        if error.code() == ErrorCode::NoSpace {
+            ErrorCode::ResourceExhausted.into()
+        } else {
+            error
+        }
+    })
+}
+
+fn root_record<P: TLVBuilderParent>(
+    item: cert::TLSCertStructBuilder<P>,
+    fabric: u8,
+    id: u16,
+    certificate: Option<&[u8]>,
+) -> Result<P, Error> {
+    item.caid(id)?
+        .certificate(certificate.map(Octets))?
+        .fabric_index(Some(fabric))?
+        .end()
+}
+
+fn client_record<P: TLVBuilderParent>(
+    item: cert::TLSClientCertificateDetailStructBuilder<P>,
+    fabric: u8,
+    record: &tls::ClientCertificate,
+    include: bool,
+) -> Result<P, Error> {
+    let leaf = include.then(|| Nullable::new(record.leaf.as_deref().map(Octets)));
+    let builder = item
+        .ccdid(record.id)?
+        .client_certificate(leaf)?
+        .intermediate_certificates()?;
+    let builder = if include {
+        let mut array = builder.some()?;
+        for der in &record.intermediates {
+            array = array.push(Octets(der))?;
+        }
+        array.end()?
+    } else {
+        builder.none()
+    };
+    builder.fabric_index(Some(fabric))?.end()
+}
+
+fn endpoint_record<P: TLVBuilderParent>(
+    item: client::TLSEndpointStructBuilder<P>,
+    fabric: u8,
+    endpoint: &tls::Endpoint,
+) -> Result<P, Error> {
+    let settings = &endpoint.settings;
+    item.endpoint_id(endpoint.id)?
+        .hostname(Octets(settings.hostname.as_bytes()))?
+        .port(settings.port)?
+        .caid(settings.root_certificate)?
+        .ccdid(Nullable::new(settings.client_certificate))?
+        // This node does not install an optional Push AV transport.
+        .reference_count(0)?
+        .fabric_index(Some(fabric))?
+        .end()
+}
