+//! Adapt the gateway's provisioned identity to the pinned Matter SDK.
+use nxrs_gateway_matter::attestation::Attestation;
+use rs_matter::{
+    attest::{
+        cd::{CertificationElements, CertificationType, DeviceInfoForAttestation},
+        DeviceAttestation,
+    },
+    cert::x509::cert::{DacCert, PaiCert},
+    crypto::{
+        default_crypto, CanonPkcPublicKey, CanonPkcPublicKeyRef, CanonPkcSecretKeyRef, Crypto,
+        PublicKey, SigningSecretKey,
+    },
+    error::{Error, ErrorCode},
+    dm::clusters::basic_info::BasicInfoConfig,
+};
+use std::{path::Path, time::SystemTime};
+
+pub struct ProvisionedDevice {
+    input: Attestation,
+    public_key: [u8; 65],
+}
+
+impl ProvisionedDevice {
+    pub fn load(directory: &Path, allow_test: bool) -> Result<Self, Error> {
+        let input = Attestation::load(directory).map_err(|_| ErrorCode::Invalid)?;
+        let public_key = Self::validate(&input, allow_test)?;
+        Ok(Self { input, public_key })
+    }
+
+    fn validate(input: &Attestation, allow_test: bool) -> Result<[u8; 65], Error> {
+        let dac = DacCert::new(input.dac())?;
+        let pai = PaiCert::new(input.pai())?;
+        let identity = input.identity();
+        let now = SystemTime::now()
+            .duration_since(SystemTime::UNIX_EPOCH)
+            .map_err(|_| ErrorCode::Invalid)?
+            .as_secs();
+        if dac.authority_key_id()? != pai.subject_key_id()?
+            || !dac.is_valid_at(now)?
+            || !pai.is_valid_at(now)?
+        {
+            return Err(ErrorCode::Invalid.into());
+        }
+
+        let key = CanonPkcSecretKeyRef::new(input.signing_key());
+        let crypto = default_crypto(rand::rng(), key);
+        let cert_key: [u8; 65] = dac.public_key()?.try_into().map_err(|_| ErrorCode::Invalid)?;
+        let mut derived = CanonPkcPublicKey::new();
+        crypto.secret_key(key)?.pub_key()?.write_canon(&mut derived)?;
+        if derived.access() != &cert_key {
+            return Err(ErrorCode::Invalid.into());
+        }
+
+        let cd = CertificationElements::verify(&crypto, input.declaration(), allow_test)?;
+        if cd.certification_type != CertificationType::Official
+            && (!allow_test || cd.certification_type != CertificationType::DevelopmentAndTest)
+        {
+            return Err(ErrorCode::Invalid.into());
+        }
+        let pai_product_id = match pai.product_id() {
+            Err(error) if error.code() == ErrorCode::NotFound => 0,
+            result => result?,
+        };
+        cd.validate(&DeviceInfoForAttestation {
+            vendor_id: identity.vendor_id,
+            product_id: identity.product_id,
+            dac_vendor_id: dac.vendor_id()?,
+            dac_product_id: dac.product_id()?,
+            pai_vendor_id: pai.vendor_id()?,
+            pai_product_id,
+            paa_skid: pai.authority_key_id()?.try_into().map_err(|_| ErrorCode::Invalid)?,
+        })?;
+        Ok(cert_key)
+    }
+
+    pub fn input(&self) -> &Attestation {
+        &self.input
+    }
+
+    pub fn basic_info(&self) -> BasicInfoConfig<'_> {
+        let identity = self.input.identity();
+        BasicInfoConfig {
+            vid: identity.vendor_id,
+            pid: identity.product_id,
+            vendor_name: &identity.vendor_name,
+            product_name: &identity.product_name,
+            serial_no: &identity.serial_number,
+            ..BasicInfoConfig::new()
+        }
+    }
+}
+
+impl DeviceAttestation for ProvisionedDevice {
+    fn cert_declaration(&self) -> &[u8] {
+        self.input.declaration()
+    }
+
+    fn pai(&self) -> &[u8] {
+        self.input.pai()
+    }
+
+    fn dac(&self) -> &[u8] {
+        self.input.dac()
+    }
+
+    fn dac_pub_key(&self) -> CanonPkcPublicKeyRef<'_> {
+        CanonPkcPublicKeyRef::new(&self.public_key)
+    }
+
+    fn dac_priv_key(&self) -> CanonPkcSecretKeyRef<'_> {
+        CanonPkcSecretKeyRef::new(self.input.signing_key())
+    }
+}
