+/// Authenticated subject and command that admitted an ongoing media session.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+#[cfg_attr(feature = "defmt", derive(defmt::Format))]
+pub struct OfferAccess {
+    subject: SubjectDescriptor,
+    command: u32,
+}
+
+impl OfferAccess {
+    fn for_command(ctx: &impl InvokeContext, matter: &Matter<'_>) -> Result<Self, Error> {
+        let accessor = Accessor::for_operation(ctx, matter)?;
+        if accessor.auth_mode() != Some(AuthMode::Case) {
+            return Err(ErrorCode::UnsupportedAccess.into());
+        }
+        Ok(Self { subject: *accessor, command: ctx.cmd().cmd_id })
+    }
+
+    fn allowed(&self, ctx: &impl HandlerContext, matter: &Matter<'_>, endpoint_id: EndptId) -> bool {
+        ctx.metadata().access(|node| {
+            let Some(endpoint) = node.endpoint(endpoint_id) else { return false };
+            let Some(cluster) = endpoint.cluster(decl::FULL_CLUSTER.id) else { return false };
+            let Some(command) = cluster.command(self.command) else { return false };
+            let path = crate::im::GenericPath::new(Some(endpoint.id), Some(cluster.id), Some(command.id));
+            let mut request = AccessReq::new(&self.subject, path, Access::WRITE, endpoint.device_types);
+            request.set_target_perms(command.access);
+            matter.with_state(|state| request.allow(state.fabrics))
+        })
+    }
+}
