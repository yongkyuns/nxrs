+
+type DesiredServices = HashMap<MatterLocalService, DNSServiceBuilder>;
+
+struct RegistrationUpdate {
+    desired: DesiredServices,
+    completed: Sender<Result<(), Error>>,
+}
+
+struct Registrations {
+    updates: Sender<RegistrationUpdate>,
+    worker: Option<JoinHandle<()>>,
+}
+
+impl Registrations {
+    fn start() -> Result<Self, Error> {
+        let (updates, pending) = async_channel::bounded(1);
+        let worker = thread::Builder::new()
+            .name("matter-dns-sd".into())
+            .spawn(move || Self::run(pending))
+            .map_err(|_| ErrorCode::MdnsError)?;
+        Ok(Self {
+            updates,
+            worker: Some(worker),
+        })
+    }
+
+    async fn update(&self, desired: DesiredServices) -> Result<(), Error> {
+        let (completed, result) = async_channel::bounded(1);
+        self.updates
+            .send(RegistrationUpdate { desired, completed })
+            .await
+            .map_err(|_| ErrorCode::MdnsError)?;
+        result.recv().await.map_err(|_| ErrorCode::MdnsError)?
+    }
+
+    fn run(pending: Receiver<RegistrationUpdate>) {
+        let mut registered = HashMap::<MatterLocalService, RegisteredDnsService>::new();
+        while let Ok(RegistrationUpdate { desired, completed }) = pending.recv_blocking() {
+            // The daemon can take seconds to acknowledge registration. Keep
+            // creation and destruction of its handles on this worker.
+            registered.retain(|service, _| desired.contains_key(service));
+            let result = desired.into_iter().try_for_each(|(service, builder)| {
+                if !pending.is_closed() {
+                    if let Entry::Vacant(entry) = registered.entry(service) {
+                        entry.insert(builder.register().map_err(|_| ErrorCode::MdnsError)?);
+                    }
+                }
+                Ok(())
+            });
+            let failed = result.is_err();
+            let _ = completed.try_send(result);
+            if failed {
+                break;
+            }
+        }
+    }
+}
+
+impl Drop for Registrations {
+    fn drop(&mut self) {
+        self.updates.close();
+        if let Some(worker) = self.worker.take() {
+            let _ = worker.join();
+        }
     }
 }
 
