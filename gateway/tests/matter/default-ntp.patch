+//! Matter DefaultNTP configuration and the LAN-scoped gateway SNTP client.
+use std::{
+    cell::RefCell,
+    net::{Ipv6Addr, SocketAddrV6},
+};
+
+use nxrs_gateway_matter::{lan::Lan, ntp};
+use rand::RngExt;
+use rs_matter::{
+    dm::{
+        clusters::time_sync::{client::NtpFallback, NtpClient, SetDefaultNTPRequest},
+        LifecycleOp,
+    },
+    error::{Error, ErrorCode},
+    persist::{KvBlobStoreAccess, Persist},
+    tlv::Nullable,
+    utils::{storage::String, sync::Notification},
+    Matter,
+};
+
+use super::NTP_CONFIG_KEY;
+
+struct Server {
+    text: String<128>,
+    address: Ipv6Addr,
+}
+
+impl Server {
+    fn parse(value: &str) -> Result<Self, Error> {
+        let address = value
+            .parse::<Ipv6Addr>()
+            .map_err(|_| ErrorCode::InvalidCommand)?;
+        if address.is_unspecified() || address.is_multicast() || address.to_ipv4_mapped().is_some()
+        {
+            return Err(ErrorCode::InvalidCommand.into());
+        }
+        let text = String::try_from(value).map_err(|_| ErrorCode::InvalidCommand)?;
+        Ok(Self { text, address })
+    }
+}
+
+pub struct Provider<'a, S> {
+    matter: &'a Matter<'a>,
+    store: S,
+    lan: Lan,
+    server: RefCell<Option<Server>>,
+    changed: Notification,
+}
+
+impl<'a, S: KvBlobStoreAccess> Provider<'a, S> {
+    pub fn new(matter: &'a Matter<'a>, store: S, lan: Lan) -> Result<Self, Error> {
+        let server = Persist::new(&store)
+            .load_tlv::<String<128>>(NTP_CONFIG_KEY)?
+            .map(|value| Server::parse(value.as_str()))
+            .transpose()?;
+        Ok(Self {
+            matter,
+            store,
+            lan,
+            server: RefCell::new(server),
+            changed: Notification::new(),
+        })
+    }
+}
+
+impl<S: KvBlobStoreAccess> NtpClient for Provider<'_, S> {
+    fn default_ntp(&self) -> Result<Nullable<String<128>>, Error> {
+        Ok(Nullable::new(
+            self.server
+                .borrow()
+                .as_ref()
+                .map(|server| server.text.clone()),
+        ))
+    }
+
+    fn supports_dns_resolve(&self) -> Result<bool, Error> {
+        Ok(false)
+    }
+
+    fn set_default_ntp(&self, request: &SetDefaultNTPRequest<'_>) -> Result<(), Error> {
+        let next = request
+            .default_ntp()?
+            .into_option()
+            .map(Server::parse)
+            .transpose()?;
+        let mut persist = Persist::new(&self.store);
+        match &next {
+            Some(server) => persist.store_tlv(NTP_CONFIG_KEY, &server.text)?,
+            None => persist.remove(NTP_CONFIG_KEY)?,
+        }
+        persist.run()?;
+        self.server.replace(next);
+        self.changed.notify();
+        Ok(())
+    }
+
+    fn lifecycle(&self, op: LifecycleOp) -> Result<(), Error> {
+        if matches!(op, LifecycleOp::FactoryReset) {
+            let mut persist = Persist::new(&self.store);
+            persist.remove(NTP_CONFIG_KEY)?;
+            persist.run()?;
+        } else if !matches!(op, LifecycleOp::FabricRemoval { .. }) || self.matter.has_fabrics() {
+            return Ok(());
+        }
+        // Final fabric removal cleared the persistent record with its credentials.
+        self.server.replace(None);
+        self.changed.notify();
+        Ok(())
+    }
+}
+
+impl<S: KvBlobStoreAccess> NtpFallback for Provider<'_, S> {
+    fn configured(&self) -> bool {
+        self.server.borrow().is_some()
+    }
+
+    async fn changed(&self) {
+        self.changed.wait().await;
+    }
+
+    async fn query(&self) -> Option<u64> {
+        let addr = self.server.borrow().as_ref()?.address;
+        let peer = ntp::server_address(addr, self.lan.index());
+        let local = SocketAddrV6::new(Ipv6Addr::UNSPECIFIED, 0, 0, 0);
+        let socket = self.lan.bind_udp(local.into()).ok()?;
+        socket.set_nonblocking(true).ok()?;
+        let socket = tokio::net::UdpSocket::from_std(socket).ok()?;
+        let nonce = rand::rng().random::<u64>().to_be_bytes();
+        ntp::sample(socket, peer, nonce).await.ok()
+    }
+}
