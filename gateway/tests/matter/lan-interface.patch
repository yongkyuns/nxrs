+//! Adapt the scoped host sockets to the pinned SDK transport contracts.
+
+use std::net::{IpAddr, SocketAddr, TcpListener, TcpStream, UdpSocket};
+
+use async_io::Async;
+use nxrs_gateway_matter::lan::Lan;
+use rs_matter::{
+    error::Error,
+    transport::network::{tcp::TcpNetworkSockets, Address, NetworkMulticast, NetworkReceive},
+};
+
+pub struct TcpSockets {
+    lan: Lan,
+    listeners: Vec<Async<TcpListener>>,
+}
+
+impl TcpSockets {
+    pub fn bind(lan: Lan, port: u16) -> Result<Self, Error> {
+        let listeners = lan.listen_tcp(port)?.into_iter().map(Async::new)
+            .collect::<std::io::Result<_>>()?;
+        Ok(Self { lan, listeners })
+    }
+}
+
+impl TcpNetworkSockets for TcpSockets {
+    type Socket = Async<TcpStream>;
+
+    async fn accept(&self) -> Result<(SocketAddr, Self::Socket), Error> {
+        let listeners = self.listeners.iter().map(|listener| Box::pin(TcpNetworkSockets::accept(listener)));
+        futures_util::future::select_all(listeners).await.0
+    }
+
+    async fn connect(&self, addr: SocketAddr) -> Result<Self::Socket, Error> {
+        let stream = self.lan.connect_tcp(addr).await?;
+        let _ = stream.set_nodelay(true);
+        Ok(Async::new(stream)?)
+    }
+}
+
+pub struct UdpReceiver<'a> {
+    pub lan: Lan,
+    pub socket: &'a Async<UdpSocket>,
+}
+
+impl NetworkReceive for UdpReceiver<'_> {
+    async fn wait_available(&mut self) -> Result<(), Error> {
+        Ok(self.socket.readable().await?)
+    }
+
+    async fn recv_from(&mut self, buffer: &mut [u8]) -> Result<(usize, Address), Error> {
+        loop {
+            let datagram = self.socket.read_with(|socket| self.lan.recv_matter_udp(socket, buffer)).await?;
+            if let Some((count, peer)) = datagram {
+                return Ok((count, Address::Udp(peer)));
+            }
+            // An excluded interface must not monopolize the shared transport.
+            futures_lite::future::yield_now().await;
+        }
+    }
+}
+
+pub struct Multicast<'a> {
+    pub lan: Lan,
+    pub v4: &'a UdpSocket,
+    pub v6: &'a UdpSocket,
+}
+
+impl NetworkMulticast for Multicast<'_> {
+    async fn join(&mut self, addr: IpAddr) -> Result<(), Error> {
+        match addr {
+            IpAddr::V4(addr) => self.v4.join_multicast_v4(&addr, &self.lan.ipv4())?,
+            IpAddr::V6(addr) => self.v6.join_multicast_v6(&addr, self.lan.index())?,
+        }
+        Ok(())
+    }
+
+    async fn leave(&mut self, addr: IpAddr) -> Result<(), Error> {
+        match addr {
+            IpAddr::V4(addr) => self.v4.leave_multicast_v4(&addr, &self.lan.ipv4())?,
+            IpAddr::V6(addr) => self.v6.leave_multicast_v6(&addr, self.lan.index())?,
+        }
+        Ok(())
+    }
+}
