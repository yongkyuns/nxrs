+// The adapter is tied to the pinned SDK key layout. Device identity and
+// monotonic bookkeeping have a lifetime independent of Matter installation.
+fn installation_record(key: u16) -> bool {
+    match key {
+        CAMERA_PRIVACY_KEY | VIDEO_ALLOCATIONS_KEY | AUDIO_ALLOCATIONS_KEY => true,
+        EVENT_EPOCH_KEY | GROUP_DATA_COUNTER_KEY | LKG_UTC_KEY | NEXT_FABRIC_INDEX_KEY
+        | OPERATIONAL_HOURS_KEY | REBOOT_COUNT_KEY | RUNNING_VERSION_KEY => false,
+        key => key < VENDOR_KEYS_START,
+    }
+}
