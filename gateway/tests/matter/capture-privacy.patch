+// RFC 8839 section 5.1 keeps ICE active for unsupported hostnames.
+// Browser mDNS names cannot be passed to the literal-address ICE engine.
+fn remote_candidate(sdp: &str) -> Result<Option<Candidate>, WebRtcError> {
+    let sdp = sdp.trim_start_matches("a=");
+    match Candidate::from_sdp_string(sdp) {
+        Ok(candidate) => Ok(Some(candidate)),
+        Err(_) => {
+            let address = sdp.split_ascii_whitespace().nth(4);
+            let mdns = address.and_then(|name| name.split_once('.')).is_some_and(|(label, suffix)| {
+                suffix.eq_ignore_ascii_case("local") && !label.is_empty() && label.len() <= 63
+                    && label.bytes().all(|b| b.is_ascii_alphanumeric() || b == b'-')
+            });
+            if sdp.starts_with("candidate:") && mdns {
+                Ok(None)
+            } else {
+                Err(WebRtcError::DynamicConstraint)
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+#[test]
+fn private_candidate_names_leave_numeric_ice_available() {
+    assert!(matches!(remote_candidate(
+        "candidate:1 1 UDP 2122262783 1f4712db-ea17-4bcf-a596-105139dfd8bf.local 54596 typ host",
+    ), Ok(None)));
+    assert!(matches!(remote_candidate(
+        "candidate:2 1 UDP 2122262783 192.0.2.4 54596 typ host",
+    ), Ok(Some(_))));
+    assert!(matches!(remote_candidate(
+        "candidate:3 1 UDP 2122262783 192.0.2.999 54596 typ host",
+    ), Err(WebRtcError::DynamicConstraint)));
+}
