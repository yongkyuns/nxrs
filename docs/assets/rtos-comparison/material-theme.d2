# Material palette shades; each outline is a darker shade of its fill's hue.
style.fill: "#FFFFFF"
***.style: {
  stroke-width: 1
  border-radius: 12
  font-size: 18
  bold: false
}
***.class: surface
(*** -> ***)[*].style: {
  stroke: "#607D8B"
  stroke-width: 2
  border-radius: 8
  font-size: 16
  font-color: "#263238"
  bold: false
}
classes: {
  primary: {style: {fill: "#E3F2FD"; stroke: "#BBDEFB"; font-color: "#263238"}}
  secondary: {style: {fill: "#E0F2F1"; stroke: "#B2DFDB"; font-color: "#263238"}}
  nested: {style: {fill: "#ECEFF1"; stroke: "#CFD8DC"; font-color: "#263238"}}
  surface: {style: {fill: "#FAFAFA"; stroke: "#E0E0E0"; font-color: "#263238"}}
}
