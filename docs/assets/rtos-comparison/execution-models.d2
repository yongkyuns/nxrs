...@material-theme
direction: down
threads: NuttX / Zephyr {
  class: surface
  owners: 20 service threads\n4 KiB stack each {class: secondary}
  scheduler: Preemptive scheduler\n10 ms timeslice {class: primary}
  cpu: One core\n240 MHz {class: secondary}
  owners -> scheduler
  scheduler -> cpu
}
async: Embassy {
  class: surface
  owners: 20 service tasks\nsaved future state {class: secondary}
  executor: Cooperative executor\nPending or handoff {class: primary}
  cpu: One core, 240 MHz\n8 KiB shared stack {class: secondary}
  owners -> executor
  executor -> cpu
}
