...@material-theme
direction: right
threads: NuttX / Zephyr {
  class: surface
  owners: 20 threads\n4 KiB stack each {class: secondary; width: 190; height: 106}
  scheduler: Preemptive\nscheduler\n10 ms timeslice {class: primary; width: 190; height: 106}
  cpu: One core\n240 MHz {class: secondary; width: 190; height: 106}
  owners -> scheduler
  scheduler -> cpu
}
async: Embassy {
  class: surface
  owners: 20 async tasks\nsaved future state {class: secondary; width: 190; height: 106}
  executor: Cooperative\nexecutor\nPending or handoff {class: primary; width: 190; height: 106}
  cpu: One core\n240 MHz\n8 KiB shared stack {class: secondary; width: 190; height: 106}
  owners -> executor
  executor -> cpu
}
