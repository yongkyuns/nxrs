...@material-theme
direction: right
senders: Senders\nA, B, C {class: secondary}
service: One receiving owner {
  class: surface
  queues: Inboxes {
    class: nested
    control: Control\n8 slots {class: secondary}
    data: Data\n8 slots {class: secondary}
    status: Status\n8 slots {class: secondary}
  }
  deadline: Publish\ndeadline {class: secondary}
  wait: One wait\nany inbox\nor deadline {class: primary}
  handler: Handle event\nor publish\nstate + HAL\nthen wait again {class: primary}
  queues.control -> wait
  queues.data -> wait
  queues.status -> wait
  deadline -> wait
  wait -> handler
}
senders -> service.queues.control
senders -> service.queues.data
senders -> service.queues.status
