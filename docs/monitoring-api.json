{
  "openapi": "3.1.0",
  "info": {
    "title": "nxrs monitoring control API",
    "version": "0.2.0",
    "description": "Implemented v1 monitoring contract, with optional gateway-owned activity recording. Account authorization and opaque camera identities remain independent of VPN reachability. Fixtures contain no real credentials or footage."
  },
  "servers": [
    {
      "url": "https://gateway.example.test",
      "description": "Illustrative enrolled origin; deployment may supply a base path."
    }
  ],
  "security": [
    {
      "accountBearer": []
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {
          "200": {
            "description": "Minimal process health, not camera or media health",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
