  "components": {
    "securitySchemes": {
      "accountBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Per-viewer account/device credential, independent of WireGuard."
      }
    },
    "schemas": {
      "ResourceID": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$",
        "minLength": 1,
        "maxLength": 64
      },
      "Camera": {
        "type": "object",
        "required": [
          "camera_id",
          "gateway_id",
          "site_id",
          "name",
          "source",
          "availability",
          "live_video"
        ],
        "properties": {
          "camera_id": {
            "$ref": "#/components/schemas/ResourceID"
          },
          "gateway_id": {
            "$ref": "#/components/schemas/ResourceID"
          },
          "site_id": {
            "$ref": "#/components/schemas/ResourceID"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "source": {
            "type": "string",
            "enum": [
              "synthetic",
              "physical"
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "unknown",
              "online",
              "offline"
            ],
            "description": "Gateway observation, not proof of fresh decoded video."
          },
          "live_video": {
            "type": "boolean"
          }
        }
      },
      "CameraList": {
        "type": "object",
        "required": [
          "api_version",
          "cameras"
        ],
        "properties": {
          "api_version": {
            "const": "1",
            "type": "string"
          },
          "cameras": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "$ref": "#/components/schemas/Camera"
            },
            "description": "Only authorized cameras. Duplicate camera_id values are invalid."
          }
        }
      },
      "PlaybackGrant": {
        "type": "object",
        "required": [
          "api_version",
          "camera_id",
          "protocol",
          "endpoint",
          "access_token",
          "token_type",
          "expires_at"
        ],
        "properties": {
          "api_version": {
            "const": "1",
            "type": "string"
          },
          "camera_id": {
            "$ref": "#/components/schemas/ResourceID"
          },
          "protocol": {
            "const": "whep",
            "type": "string"
          },
          "endpoint": {
            "type": "string",
            "format": "uri",
            "pattern": "^https://",
            "description": "Enrolled media origin only. No userinfo, query, fragment, or embedded credentials."
          },
          "access_token": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "^[A-Za-z0-9._~+/-]+=*$",
            "description": "Camera-scoped media credential, never the account or publisher credential. Redact from logs."
          },
          "token_type": {
            "const": "Bearer",
            "type": "string"
          },
          "expires_at": {
            "type": "integer",
            "minimum": 1,
            "description": "Unix UTC seconds. Server issues at most 300 seconds ahead; server-side admission and active-session revocation are independent obligations."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "unauthenticated",
              "forbidden",
              "not_found",
              "camera_unavailable",
              "rate_limited",
              "service_unavailable"
            ]
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          }
        }
      },
      "ActivityEvent": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "camera_id",
          "kind",
          "started_at_ms",
          "ended_at_ms",
          "clip_bytes",
          "thumbnail_bytes",
          "kept",
          "interrupted"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          },
          "camera_id": {
            "$ref": "#/components/schemas/ResourceID"
          },
          "kind": {
            "type": "string",
            "const": "motion"
          },
          "started_at_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "ended_at_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "clip_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 33554432
          },
          "thumbnail_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 262144
          },
          "kept": {
            "type": "boolean"
          },
          "interrupted": {
            "type": "boolean"
          }
        },
        "description": "Gateway-observed clip interval; end must be after start and at most 120 seconds later. Motion does not assert person identity. Kept events are exempt from automatic eviction."
      },
      "ActivityHealth": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "updated_at_ms",
          "last_frame_at_ms",
          "state",
          "reconnects",
          "frames_observed",
          "clips_created",
          "clips_dropped"
        ],
        "properties": {
          "updated_at_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "last_frame_at_ms": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "connecting",
              "monitoring",
              "reconnecting",
              "storage_full",
              "recording_error",
              "stopped"
            ]
          },
          "reconnects": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "frames_observed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "clips_created": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "clips_dropped": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "description": "Worker observation. Stale update/frame times must not be presented as confirmed monitoring."
      },
      "ActivityPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "api_version",
          "camera_id",
          "events",
          "next_cursor",
          "can_manage",
          "used_bytes",
          "max_bytes",
          "retention_seconds",
          "health",
          "observed_at_ms"
        ],
        "properties": {
          "api_version": {
            "type": "string",
            "const": "1"
          },
          "camera_id": {
            "$ref": "#/components/schemas/ResourceID"
          },
          "events": {
            "type": "array",
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/ActivityEvent"
            }
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{32}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "can_manage": {
            "type": "boolean"
          },
          "used_bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 107374182400
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 33554432,
            "maximum": 107374182400
          },
          "retention_seconds": {
            "type": "integer",
            "minimum": 60,
            "maximum": 2592000
          },
          "health": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ActivityHealth"
              },
              {
                "type": "null"
              }
            ]
          },
          "observed_at_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      },
      "ActivityUpdated": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "api_version",
          "event"
        ],
        "properties": {
          "api_version": {
            "type": "string",
            "const": "1"
          },
          "event": {
            "$ref": "#/components/schemas/ActivityEvent"
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or expired account credential",
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Access denied",
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Busy": {
        "description": "Admission limit reached; do not retry immediately",
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unavailable": {
        "description": "Service unavailable",
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
              "const": "no-store"
            }
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "Unavailable activity, expired recording or hidden camera",
        "headers": {
          "Cache-Control": {
            "schema": {
              "type": "string",
