...@material.d2
# Scope and assumptions: ../architecture-atlas.md. Routes: routes.json.
title: "Sensor delivery: ISR, worker, retained data, consumer" {shape: text; top: 0; left: 0; width: 1460; height: 44; style: {font-size: 30; bold: true; font-color: "#102D47"}}
producer: "Producer execution contexts" {class: execution; label.near: top-left; left: 0; top: 125; width: 440; height: 620
  irq: "Hardware DRDY → ISR\nacknowledge / schedule only\nno blocking bus operation" {class: code; left: 0; top: 20; width: 320; height: 120}
  worker: "Driver worker / bottom half\nread bus; decode sensor record\ncall push_event callback" {class: code; left: 0; top: 265; width: 320; height: 150}
}
upper: "Upper-half code + shared RAM" {class: memory; label.near: top-left; left: 510; top: 125; width: 440; height: 620
  ready: "Notification bookkeeping\npoll waiters / reader state\nreadiness is not a payload" {class: caution; left: 0; top: 20; width: 320; height: 120}
  ring: "Bounded sensor ring\ncopy record + advance producer\nindependent reader positions\nslow readers can lose records" {class: storage; left: 0; top: 265; width: 320; height: 150}
}
consumer: "Consumer thread" {class: execution; label.near: top-left; left: 1020; top: 125; width: 440; height: 620
  wait: "poll(fd, ...) / blocking read\nthread sleeps when no data\nscheduler resumes it later" {class: code; left: 0; top: 20; width: 320; height: 120}
  read: "read(fd, buffer, length)\ncopy available sensor records\nnormalize / process / repeat\napplication owns output buffer" {class: storage; left: 0; top: 265; width: 320; height: 150}
}
subtitle: "OV3 · Representative interrupt-driven NuttX sensor path · not the PX4 uORB implementation" {shape: text; top: 59; left: 0; width: 1460; height: 32; style: {font-size: 20; font-color: "#445E74"}}
producer.irq -> producer.worker: "schedule" {class: wake}
producer.worker -> upper.ring: "record copy" {class: data}
upper.ring -> upper.ready: "notify" {class: wake}
upper.ready -> consumer.wait: "ready only" {class: wake}
consumer.wait -> consumer.read: "resume" {class: wake}
upper.ring -> consumer.read: "read copy" {class: data}
consumer.read -> upper.ring: "read()" {class: call}
lesson: "The upper half and ring are NOT a broker thread. A wakeup carries no sample; the consumer later copies retained records." {class: caution; left: 0; top: 773; width: 1460; height: 78}
legend: "BLUE solid = API call   |   TEAL solid = data / ownership   |   ORANGE dashed = wake / schedule   |   GREY dotted = build / configuration" {shape: text; left: 0; top: 868; width: 1460; height: 30; style: {font-size: 18; font-color: "#445E74"}}
