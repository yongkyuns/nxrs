# Local Material-style palette, adapted from the Zephyr reference.
# Not a built-in D2 theme. No dependency on another reference directory.
vars: { d2-config: { layout-engine: elk; theme-id: 0 } }
style: { fill: "#FAFAFA"; font-size: 20 }
classes: {
  application: { style: { fill: "#E3F2FD"; stroke: "#1565C0"; font-color: "#0D47A1"; border-radius: 12; font-size: 20 } }
  contract: { style: { fill: "#E0F2F1"; stroke: "#00796B"; font-color: "#004D40"; border-radius: 12; font-size: 20 } }
  implementation: { style: { fill: "#E8EAF6"; stroke: "#3949AB"; font-color: "#1A237E"; border-radius: 12; font-size: 20 } }
  adaptation: { style: { fill: "#FFF3E0"; stroke: "#EF6C00"; font-color: "#6D3800"; border-radius: 12; font-size: 20 } }
  hardware: { style: { fill: "#ECEFF1"; stroke: "#546E7A"; font-color: "#263238"; border-radius: 12; font-size: 20 } }
}
