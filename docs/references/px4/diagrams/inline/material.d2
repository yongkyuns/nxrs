# Material-style colors; explicit coordinates use D2 v0.9.0 / TALA.
vars: {d2-config: {layout-engine: tala; theme-id: 0}}
style: {fill: "#FFFFFF"; font-size: 20}
classes: {
  code: {style: {fill: "#EDF4FC"; stroke: "#527EA8"; stroke-width: 2; border-radius: 8; font-size: 20; bold: false; font-color: "#17324D"}}
  data: {style: {fill: "#E7F4EF"; stroke: "#00897B"; stroke-width: 2; border-radius: 8; font-size: 20; bold: false; font-color: "#004D40"}}
  os: {style: {fill: "#ECEFF1"; stroke: "#607D8B"; stroke-width: 2; border-radius: 8; font-size: 20; bold: false; font-color: "#263238"}}
  gate: {style: {fill: "#FFF0F2"; stroke: "#AD3049"; stroke-width: 2; border-radius: 8; font-size: 20; bold: false; font-color: "#7E2034"}}
  note: {style: {fill: "#FFF6E4"; stroke: "#BA8A35"; stroke-width: 2; border-radius: 8; font-size: 20; bold: false; font-color: "#614715"}}
  region: {style: {fill: "#F8FAFC"; stroke: "#9AAEC1"; stroke-width: 2; border-radius: 10; font-size: 20; bold: true; font-color: "#17324D"}}
  call: {style: {stroke: "#1565C0"; stroke-width: 2; font-size: 18; bold: false; italic: false; font-color: "#104F90"}}
  payload: {style: {stroke: "#00897B"; stroke-width: 2; font-size: 18; bold: false; italic: false; font-color: "#00695C"}}
  wake: {style: {stroke: "#CB6900"; stroke-width: 2; stroke-dash: 6; font-size: 18; bold: false; italic: false; font-color: "#9A4C00"}}
  config: {style: {stroke: "#65758A"; stroke-width: 2; stroke-dash: 3; font-size: 18; bold: false; italic: false; font-color: "#465367"}}
}
