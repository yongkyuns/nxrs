@@ -165 +174 @@
-#ifdef HAVE_GETRANDOM
+#if defined(HAVE_GETRANDOM) && !DROPBEAR_NUTTX
@@ -223,0 +233,17 @@
+#if DROPBEAR_NUTTX
+	unsigned char seed[INIT_SEED_SIZE];
+	hash_state hs;
+	int result = dropbear_entropy_read(seed, sizeof(seed));
+	if (result < 0) {
+		m_burn(seed, sizeof(seed));
+		dropbear_exit("Qualified entropy unavailable: %s", strerror(-result));
+	}
+	sha256_init(&hs);
+	sha256_process(&hs, hashpool, sizeof(hashpool));
+	sha256_process(&hs, seed, sizeof(seed));
+	sha256_done(&hs, hashpool);
+	m_burn(seed, sizeof(seed));
+	counter = 0;
+	donerandinit = 1;
+#else
+
@@ -310 +336,10 @@
-}
+#endif
+}
+
+#if DROPBEAR_NUTTX
+void dropbear_random_cleanup(void) {
+	m_burn(hashpool, sizeof(hashpool));
+	counter = 0;
+	donerandinit = 0;
+}
+#endif
