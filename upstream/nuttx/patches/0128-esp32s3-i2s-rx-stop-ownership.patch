 /****************************************************************************
+ * Name: esp32s3_dma_is_idle
+ *
+ * Description:
+ *   Test whether the channel descriptor engine is parked.
+ *
+ ****************************************************************************/
+
+bool esp32s3_dma_is_idle(int chan, bool tx)
+{
+  uint32_t regaddr = tx ? DMA_OUT_LINK_CH0_REG : DMA_IN_LINK_CH0_REG;
+  uint32_t park = tx ? DMA_OUTLINK_PARK_CH0 : DMA_INLINK_PARK_CH0;
+
+  return (GET_GDMA_CH_REG(regaddr, chan) & park) != 0;
+}
+
