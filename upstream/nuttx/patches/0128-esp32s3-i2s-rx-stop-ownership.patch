 /****************************************************************************
+ * Name: i2s_stop_rx
+ *
+ * Description:
+ *   Stop receive-only capture. Leave the queues owned by the driver until
+ *   both DMA and task-context users have retired. A caller receiving
+ *   -EAGAIN must retain its buffers and retry.
+ *
+ ****************************************************************************/
+
+static int i2s_stop_rx(struct esp_i2s_s *priv)
+{
+  struct esp_buffer_s *buffer;
+  sq_queue_t canceled;
+  irqstate_t flags;
+
+  sq_init(&canceled);
+  flags = spin_lock_irqsave(&priv->slock);
+  if (priv->rx_state == I2S_RX_DRAINING)
+    {
+      spin_unlock_irqrestore(&priv->slock, flags);
+      return -EAGAIN;
+    }
+
+  if (priv->rx_state == I2S_RX_READY)
+    {
+      priv->rx_state = I2S_RX_STOPPING;
+      priv->streaming = false;
+      i2s_rx_channel_stop(priv);
+    }
+
+  if (priv->rx_users != 0 ||
+      !esp32s3_dma_is_idle(priv->dma_channel, false))
+    {
+      spin_unlock_irqrestore(&priv->slock, flags);
+      return -EAGAIN;
+    }
+
+  priv->rx_state = I2S_RX_DRAINING;
+  sq_cat(&priv->rx.done, &canceled);
+  sq_cat(&priv->rx.act, &canceled);
+  sq_cat(&priv->rx.pend, &canceled);
+  spin_unlock_irqrestore(&priv->slock, flags);
+
+  /* Callbacks can re-enter I2S through the audio upper half. Keep the
+   * admission gate closed while returning buffers outside slock.
+   */
+
+  while ((buffer = (struct esp_buffer_s *)sq_remfirst(&canceled)) != NULL)
+    {
+      buffer->apb->nbytes = 0;
+      buffer->apb->curbyte = 0;
+      buffer->apb->flags &= ~AUDIO_APB_FINAL;
+      if (sq_empty(&canceled))
+        {
+          buffer->apb->flags |= AUDIO_APB_FINAL;
+        }
+
+      if (buffer->callback != NULL)
+        {
+          buffer->callback(&priv->dev, buffer->apb, buffer->arg, -ECANCELED);
+        }
+
+      apb_free(buffer->apb);
+      i2s_buf_free(priv, buffer);
+    }
+
+  flags = spin_lock_irqsave(&priv->slock);
+  priv->rx_state = I2S_RX_READY;
+  spin_unlock_irqrestore(&priv->slock, flags);
+  return OK;
+}
+#endif
