Subject: [PATCH] wireless/bcmf: expose optional receive-path diagnostics

Reuse the default-off observer and existing controller counter request.
Expose validated RX error/filter/buffer counters and controller resets, and
observe existing GSPI receive outcomes and netdev work dispatch. No added
register reads, polling, retries, allocations or scheduling-policy changes.
Callbacks obey the same nonblocking borrowed-device contract as frame taps.
Transport events cover all interface traffic, not a particular UDP packet;
coalesced notifications are normal and do not establish missed delivery.

diff --git a/include/nuttx/wireless/ieee80211/bcmf_trace.h b/include/nuttx/wireless/ieee80211/bcmf_trace.h
--- a/include/nuttx/wireless/ieee80211/bcmf_trace.h
+++ b/include/nuttx/wireless/ieee80211/bcmf_trace.h
@@ -24,6 +24,27 @@ enum bcmf_trace_stage_e
   BCMF_TRACE_STAGE_COUNT
 };
 
+enum bcmf_trace_rx_e
+{
+  BCMF_TRACE_RX_ATTEMPT = 0,
+  BCMF_TRACE_RX_SHORT,
+  BCMF_TRACE_RX_NOBUFFER,
+  BCMF_TRACE_RX_OVERSIZE,
+  BCMF_TRACE_RX_SPIERROR,
+  BCMF_TRACE_RX_EMPTY,
+  BCMF_TRACE_RX_HEADERERROR,
+  BCMF_TRACE_RX_OFFSETERROR,
+  BCMF_TRACE_RX_CONTROL,
+  BCMF_TRACE_RX_EVENT,
+  BCMF_TRACE_RX_DATA,
+  BCMF_TRACE_RX_UNKNOWN,
+  BCMF_TRACE_RX_NOTIFY,
+  BCMF_TRACE_RX_WORKER,
+  BCMF_TRACE_RX_COALESCED,
+  BCMF_TRACE_RX_QUEUEERROR,
+  BCMF_TRACE_RX_COUNT
+};
+
 struct bcmf_trace_bus_s
 {
   uint32_t ticket;        /* Diagnostic write ID, independent of SDPCM wrap */
@@ -65,6 +85,14 @@ struct bcmf_trace_counts_s
   uint32_t txretry;
   uint32_t txretrie;
   uint32_t txfail;
+  uint32_t rxframe;
+  uint32_t rxerror;
+  uint32_t rxnobuf;
+  uint32_t rxoflo;
+  uint32_t rxfilter;
+  uint32_t rxbadproto;
+  uint32_t rxfragerr;
+  uint32_t reset;
 };
 
 /* Optional synchronous observer, defaulting to a weak no-op. Data is an
@@ -78,6 +106,9 @@ struct bcmf_trace_counts_s
  */
 
 #ifdef CONFIG_IEEE80211_BROADCOM_FRAME_TRACE
+void bcmf_trace_rx(FAR struct net_driver_s *dev, enum bcmf_trace_rx_e event);
+#define BCMF_TRACE_RX(dev, event) bcmf_trace_rx(dev, event)
+
 void bcmf_trace_frame(FAR struct net_driver_s *dev,
                       enum bcmf_trace_stage_e stage,
                       FAR const uint8_t *data, size_t len, int result,
@@ -107,6 +139,8 @@ void bcmf_trace_status(FAR struct net_driver_s *dev, uint32_t ticket,
 
 int bcmf_trace_counters(FAR struct net_driver_s *dev,
                         FAR struct bcmf_trace_counts_s *counts);
+#else
+#define BCMF_TRACE_RX(dev, event) ((void)0)
 #endif
 
 #endif
diff --git a/drivers/wireless/ieee80211/bcm43xxx/bcmf_bdc.c b/drivers/wireless/ieee80211/bcm43xxx/bcmf_bdc.c
--- a/drivers/wireless/ieee80211/bcm43xxx/bcmf_bdc.c
+++ b/drivers/wireless/ieee80211/bcm43xxx/bcmf_bdc.c
@@ -111,6 +111,13 @@ struct bcmf_frame_s *bcmf_bdc_allocate_frame(FAR struct bcmf_dev_s *priv,
 }
 
 #ifdef CONFIG_IEEE80211_BROADCOM_FRAME_TRACE
+void weak_function bcmf_trace_rx(FAR struct net_driver_s *dev,
+                                 enum bcmf_trace_rx_e event)
+{
+  (void)dev;
+  (void)event;
+}
+
 void weak_function bcmf_trace_frame(FAR struct net_driver_s *dev,
                                     enum bcmf_trace_stage_e stage,
                                     FAR const uint8_t *data, size_t len,
diff --git a/drivers/wireless/ieee80211/bcm43xxx/bcmf_netdev.c b/drivers/wireless/ieee80211/bcm43xxx/bcmf_netdev.c
--- a/drivers/wireless/ieee80211/bcm43xxx/bcmf_netdev.c
+++ b/drivers/wireless/ieee80211/bcm43xxx/bcmf_netdev.c
@@ -513,6 +513,7 @@ static void bcmf_rxpoll_work(FAR void *arg)
    */
 
   netdev_lock(&priv->bc_dev);
+  BCMF_TRACE_RX(&priv->bc_dev, BCMF_TRACE_RX_WORKER);
 
   /* Tx work will hold the d_buf until there is data to send,
    * replace and cache the d_buf temporarily
@@ -571,9 +572,23 @@ void bcmf_netdev_notify_rx(FAR struct bcmf_dev_s *priv)
 {
   /* Queue a job to process RX frames */
 
+  BCMF_TRACE_RX(&priv->bc_dev, BCMF_TRACE_RX_NOTIFY);
   if (work_available(&priv->bc_rxwork))
     {
+#ifdef CONFIG_IEEE80211_BROADCOM_FRAME_TRACE
+      int result = work_queue(BCMFWORK, &priv->bc_rxwork,
+                               bcmf_rxpoll_work, priv, 0);
+      if (result < 0)
+        {
+          BCMF_TRACE_RX(&priv->bc_dev, BCMF_TRACE_RX_QUEUEERROR);
+        }
+#else
       work_queue(BCMFWORK, &priv->bc_rxwork, bcmf_rxpoll_work, priv, 0);
+#endif
+    }
+  else
+    {
+      BCMF_TRACE_RX(&priv->bc_dev, BCMF_TRACE_RX_COALESCED);
     }
 }
 
@@ -967,11 +981,14 @@ static int bcmf_trace_decode_counts(FAR const uint8_t *data, size_t size,
     uint16_t version;
     size_t size;
     bool exact;
-    size_t fields[5];
+    size_t fields[13];
   };
 #define BCMF_TRACE_LAYOUT(v, t, e) {v, sizeof(t), e, \
   {offsetof(t, txframe), offsetof(t, txretrans), offsetof(t, txretry), \
-   offsetof(t, txretrie), offsetof(t, txfail)}}
+   offsetof(t, txretrie), offsetof(t, txfail), offsetof(t, rxframe), \
+   offsetof(t, rxerror), offsetof(t, rxnobuf), offsetof(t, rxoflo), \
+   offsetof(t, rxfilter), offsetof(t, rxbadproto), offsetof(t, rxfragerr), \
+   offsetof(t, reset)}}
   static const struct trace_layout_s layouts[] =
   {
     BCMF_TRACE_LAYOUT(6, wl_cnt_ver_six_t, true),
@@ -985,7 +1001,7 @@ static int bcmf_trace_decode_counts(FAR const uint8_t *data, size_t size,
 #undef BCMF_TRACE_LAYOUT
   FAR const struct trace_layout_s *layout = NULL;
   FAR const uint8_t *payload = data;
-  uint32_t values[5];
+  uint32_t values[13];
   uint16_t header[2];
 
   if (size < sizeof(header))
@@ -1066,7 +1082,7 @@ static int bcmf_trace_decode_counts(FAR const uint8_t *data, size_t size,
       return -EPROTONOSUPPORT;
     }
 
-  for (size_t j = 0; j < 5; j++)
+  for (size_t j = 0; j < sizeof(values) / sizeof(values[0]); j++)
     {
       memcpy(&values[j], payload + layout->fields[j], sizeof(values[j]));
       values[j] = le32toh(values[j]);
@@ -1077,6 +1093,14 @@ static int bcmf_trace_decode_counts(FAR const uint8_t *data, size_t size,
   counts->txretry = values[2];
   counts->txretrie = values[3];
   counts->txfail = values[4];
+  counts->rxframe = values[5];
+  counts->rxerror = values[6];
+  counts->rxnobuf = values[7];
+  counts->rxoflo = values[8];
+  counts->rxfilter = values[9];
+  counts->rxbadproto = values[10];
+  counts->rxfragerr = values[11];
+  counts->reset = values[12];
   return OK;
 }
 
diff --git a/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi_f2_frame.c b/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi_f2_frame.c
--- a/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi_f2_frame.c
+++ b/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi_f2_frame.c
@@ -154,8 +154,10 @@ int bcmf_gspi_read_f2_frame(FAR struct bcmf_dev_s *priv, int frame_length)
 
   /* Request free frame buffer */
 
+  BCMF_TRACE_RX(&priv->bc_dev, BCMF_TRACE_RX_ATTEMPT);
   if (frame_length < sizeof(f2_frame_header_t))
     {
+      BCMF_TRACE_RX(&priv->bc_dev, BCMF_TRACE_RX_SHORT);
       return -EINVAL;
     }
 
@@ -165,6 +167,7 @@ int bcmf_gspi_read_f2_frame(FAR struct bcmf_dev_s *priv, int frame_length)
 
   if (iframe == NULL)
     {
+      BCMF_TRACE_RX(&priv->bc_dev, BCMF_TRACE_RX_NOBUFFER);
       wlinfo("fail alloc\n");
       return -EAGAIN;
     }
@@ -172,6 +175,7 @@ int bcmf_gspi_read_f2_frame(FAR struct bcmf_dev_s *priv, int frame_length)
 
   if (frame_length > iframe->header.len)
     {
+      BCMF_TRACE_RX(&priv->bc_dev, BCMF_TRACE_RX_OVERSIZE);
       wlerr("Frame is too large, cancel %d > %d\n",
             frame_length,
             iframe->header.len);
@@ -192,6 +196,7 @@ int bcmf_gspi_read_f2_frame(FAR struct bcmf_dev_s *priv, int frame_length)
 
   if (ret != OK)
     {
+      BCMF_TRACE_RX(&priv->bc_dev, BCMF_TRACE_RX_SPIERROR);
       wlinfo("Failed to read frame data\n");
       ret = -EIO;
       goto exit_abort;
@@ -201,6 +206,7 @@ int bcmf_gspi_read_f2_frame(FAR struct bcmf_dev_s *priv, int frame_length)
 
   if (header->size == 0)
     {
+      BCMF_TRACE_RX(&priv->bc_dev, BCMF_TRACE_RX_EMPTY);
       ret = OK;
       goto exit_free_frame;
     }
@@ -209,6 +215,7 @@ int bcmf_gspi_read_f2_frame(FAR struct bcmf_dev_s *priv, int frame_length)
 
   if (checksum != 0xffff || header->size < sizeof(f2_frame_header_t))
     {
+      BCMF_TRACE_RX(&priv->bc_dev, BCMF_TRACE_RX_HEADERERROR);
       wlerr("Checksum failed: size:.0x%04X checksum: 0x%04X\n",
             header->size,
             header->checksum);
@@ -226,6 +233,7 @@ int bcmf_gspi_read_f2_frame(FAR struct bcmf_dev_s *priv, int frame_length)
   ret = process_f2_frame_header(gbus, header);
   if (ret != OK)
     {
+      BCMF_TRACE_RX(&priv->bc_dev, BCMF_TRACE_RX_OFFSETERROR);
       wlerr("Error while processing header %d\n", ret);
       ret = -EINVAL;
       goto exit_free_frame;
@@ -254,10 +262,12 @@ int bcmf_gspi_read_f2_frame(FAR struct bcmf_dev_s *priv, int frame_length)
   switch (header->channel & 0x0f)
     {
       case F2_FRAME_CONTROL_CHANNEL:
+        BCMF_TRACE_RX(&priv->bc_dev, BCMF_TRACE_RX_CONTROL);
         ret = bcmf_cdc_process_control_frame(priv, &iframe->header);
         goto exit_free_frame;
 
       case F2_FRAME_EVENT_CHANNEL:
+        BCMF_TRACE_RX(&priv->bc_dev, BCMF_TRACE_RX_EVENT);
         if (header->data_offset == header->size)
           {
             /* Empty event, ignore */
@@ -273,6 +283,7 @@ int bcmf_gspi_read_f2_frame(FAR struct bcmf_dev_s *priv, int frame_length)
         goto exit_free_frame;
 
       case F2_FRAME_DATA_CHANNEL:
+        BCMF_TRACE_RX(&priv->bc_dev, BCMF_TRACE_RX_DATA);
 
 #ifdef CONFIG_IEEE80211_BROADCOM_FRAME_TRACE
         if (header->size <= frame_length)
@@ -309,6 +320,7 @@ int bcmf_gspi_read_f2_frame(FAR struct bcmf_dev_s *priv, int frame_length)
         break;
 
       default:
+        BCMF_TRACE_RX(&priv->bc_dev, BCMF_TRACE_RX_UNKNOWN);
         wlerr("Got unexpected message type %d\n", header->channel);
         ret = -EINVAL;
         goto exit_free_frame;
