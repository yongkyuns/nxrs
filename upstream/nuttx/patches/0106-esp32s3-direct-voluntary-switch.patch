-/****************************************************************************
- * Name: _xtensa_context_save
- *
- * Description:
- *
- *   NOTE: MUST BE CALLED ONLY BY 'CALL0' INSTRUCTION!
- *
- *   This function saves Xtensa processor state.
- *   It is called directly by interrupt handling logic with interrupts
- *   disabled.  Registers PC, PS, A0, A1 (SP), A2 and A3 are saved before
- *   calling this function.
- *
- *   The counterpart to this function is _xtensa_context_restore().
- *
- * Entry Conditions:
- *   - A0  = Return address to caller.
- *   - Other processor state except PC, PS, A0, A1 (SP), A2 and A3 are as at
- *     the point of interruption.
- *
- * Exit conditions:
- *   - A0  = Return address in caller.
- *
- * Assumptions:
- *   - Caller is expected to have saved PC, PS, A0, A1 (SP), and A2.
- *   - If windowed ABI, PS.EXCM = 1 (exceptions disabled).
- *
- ****************************************************************************/
-
-	.section HANDLER_SECTION, "ax"
-	.global	_xtensa_context_save
-	.type	_xtensa_context_save, @function
-
-	.align	4
-	.literal_position
-	.align	4
-
-_xtensa_context_save:
-
+.macro context_save_general
 	s32i	a3,  sp, (4 * REG_A3)
 	s32i	a4,  sp, (4 * REG_A4)
 	s32i	a5,  sp, (4 * REG_A5)
@@ -152,6 +112,52 @@
 	rsr		a3, LCOUNT
 	s32i	a3, sp, (4 * REG_LCOUNT)
 #endif
+
+.endm
+
+/****************************************************************************
+ * Public Functions
+ ****************************************************************************/
+
+/****************************************************************************
+ * Name: _xtensa_context_save
+ *
+ * Description:
+ *
+ *   NOTE: MUST BE CALLED ONLY BY 'CALL0' INSTRUCTION!
+ *
+ *   This function saves Xtensa processor state.
+ *   It is called directly by interrupt handling logic with interrupts
+ *   disabled.  Registers PC, PS, A0, A1 (SP), A2 and A3 are saved before
+ *   calling this function.
+ *
+ *   The counterpart to this function is _xtensa_context_restore().
+ *
+ * Entry Conditions:
+ *   - A0  = Return address to caller.
+ *   - Other processor state except PC, PS, A0, A1 (SP), A2 and A3 are as at
+ *     the point of interruption.
+ *
+ * Exit conditions:
+ *   - A0  = Return address in caller.
+ *
+ * Assumptions:
+ *   - Caller is expected to have saved PC, PS, A0, A1 (SP), and A2.
+ *   - If windowed ABI, PS.EXCM = 1 (exceptions disabled).
+ *
+ ****************************************************************************/
+
+	.section HANDLER_SECTION, "ax"
+	.global	_xtensa_context_save
+	.type	_xtensa_context_save, @function
+
+	.align	4
+	.literal_position
+	.align	4
+
+_xtensa_context_save:
+
+	context_save_general
 
 #ifndef __XTENSA_CALL0_ABI__
 	/* To spill the reg windows, temp. need pre-interrupt stack ptr and
@@ -208,6 +214,7 @@
 
 #endif
 
+.Lcontext_save_coprocessors:
 #if XCHAL_CP_NUM > 0
 	xtensa_coproc_savestate
 #endif
@@ -312,3 +319,63 @@
 
 	.size	_xtensa_context_restore, . - _xtensa_context_restore
 
+
+/****************************************************************************
+ * Direct voluntary switch for ESP32-S3 flat, UP, windowed-ABI task context.
+ *
+ * The caller already excludes interrupts. Build the SAME full context as an
+ * exception, including coprocessor/TLS/loop state through the native save.
+ * Keep the normal interrupt-stack, debug-frame and full restore machinery.
+ * Only hardware exception entry and generic IRQ vector dispatch are avoided.
+ * Other build/ABI modes keep the existing syscall route.
+ ****************************************************************************/
+
+#if defined(CONFIG_ARCH_CHIP_ESP32S3) && defined(CONFIG_BUILD_FLAT) && \
+    !defined(CONFIG_SMP) && !defined(__XTENSA_CALL0_ABI__)
+
+	.section HANDLER_SECTION, "ax"
+	.align 4
+	.literal_position
+	.global xtensa_switch_context
+	.type xtensa_switch_context, @function
+
+/* Registers/ABI state are already spilled by the task entry. Unlike the
+ * exception entry, no EXCM transition or EPC1 preservation is needed.
+ * General/coprocessor snapshots are otherwise exactly the native full frame.
+ */
+	.type _xtensa_context_save_spilled, @function
+_xtensa_context_save_spilled:
+	context_save_general
+	j .Lcontext_save_coprocessors
+	.size _xtensa_context_save_spilled, . - _xtensa_context_save_spilled
+
+	.align 4
+xtensa_switch_context:
+	entry sp, 16
+	SPILL_ALL_WINDOWS
+	addi sp, sp, -XCPTCONTEXT_SIZE
+	s32i a0, sp, (4 * REG_A0)
+	s32i a2, sp, (4 * REG_A2)
+	addi a0, sp, XCPTCONTEXT_SIZE
+	s32i a0, sp, (4 * REG_A1)
+	rsr a0, PS
+	s32i a0, sp, (4 * REG_PS)
+	movi a0, .Lcooperative_resume
+	s32i a0, sp, (4 * REG_PC)
+	call0 _xtensa_context_save_spilled
+
+	mov a12, sp
+#if CONFIG_ARCH_INTERRUPTSTACK > 15
+	setintstack a13 a14
+#endif
+	ps_setup 1 a0
+	exception_backtrace a12 1 1
+	mov ARG1, a12
+	CALL xtensa_switch_context_prepare
+	mov a2, RETVAL
+	call0 _xtensa_context_return
+
+.Lcooperative_resume:
+	retw
+	.size xtensa_switch_context, . - xtensa_switch_context
+#endif
