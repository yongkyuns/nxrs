diff --git a/wireless/bluetooth/Kconfig b/wireless/bluetooth/Kconfig
--- a/wireless/bluetooth/Kconfig
+++ b/wireless/bluetooth/Kconfig
@@ -205,6 +205,14 @@
 	int "Tx command thread mqueue size"
 	default 16
 
+config BLUETOOTH_TXCONN_RESERVE
+	bool "Reserve the single ACL transmit worker and queue at initialization"
+	depends on BLUETOOTH_MAX_CONN = 1
+	default n
+	---help---
