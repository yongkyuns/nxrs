Subject: [PATCH] wireless/bcmf: expose validated PHY receive counters

Decode the seven documented PHY receive counters from the existing counters
reply for legacy native layouts and version 10. Version 30's software prefix
does not include these fields, so report them unavailable without probing
unrecognized XTLVs. This adds no firmware read or query-policy change.

diff --git a/include/nuttx/wireless/ieee80211/bcmf_trace.h b/include/nuttx/wireless/ieee80211/bcmf_trace.h
--- a/include/nuttx/wireless/ieee80211/bcmf_trace.h
+++ b/include/nuttx/wireless/ieee80211/bcmf_trace.h
@@ -79,6 +79,14 @@ struct bcmf_trace_counts_s
   uint32_t rxbadproto;
   uint32_t rxfragerr;
   uint32_t reset;
+  uint32_t phy_valid;
+  uint32_t rxbadfcs;
+  uint32_t rxbadplcp;
+  uint32_t rxcrsglitch;
+  uint32_t rxfrmtoolong;
+  uint32_t rxfrmtooshrt;
+  uint32_t rxinvmachdr;
+  uint32_t rxstrt;
 };
 
 /* Optional synchronous observer, defaulting to a weak no-op. Data is an
diff --git a/drivers/wireless/ieee80211/bcm43xxx/bcmf_netdev.c b/drivers/wireless/ieee80211/bcm43xxx/bcmf_netdev.c
--- a/drivers/wireless/ieee80211/bcm43xxx/bcmf_netdev.c
+++ b/drivers/wireless/ieee80211/bcm43xxx/bcmf_netdev.c
@@ -981,14 +981,20 @@ static int bcmf_trace_decode_counts(FAR const uint8_t *data, size_t size,
     uint16_t version;
     size_t size;
     bool exact;
     size_t fields[13];
+    size_t phy_fields[7];
+    bool phy;
   };
 #define BCMF_TRACE_LAYOUT(v, t, e) {v, sizeof(t), e, \
   {offsetof(t, txframe), offsetof(t, txretrans), offsetof(t, txretry), \
    offsetof(t, txretrie), offsetof(t, txfail), offsetof(t, rxframe), \
    offsetof(t, rxerror), offsetof(t, rxnobuf), offsetof(t, rxoflo), \
    offsetof(t, rxfilter), offsetof(t, rxbadproto), offsetof(t, rxfragerr), \
-   offsetof(t, reset)}}
+   offsetof(t, reset)}, \
+  {offsetof(t, rxbadfcs), offsetof(t, rxbadplcp), \
+   offsetof(t, rxcrsglitch), offsetof(t, rxfrmtoolong), \
+   offsetof(t, rxfrmtooshrt), offsetof(t, rxinvmachdr), \
+   offsetof(t, rxstrt)}, true}
   static const struct trace_layout_s layouts[] =
   {
     BCMF_TRACE_LAYOUT(6, wl_cnt_ver_six_t, true),
@@ -1000,12 +1006,33 @@ static int bcmf_trace_decode_counts(FAR const uint8_t *data, size_t size,
     BCMF_TRACE_LAYOUT(10, struct bcmf_trace_cnt10_prefix_s, false)
   };
   static const struct trace_layout_s layout30 =
-    BCMF_TRACE_LAYOUT(30, struct bcmf_trace_cnt30_prefix_s, false);
+    {30, sizeof(struct bcmf_trace_cnt30_prefix_s), false,
+     {offsetof(struct bcmf_trace_cnt30_prefix_s, txframe),
+      offsetof(struct bcmf_trace_cnt30_prefix_s, txretrans),
+      offsetof(struct bcmf_trace_cnt30_prefix_s, txretry),
+      offsetof(struct bcmf_trace_cnt30_prefix_s, txretrie),
+      offsetof(struct bcmf_trace_cnt30_prefix_s, txfail),
+      offsetof(struct bcmf_trace_cnt30_prefix_s, rxframe),
+      offsetof(struct bcmf_trace_cnt30_prefix_s, rxerror),
+      offsetof(struct bcmf_trace_cnt30_prefix_s, rxnobuf),
+      offsetof(struct bcmf_trace_cnt30_prefix_s, rxoflo),
+      offsetof(struct bcmf_trace_cnt30_prefix_s, rxfilter),
+      offsetof(struct bcmf_trace_cnt30_prefix_s, rxbadproto),
+      offsetof(struct bcmf_trace_cnt30_prefix_s, rxfragerr),
+      offsetof(struct bcmf_trace_cnt30_prefix_s, reset)}, {0}, false};
 #undef BCMF_TRACE_LAYOUT
   FAR const struct trace_layout_s *layout = NULL;
   FAR const uint8_t *payload = data;
   uint32_t values[13];
   uint16_t header[2];
 
+  counts->phy_valid = 0;
+  counts->rxbadfcs = 0;
+  counts->rxbadplcp = 0;
+  counts->rxcrsglitch = 0;
+  counts->rxfrmtoolong = 0;
+  counts->rxfrmtooshrt = 0;
+  counts->rxinvmachdr = 0;
+  counts->rxstrt = 0;
   if (size < sizeof(header))
     {
@@ -1106,5 +1128,25 @@ static int bcmf_trace_decode_counts(FAR const uint8_t *data, size_t size,
   counts->rxbadproto = values[10];
   counts->rxfragerr = values[11];
   counts->reset = values[12];
+  if (layout->phy)
+    {
+      uint32_t phy_values[7];
+
+      for (size_t j = 0; j < sizeof(phy_values) / sizeof(phy_values[0]); j++)
+        {
+          memcpy(&phy_values[j], payload + layout->phy_fields[j],
+                 sizeof(phy_values[j]));
+          phy_values[j] = le32toh(phy_values[j]);
+        }
+
+      counts->phy_valid = 1;
+      counts->rxbadfcs = phy_values[0];
+      counts->rxbadplcp = phy_values[1];
+      counts->rxcrsglitch = phy_values[2];
+      counts->rxfrmtoolong = phy_values[3];
+      counts->rxfrmtooshrt = phy_values[4];
+      counts->rxinvmachdr = phy_values[5];
+      counts->rxstrt = phy_values[6];
+    }
   return OK;
 }
