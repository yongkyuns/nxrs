+def get_register_layout():
+    """Map saved native context offsets to the connected GDB's registers."""
+    tcbinfo = gdb.parse_and_eval("g_tcbinfo")
+    reg_off = tcbinfo["reg_off"]["p"]
+    layout = {}
+
+    if is_target_arch("xtensa"):
+        # NuttX's table uses its GDB-stub order, not Espressif GDB's remote
+        # packet order (pc, ar0..ar63, ...). regs_num is the saved context's
+        # word count; the offset table also contains the reserved slots.
+        offsets = gdb.parse_and_eval("g_reg_offs")
+        first, last = offsets.type.strip_typedefs().range()
+        if first != 0 or last < 79 or int(offsets.address) != int(reg_off):
+            raise gdb.GdbError("Unsupported Xtensa saved-register offset table")
+        names = [(name, index) for index, name in enumerate(
+            ("pc", "ps", "lbeg", "lend", "lcount", "sar"))]
+        names.extend((f"a{index}", 64 + index) for index in range(16))
+        for name, index in names:
+            offset = int(offsets[index])
+            if offset != 0xFFFF:
+                layout[name] = {"tcb_reg_off": offset}
+        return layout
+
+    # Use the live remote description. An auxiliary file-only inferior can
+    # have a different register packet, even for the same architecture.
+    word_size = gdb.lookup_type("long").sizeof
+    packet_size = int(tcbinfo["regs_num"]) * word_size
+    lines = gdb.execute("maint print remote-registers", to_string=True)
+    for line in lines.splitlines()[1:]:
+        match = re.match(
+            r"\s*(\S+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\d+)\s+(\S+)(?:\s+(\d+)\s+(\d+))?",
+            line,
+        )
+        if not match:
+            continue
+        name, _, _, _, size, _, remote, offset = match.groups()
+        if remote is None:
+            continue
+        size, offset = int(size), int(offset)
+        if size != word_size or offset % word_size or offset + size > packet_size:
+            continue
+        saved_offset = int(reg_off[offset // word_size])
+        if saved_offset != 0xFFFF:
+            layout[name] = {"rmt_nr": int(remote), "tcb_reg_off": saved_offset}
+    return layout
+
