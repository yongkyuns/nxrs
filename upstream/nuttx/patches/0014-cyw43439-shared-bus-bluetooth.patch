+ * POSSIBILITY OF SUCH DAMAGE.
+ *
+ * Shared-bus protocol reference: Pico SDK 2.1.1 cybt_shared_bus, BSD-3-Clause.
+ * NuttX owns the bus, queues, HCI host, and firmware lifetime; no SDK runtime
+ * is linked. This transport has not yet been qualified on hardware.
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+
+#include <errno.h>
+#include <stdint.h>
+#include <string.h>
+#include <debug.h>
+
+#include <nuttx/kmalloc.h>
+#include <nuttx/signal.h>
+#include <nuttx/net/net.h>
+#include <nuttx/net/netdev.h>
+#include <nuttx/wireless/bluetooth/bt_driver.h>
+
+#include "bcmf_core.h"
+#include "bcmf_gspi.h"
+#include "bcmf_driver.h"
+
+#define BCMF_BT_FW_BASE      0x19000000
+#define BCMF_BT_PWRUP        0x19640894
+#define BCMF_BT_CTRL         0x18000c7c
+#define BCMF_BT_HOST_CTRL    0x18000d6c
+#define BCMF_BT_RAM_BASE     0x18000d68
+#define BCMF_BT_READY        (1 << 24)
+#define BCMF_BT_AWAKE        (1 << 8)
+#define BCMF_BT_HOST_READY   (1 << 24)
+#define BCMF_BT_HOST_WAKE    (1 << 17)
+#define BCMF_BT_DOORBELL     (1 << 1)
+#define BCMF_BT_RING_SIZE    4096
+#define BCMF_BT_RING_MASK    (BCMF_BT_RING_SIZE - 1)
+#define BCMF_BT_H2B_IN       0x2000
+#define BCMF_BT_H2B_OUT      0x2004
+#define BCMF_BT_B2H_IN       0x2008
+#define BCMF_BT_B2H_OUT      0x200c
+#define BCMF_BT_WAIT_COUNT   300
+#define BCMF_BT_RX_BATCH     4
+
+/* This pinned HCI host stores bt_buf_s.len in uint8_t. Reject packets it
+ * cannot represent, even if a larger IOB would physically hold them.
+ */
+
+#define BCMF_BT_MAX_PACKET   MIN(255, CONFIG_IOB_BUFSIZE - 1)
+#define BCMF_BT_FRAME_WORDS  ((BCMF_BT_MAX_PACKET + 7) / 4)
+
+struct bcmf_bt_s
+{
+  struct bt_driver_s driver;
+  FAR bcmf_gspi_dev_t *gbus;
+  FAR const uint8_t *firmware;
+  size_t firmware_len;
+  mutex_t lock;                  /* HCI rings, host-control cache, and close */
+  mutex_t lifecycle;             /* Open/close, without blocking Wi-Fi RX */
+  uint32_t generation;
+  uint32_t ram_base;
+  uint32_t host_ctrl;
+  bool opened;
+  int fault;                     /* Sticky: never retry an ambiguous commit */
+};
+
+static uint32_t bcmf_bt_le32(FAR const uint8_t *p)
+{
+  return (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+         (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+/* All transfers are word aligned and stay within the conservative 4 KiB
+ * shared-bus boundary used by the reference transport. The common backplane
+ * helpers serialize window selection AND the transfer against Wi-Fi.
+ */
+
+static int bcmf_bt_mem(FAR struct bcmf_bt_s *bt, bool write, uint32_t addr,
+                       FAR uint8_t *buf, size_t len)
+{
+  size_t count;
+  int ret;
+
+  if ((addr | len | (uintptr_t)buf) & 3)
+    {
+      return -EINVAL;
+    }
+
+  while (len > 0)
+    {
+      count = MIN(len, MIN(64, 0x1000 - (addr & 0xfff)));
+      ret = write ? bcmf_write_sbreg(bt->gbus, addr, buf, count)
+                  : bcmf_read_sbreg(bt->gbus, addr, buf, count);
+      if (ret < 0)
+        {
+          return ret;
+        }
+
+      addr += count;
+      buf += count;
+      len -= count;
+    }
+
+  return OK;
+}
+
+static int bcmf_bt_reg(FAR struct bcmf_bt_s *bt, bool write, uint32_t addr,
+                       FAR uint32_t *value)
+{
+  uint8_t *bytes = (FAR uint8_t *)value;
+  uint32_t word;
+  int ret;
+
+  if (write)
+    {
+      uint8_t *p = (FAR uint8_t *)&word;
+      p[0] = *value;
+      p[1] = *value >> 8;
+      p[2] = *value >> 16;
+      p[3] = *value >> 24;
+      return bcmf_bt_mem(bt, true, addr, p, 4);
+    }
+
+  ret = bcmf_bt_mem(bt, false, addr, bytes, 4);
+  if (ret == OK)
+    {
+      *value = bcmf_bt_le32(bytes);
+    }
+
+  return ret;
+}
+
+static int bcmf_bt_control(FAR struct bcmf_bt_s *bt, uint32_t value)
+{
+  int ret = bcmf_bt_reg(bt, true, BCMF_BT_HOST_CTRL, &value);
+
+  if (ret == OK)
+    {
+      /* HOST_CTRL is host-owned. Avoid read/modify/write of a concurrently
+       * changing hardware register, as in the reference implementation.
+       */
+
+      bt->host_ctrl = value;
+    }
+
+  return ret;
+}
+
+static int bcmf_bt_wait(FAR struct bcmf_bt_s *bt, uint32_t mask)
+{
+  uint32_t value;
+  int ret;
+  int i;
+
+  for (i = 0; i < BCMF_BT_WAIT_COUNT; i++)
+    {
+      ret = bcmf_bt_reg(bt, false, BCMF_BT_CTRL, &value);
+      if (ret < 0)
+        {
+          return ret;
+        }
+
+      if ((value & mask) == mask)
+        {
+          return OK;
+        }
+
+      nxsched_usleep(1000);
+    }
+
+  return -ETIMEDOUT;
+}
+
+static int bcmf_bt_write_bytes(FAR struct bcmf_bt_s *bt, uint32_t addr,
+                               FAR const uint8_t *data, size_t len)
+{
+  uint32_t words[16];
+  uint8_t *bytes = (FAR uint8_t *)words;
+  size_t offset;
+  size_t count;
+  int ret;
+
+  while (len > 0)
+    {
+      offset = addr & 3;
+      count = MIN(len, 4 - offset);
+      if (offset == 0 && len >= 4)
+        {
+          count = MIN(len & ~3, sizeof(words));
+          memcpy(bytes, data, count);
+          ret = bcmf_bt_mem(bt, true, addr, bytes, count);
+        }
+      else
+        {
+          /* Patchram records need not be aligned. Preserve neighboring
+           * controller bytes rather than padding over a preceding record.
+           */
+
+          ret = bcmf_bt_mem(bt, false, addr & ~3, bytes, 4);
+          if (ret < 0)
+            {
+              return ret;
+            }
+
+          memcpy(bytes + offset, data, count);
+          ret = bcmf_bt_mem(bt, true, addr & ~3, bytes, 4);
+        }
+
+      if (ret < 0)
+        {
+          return ret;
+        }
+
+      addr += count;
+      data += count;
+      len -= count;
+    }
+
+  return OK;
+}
+
+/* Walk twice: reject a malformed patchram image before the first write.
+ * The record-count byte is informational, not a bounds check.
+ */
+
+static int bcmf_bt_firmware(FAR struct bcmf_bt_s *bt, bool upload)
+{
+  FAR const uint8_t *fw = bt->firmware;
+  size_t size = bt->firmware_len;
+  size_t pos;
+  size_t count;
+  uint32_t base = 0;
+  uint32_t address;
+  unsigned int type;
+  int ret;
+
+  if (fw == NULL || size < 3 || fw[0] == 0 ||
+      (size_t)fw[0] + 2 > size || fw[fw[0]] != 0 ||
+      memchr(fw + 1, 0, fw[0] - 1) != NULL)
+    {
+      return -EINVAL;
+    }
+
+  pos = fw[0] + 2;
+  while (size - pos >= 4)
+    {
+      count = fw[pos];
+      address = (uint32_t)fw[pos + 1] << 8 | fw[pos + 2];
+      type = fw[pos + 3];
+      pos += 4;
+      if (count > size - pos)
+        {
+          return -EINVAL;
+        }
+
+      if (type == 0 && count > 0)
+        {
+          /* Keep patchram addresses within the Bluetooth memory region. */
+
+          if ((uint64_t)base + address + count > 0x1000000)
+            {
+              return -EINVAL;
+            }
+
+          if (upload)
+            {
+              ret = bcmf_bt_write_bytes(bt, BCMF_BT_FW_BASE + base + address,
+                                         fw + pos, count);
+              if (ret < 0)
+                {
+                  return ret;
+                }
+            }
+        }
+      else if ((type == 2 || type == 4) && count == 2 && address == 0)
+        {
+          base = ((uint32_t)fw[pos] << 8 | fw[pos + 1]) <<
+                 (type == 2 ? 4 : 16);
+        }
+      else if (type == 5 && count == 4 && address == 0)
+        {
+          base = (uint32_t)fw[pos] << 24 | (uint32_t)fw[pos + 1] << 16 |
+                 (uint32_t)fw[pos + 2] << 8 | fw[pos + 3];
+        }
+      else if (type == 1 && count == 0 && address == 0)
+        {
+          while (pos < size)
+            {
+              if (fw[pos++] != 0)
+                {
+                  return -EINVAL;
+                }
+            }
+
+          return OK;
+        }
+      else
+        {
+          return -EINVAL;
+        }
+
+      pos += count;
+    }
+
+  return -EINVAL;
+}
+
+static int bcmf_bt_indices(FAR struct bcmf_bt_s *bt, uint32_t offset,
+                           FAR uint32_t *in, FAR uint32_t *out)
+{
+  int ret = bcmf_bt_reg(bt, false, bt->ram_base + offset, in);
+
+  if (ret == OK)
+    {
+      ret = bcmf_bt_reg(bt, false, bt->ram_base + offset + 4, out);
+    }
+
+  if (ret == OK && ((*in | *out) & 3 ||
+                   *in >= BCMF_BT_RING_SIZE || *out >= BCMF_BT_RING_SIZE))
+    {
+      ret = -EPROTO;
+    }
+
+  return ret;
+}
+
+static int bcmf_bt_ring(FAR struct bcmf_bt_s *bt, bool write, uint32_t base,
+                        uint32_t offset, FAR uint8_t *data, size_t len)
+{
+  size_t first = MIN(len, BCMF_BT_RING_SIZE - offset);
+  int ret = bcmf_bt_mem(bt, write, base + offset, data, first);
+
+  if (ret == OK && first < len)
+    {
+      ret = bcmf_bt_mem(bt, write, base, data + first, len - first);
+    }
+
+  return ret;
+}
+
+static bool bcmf_bt_packet(unsigned int type, FAR const uint8_t *data,
+                           size_t len, bool tx)
+{
+  if (len > BCMF_BT_MAX_PACKET)
+    {
+      return false;
+    }
+
+  if (type == 1 && tx)
+    {
+      return len >= 3 && len == (size_t)data[2] + 3;
+    }
+
+  if (type == 4 && !tx)
+    {
+      return len >= 2 && len == (size_t)data[1] + 2;
+    }
+
+  if (type == 2)
+    {
+      return len >= 4 && len == ((size_t)data[2] | (size_t)data[3] << 8) + 4;
+    }
+
+  return false;
+}
+
+static int bcmf_bt_send_once(FAR struct bcmf_bt_s *bt,
+                             FAR uint8_t *frame, size_t len)
+{
+  uint32_t in;
+  uint32_t out;
+  int ret = bcmf_bt_indices(bt, BCMF_BT_H2B_IN, &in, &out);
+
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  if (len > ((out - in - 4) & BCMF_BT_RING_MASK))
+    {
+      return -EAGAIN;
+    }
+
+  ret = bcmf_bt_ring(bt, true, bt->ram_base, in, frame, len);
+  if (ret == OK)
+    {
+      in = (in + len) & BCMF_BT_RING_MASK;
+      ret = bcmf_bt_reg(bt, true, bt->ram_base + BCMF_BT_H2B_IN, &in);
+    }
+
+  if (ret == OK)
+    {
+      ret = bcmf_bt_control(bt, bt->host_ctrl ^ BCMF_BT_DOORBELL);
+    }
+
+  return ret;
+}
+
+static int bcmf_bt_send(FAR struct bt_driver_s *driver,
+                        enum bt_buf_type_e type, FAR void *data, size_t len)
+{
+  FAR struct bcmf_bt_s *bt = driver->priv;
+  uint32_t words[BCMF_BT_FRAME_WORDS] = {0};
+  uint8_t *frame = (FAR uint8_t *)words;
+  unsigned int packet_type;
+  uint32_t generation;
+  size_t size;
+  int ret;
+  int i;
+
+  packet_type = type == BT_CMD ? 1 : type == BT_ACL_OUT ? 2 : 0;
+  if (data == NULL || !bcmf_bt_packet(packet_type, data, len, true))
+    {
+      return -EINVAL;
+    }
+
+  frame[0] = len;
+  frame[1] = len >> 8;
+  frame[2] = len >> 16;
+  frame[3] = packet_type;
+  memcpy(frame + 4, data, len);
+  size = (len + 7) & ~3;
+
+  nxmutex_lock(&bt->lock);
+  generation = bt->generation;
+  ret = bt->opened ? OK : -ENODEV;
+  nxmutex_unlock(&bt->lock);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  /* A full ring is backpressure, not permission to drop an HCI command.
+   * Release the transport mutex while waiting so RX can make progress.
+   */
+
+  for (i = 0; i < BCMF_BT_WAIT_COUNT; i++)
+    {
+      nxmutex_lock(&bt->lock);
+      ret = !bt->opened || bt->generation != generation ? -ENODEV :
+            bt->fault != 0 ? bt->fault :
+            bcmf_bt_send_once(bt, frame, size);
+      if (ret < 0 && ret != -EAGAIN && ret != -ENODEV)
+        {
+          bt->fault = ret;
+        }
+
+      nxmutex_unlock(&bt->lock);
+      if (ret != -EAGAIN)
+        {
+          return ret;
+        }
+
+      nxsched_usleep(1000);
+    }
+
+  return -ETIMEDOUT;
+}
+
+static int bcmf_bt_receive_one(FAR struct bcmf_bt_s *bt)
+{
+  uint32_t words[BCMF_BT_FRAME_WORDS];
+  uint8_t *frame = (FAR uint8_t *)words;
+  uint32_t in;
+  uint32_t out;
+  uint32_t count;
+  size_t len;
+  size_t size;
+  int ret;
+
+  ret = bcmf_bt_indices(bt, BCMF_BT_B2H_IN, &in, &out);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  count = (in - out) & BCMF_BT_RING_MASK;
+  if (count < 4)
+    {
+      return 0;
+    }
+
+  ret = bcmf_bt_ring(bt, false, bt->ram_base + BCMF_BT_RING_SIZE,
+                     out, frame, 4);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  len = frame[0] | (size_t)frame[1] << 8 | (size_t)frame[2] << 16;
+  if (len > BCMF_BT_MAX_PACKET)
+    {
+      return -EMSGSIZE;
+    }
+
+  size = (len + 7) & ~3;
+  if (count < size)
+    {
+      return 0;
+    }
+
+  ret = bcmf_bt_ring(bt, false, bt->ram_base + BCMF_BT_RING_SIZE,
+                     out, frame, size);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  if (!bcmf_bt_packet(frame[3], frame + 4, len, false))
+    {
+      return -EPROTO;
+    }
+
+  /* The HCI callback copies the packet. No backplane mutex is held.
+   * Preserve the controller read pointer when the host cannot accept it.
+   * Holding lock here makes close wait for any callback already in flight.
+   */
+
+  ret = bt->driver.receive(&bt->driver,
+                           frame[3] == 4 ? BT_EVT : BT_ACL_IN,
+                           frame + 4, len);
+  if (ret == -ENOMEM || ret == -EAGAIN)
+    {
+      return 0;
+    }
+
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  out = (out + size) & BCMF_BT_RING_MASK;
+  ret = bcmf_bt_reg(bt, true, bt->ram_base + BCMF_BT_B2H_OUT, &out);
+  if (ret == OK)
+    {
+      ret = bcmf_bt_control(bt, bt->host_ctrl ^ BCMF_BT_DOORBELL);
+    }
+
+  return ret < 0 ? ret : 1;
+}
+
+int bcmf_gspi_bt_poll(FAR bcmf_gspi_dev_t *gbus)
+{
+  FAR struct bcmf_bt_s *bt;
+  int count = 0;
+  int ret;
+
+  nxmutex_lock(&gbus->power_lock);
+  bt = gbus->bt;
+  nxmutex_unlock(&gbus->power_lock);
+  if (bt == NULL)
+    {
+      return 0;
+    }
+
+  nxmutex_lock(&bt->lock);
+  while (bt->opened && bt->fault == 0 && count < BCMF_BT_RX_BATCH)
+    {
+      ret = bcmf_bt_receive_one(bt);
+      if (ret < 0)
+        {
+          bt->fault = ret;
+          wlerr("CYW43439 HCI transport fault: %d\n", ret);
+        }
+
+      if (ret <= 0)
+        {
+          break;
+        }
+
+      count++;
+    }
+
+  nxmutex_unlock(&bt->lock);
+  return count;
+}
+
+/* Called with lifecycle held. A failed controller stop retains shared power:
+ * a void close callback cannot claim the controller is safely asleep.
+ */
+
+static void bcmf_bt_close_locked(FAR struct bcmf_bt_s *bt)
+{
+  int ret = OK;
+
+  nxmutex_lock(&bt->lock);
+  bt->opened = false;
+  bt->generation++;
+  if (bt->gbus->ready)
+    {
+      ret = bcmf_bt_control(bt, bt->host_ctrl &
+                              ~(BCMF_BT_HOST_READY | BCMF_BT_HOST_WAKE));
+    }
+
+  if (ret < 0)
+    {
+      bt->fault = ret;
+      wlerr("CYW43439 HCI stop fault: %d\n", ret);
+    }
+
+  nxmutex_unlock(&bt->lock);
+  if (ret == OK)
+    {
+      bcmf_gspi_bt_power(bt->gbus, false);
+    }
+}
+
+static void bcmf_bt_close(FAR struct bt_driver_s *driver)
+{
+  FAR struct bcmf_bt_s *bt = driver->priv;
+
+  nxmutex_lock(&bt->lifecycle);
+  bcmf_bt_close_locked(bt);
+  nxmutex_unlock(&bt->lifecycle);
+}
+
+static int bcmf_bt_open(FAR struct bt_driver_s *driver)
+{
+  FAR struct bcmf_bt_s *bt = driver->priv;
+  FAR struct bcmf_dev_s *priv = bt->gbus->gspi->priv;
+  uint32_t value;
+  uint32_t zero = 0;
+  int ret;
+  int i;
+
+  nxmutex_lock(&bt->lifecycle);
+  nxmutex_lock(&bt->lock);
+  ret = bt->opened ? -EALREADY : OK;
+  nxmutex_unlock(&bt->lock);
+  if (ret < 0)
+    {
+      nxmutex_unlock(&bt->lifecycle);
+      return ret;
+    }
+
+  /* Claim shared power before bringing up Wi-Fi, serialized with ifdown.
+   * No association or credentials are needed to use the HCI transport.
+   */
+
+  net_lock();
+  ret = bcmf_gspi_bt_power(bt->gbus, true);
+  if (ret == OK)
+    {
+      ret = netdev_ifup(&priv->bc_dev);
+    }
+
+  net_unlock();
+  if (ret < 0)
+    {
+      bcmf_gspi_bt_power(bt->gbus, false);
+      nxmutex_unlock(&bt->lifecycle);
+      return ret;
+    }
+
+  nxmutex_lock(&bt->lock);
+  bt->fault = 0;
+  bt->host_ctrl = 0;
+  ret = bcmf_bt_firmware(bt, false);
+  if (ret == OK)
+    {
+      value = 3;
+      ret = bcmf_bt_reg(bt, true, BCMF_BT_PWRUP, &value);
+    }
+
+  if (ret == OK)
+    {
+      ret = bcmf_bt_firmware(bt, true);
+    }
+
+  if (ret == OK)
+    {
+      nxsched_usleep(150000);
+      ret = bcmf_bt_wait(bt, BCMF_BT_READY);
+    }
+
+  if (ret == OK)
+    {
+      ret = bcmf_bt_reg(bt, false, BCMF_BT_RAM_BASE, &bt->ram_base);
+    }
+
+  if (ret == OK && ((bt->ram_base & 3) != 0 ||
+                   bt->ram_base < bt->gbus->chip->ram_base ||
+                   (uint64_t)bt->ram_base + BCMF_BT_B2H_OUT + 4 >
+                   (uint64_t)bt->gbus->chip->ram_base +
+                             bt->gbus->chip->ram_size))
+    {
+      ret = -EPROTO;
+    }
+
+  for (i = 0; ret == OK && i < 4; i++)
+    {
+      ret = bcmf_bt_reg(bt, true, bt->ram_base + BCMF_BT_H2B_IN + 4 * i,
+                        &zero);
+    }
+
+  if (ret == OK)
+    {
+      ret = bcmf_bt_control(bt, BCMF_BT_HOST_WAKE);
+    }
+
+  if (ret == OK)
+    {
+      ret = bcmf_bt_wait(bt, BCMF_BT_AWAKE);
+    }
+
+  if (ret == OK)
+    {
+      ret = bcmf_bt_control(bt, bt->host_ctrl |
+                               BCMF_BT_HOST_READY | BCMF_BT_DOORBELL);
+    }
+
+  bt->opened = ret == OK;
+  nxmutex_unlock(&bt->lock);
+  if (ret < 0)
+    {
+      bcmf_bt_close_locked(bt);
+    }
+
+  nxmutex_unlock(&bt->lifecycle);
+  nxsem_post(&bt->gbus->thread_signal);
+  return ret;
+}
+
+int bcmf_gspi_bt_initialize(FAR struct gspi_dev_s *gspi,
+                            FAR const uint8_t *firmware, size_t len)
+{
+  FAR struct bcmf_dev_s *priv;
+  FAR bcmf_gspi_dev_t *gbus;
+  FAR struct bcmf_bt_s *bt;
+  int ret;
+
+  if (gspi == NULL || gspi->priv == NULL || firmware == NULL || len == 0)
+    {
+      return -EINVAL;
+    }
+
+  priv = gspi->priv;
+  gbus = (FAR bcmf_gspi_dev_t *)priv->bus;
+  bt = kmm_zalloc(sizeof(*bt));
+  if (bt == NULL)
+    {
+      return -ENOMEM;
+    }
+
+  bt->gbus = gbus;
+  bt->firmware = firmware;
+  bt->firmware_len = len;
+  bt->driver.priv = bt;
+  bt->driver.open = bcmf_bt_open;
+  bt->driver.send = bcmf_bt_send;
+  bt->driver.close = bcmf_bt_close;
+  nxmutex_init(&bt->lock);
+  nxmutex_init(&bt->lifecycle);
+
+  ret = bcmf_bt_firmware(bt, false);
+  if (ret < 0)
+    {
+      nxmutex_destroy(&bt->lock);
+      nxmutex_destroy(&bt->lifecycle);
+      kmm_free(bt);
+      return ret;
+    }
+
+  nxmutex_lock(&gbus->power_lock);
+  if (gbus->bt != NULL)
+    {
+      nxmutex_unlock(&gbus->power_lock);
+      nxmutex_destroy(&bt->lock);
+      nxmutex_destroy(&bt->lifecycle);
+      kmm_free(bt);
+      return -EALREADY;
+    }
+
+  /* This is a boot-time driver instance, not a per-scan allocation. Keep
+   * its lifetime stable for the existing radio daemon, including errors.
+   */
+
+  gbus->bt = bt;
+  nxmutex_unlock(&gbus->power_lock);
+  ret = bt_driver_register(&bt->driver);
+  if (ret < 0)
+    {
+      bcmf_bt_close(&bt->driver);
+    }
+
+  return ret;
+}
