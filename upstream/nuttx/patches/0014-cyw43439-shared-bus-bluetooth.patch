From: nxrs contributors
Subject: [PATCH] bcmf: add optional CYW43439 shared-gSPI Bluetooth HCI

Experimental transport based on the BSD-3-Clause Pico SDK 2.1.1 shared-bus
protocol. Keep Wi-Fi and HCI backplane windows atomic, retain shared power
while HCI is open, and poll bounded HCI batches in the existing radio daemon.
Stage board-owned patchram separately; no Pico SDK runtime is linked.
Host tests and cross-compilation do not constitute hardware qualification.

diff --git a/drivers/wireless/ieee80211/bcm43xxx/bcmf_core.c b/drivers/wireless/ieee80211/bcm43xxx/bcmf_core.c
--- a/drivers/wireless/ieee80211/bcm43xxx/bcmf_core.c
+++ b/drivers/wireless/ieee80211/bcm43xxx/bcmf_core.c
@@ -458,10 +458,20 @@
 int bcmf_read_sbreg(FAR bcmf_interface_dev_t *ibus, uint32_t address,
                     FAR uint8_t *reg, unsigned int len)
 {
-  int ret = bcmf_core_set_backplane_window(ibus, address);
-  if (ret != OK)
+  int ret;
+
+#ifdef CONFIG_IEEE80211_INFINEON_CYW43439_BLUETOOTH
+  ret = nxmutex_lock(&ibus->backplane_lock);
+  if (ret < 0)
     {
       return ret;
+    }
+#endif
+
+  ret = bcmf_core_set_backplane_window(ibus, address);
+  if (ret != OK)
+    {
+      goto out;
     }
 
   address &= SBSDIO_SB_OFT_ADDR_MASK;
@@ -473,7 +483,13 @@
       address |= SBSDIO_SB_ACCESS_2_4B_FLAG;
     }
 
-  return bcmf_transfer_bytes(ibus, false, 1, address, reg, len);
+  ret = bcmf_transfer_bytes(ibus, false, 1, address, reg, len);
+
+out:
+#ifdef CONFIG_IEEE80211_INFINEON_CYW43439_BLUETOOTH
+  nxmutex_unlock(&ibus->backplane_lock);
+#endif
+  return ret;
 }
 
 /****************************************************************************
