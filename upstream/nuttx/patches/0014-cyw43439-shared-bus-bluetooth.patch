diff --git a/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.c b/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.c
--- a/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.c
+++ b/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.c
@@ -315,9 +315,58 @@
 
 static int bcmf_gspi_bus_lowpower(FAR bcmf_gspi_dev_t *gbus, bool enable)
 {
-  return gbus->support_sr ? bcmf_gspi_kso_enable(gbus, !enable)
-                          : bcmf_gspi_bus_sleep(gbus, enable);
+  int ret;
+
+#ifdef CONFIG_IEEE80211_INFINEON_CYW43439_BLUETOOTH
+  nxmutex_lock(&gbus->power_lock);
+  if (enable && gbus->bt_active)
+    {
+      nxmutex_unlock(&gbus->power_lock);
+      return OK;
+    }
+#endif
+
+  ret = gbus->support_sr ? bcmf_gspi_kso_enable(gbus, !enable)
+                        : bcmf_gspi_bus_sleep(gbus, enable);
+
+#ifdef CONFIG_IEEE80211_INFINEON_CYW43439_BLUETOOTH
+  nxmutex_unlock(&gbus->power_lock);
+#endif
+  return ret;
+}
+
+#ifdef CONFIG_IEEE80211_INFINEON_CYW43439_BLUETOOTH
+bool bcmf_gspi_bt_active(FAR bcmf_gspi_dev_t *gbus)
+{
+  bool active;
+
+  nxmutex_lock(&gbus->power_lock);
+  active = gbus->bt_active;
+  nxmutex_unlock(&gbus->power_lock);
+  return active;
+}
+
+int bcmf_gspi_bt_power(FAR bcmf_gspi_dev_t *gbus, bool active)
+{
+  int ret = OK;
+
+  nxmutex_lock(&gbus->power_lock);
+  gbus->bt_active = active;
+  if (active && gbus->ready)
+    {
+      ret = gbus->support_sr ? bcmf_gspi_kso_enable(gbus, true)
+                            : bcmf_gspi_bus_sleep(gbus, false);
+      if (ret < 0)
+        {
+          gbus->bt_active = false;
+        }
+    }
+
+  nxmutex_unlock(&gbus->power_lock);
+  nxsem_post(&gbus->thread_signal);
+  return ret;
 }
+#endif
 
 /****************************************************************************
  * Name: bcmf_gspi_thread_isr
@@ -474,12 +523,34 @@
 
       /* No more transfer requests.  Wait for something to happen. */
 
+#ifdef CONFIG_IEEE80211_INFINEON_CYW43439_BLUETOOTH
+      /* Bound each Bluetooth batch so Wi-Fi is serviced between batches. */
+
+      if (bcmf_gspi_bt_poll(gbus) > 0)
+        {
+          wait_for_event = false;
+        }
+#endif
+
       if (wait_for_event)
         {
           /* Wait for event (device interrupt or user request) */
 
           gspi->interrupt_enable(gspi, true);
 
+#ifdef CONFIG_IEEE80211_INFINEON_CYW43439_BLUETOOTH
+          if (bcmf_gspi_bt_active(gbus))
+            {
+              /* Bluetooth uses the same daemon, not another kernel thread.
+               * A bounded fallback poll also covers missing radio IRQs.
+               */
+
+              enter_low_power = false;
+              nxsem_tickwait_uninterruptible(&gbus->thread_signal,
+                                             MSEC2TICK(5) + 1);
+            }
+          else
+#endif
           if (enter_low_power)
             {
               enter_low_power = false;
@@ -829,6 +900,10 @@
   /* Init transmit frames queue */
 
   nxmutex_init(&gbus->queue_lock);
+#ifdef CONFIG_IEEE80211_INFINEON_CYW43439_BLUETOOTH
+  nxmutex_init(&gbus->backplane_lock);
+  nxmutex_init(&gbus->power_lock);
+#endif
   list_initialize(&gbus->tx_queue);
   list_initialize(&gbus->rx_queue);
 
@@ -1084,4 +1159,3 @@
 
   return OK;
 }
