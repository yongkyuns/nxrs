diff --git a/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.h b/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.h
--- a/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.h
+++ b/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.h
@@ -96,6 +96,13 @@
 
   uint32_t backplane_current_addr; /* Current function 1 backplane base addr */
 
+#ifdef CONFIG_IEEE80211_INFINEON_CYW43439_BLUETOOTH
+  mutex_t backplane_lock;          /* Window selection plus data transfer */
+  mutex_t power_lock;              /* Serialize sleep with Bluetooth lease */
+  bool bt_active;                  /* Protected by power_lock */
+  FAR struct bcmf_bt_s *bt;        /* Permanent registered transport */
+#endif
+
   uint8_t max_seq;                 /* Maximum transmit sequence allowed */
   uint8_t tx_seq;                  /* Transmit sequence number (next) */
 
@@ -111,6 +118,12 @@
 
 int bcmf_gspi_initialize(FAR struct gspi_dev_s *gspi);
 
+#ifdef CONFIG_IEEE80211_INFINEON_CYW43439_BLUETOOTH
+int bcmf_gspi_bt_poll(FAR bcmf_gspi_dev_t *gbus);
+bool bcmf_gspi_bt_active(FAR bcmf_gspi_dev_t *gbus);
+int bcmf_gspi_bt_power(FAR bcmf_gspi_dev_t *gbus, bool active);
+#endif
+
 int bcmf_bus_gspi_active(FAR struct bcmf_dev_s *priv,
                          bool                   active);
 
diff --git a/drivers/wireless/ieee80211/bcm43xxx/bcmf_netdev.c b/drivers/wireless/ieee80211/bcm43xxx/bcmf_netdev.c
--- a/drivers/wireless/ieee80211/bcm43xxx/bcmf_netdev.c
+++ b/drivers/wireless/ieee80211/bcm43xxx/bcmf_netdev.c
@@ -53,6 +53,10 @@
 #include "bcmf_bdc.h"
 #include "bcmf_ioctl.h"
 #include "bcmf_netdev.h"
+
+#ifdef CONFIG_IEEE80211_INFINEON_CYW43439_BLUETOOTH
+#  include "bcmf_gspi.h"
+#endif
 
 /****************************************************************************
  * Pre-processor Definitions
@@ -678,6 +682,18 @@
 {
   FAR struct bcmf_dev_s *priv = (FAR struct bcmf_dev_s *)dev->d_private;
   irqstate_t flags;
+
+#ifdef CONFIG_IEEE80211_INFINEON_CYW43439_BLUETOOTH
+  /* Wi-Fi disassociation is independent, but powering off this shared
+   * interface while HCI is open would silently destroy Bluetooth.
+   * The network lock serializes this check with the HCI open path.
+   */
+
+  if (bcmf_gspi_bt_active((FAR bcmf_gspi_dev_t *)priv->bus))
+    {
+      return -EBUSY;
+    }
+#endif
 
   /* Disable the hardware interrupt */
 
@@ -771,10 +787,20 @@
                                bcmf_lowpower_ifdown_work,
                                SEC2TICK(LP_IFDOWN_TIMEOUT)))
     {
+#ifdef CONFIG_IEEE80211_INFINEON_CYW43439_BLUETOOTH
+      /* netdev_ifdown itself does not take the network lock. Serialize the
+       * lease check and shared-chip shutdown with HCI open, like ioctl does.
+       */
+
+      net_lock();
+#endif
       if (priv->bc_bifup)
         {
           netdev_ifdown(&priv->bc_dev);
         }
+#ifdef CONFIG_IEEE80211_INFINEON_CYW43439_BLUETOOTH
+      net_unlock();
+#endif
     }
 }
 
diff --git a/drivers/wireless/ieee80211/bcm43xxx/Kconfig b/drivers/wireless/ieee80211/bcm43xxx/Kconfig
--- a/drivers/wireless/ieee80211/bcm43xxx/Kconfig
+++ b/drivers/wireless/ieee80211/bcm43xxx/Kconfig
@@ -40,6 +40,22 @@
 	default n
 	select IEEE80211_BROADCOM_HAVE_CLM
 
+config IEEE80211_INFINEON_CYW43439_BLUETOOTH
+	bool "CYW43439 shared-gSPI Bluetooth HCI transport (experimental)"
+	depends on IEEE80211_INFINEON_CYW43439
+	depends on IEEE80211_BROADCOM_FULLMAC_GSPI
+	depends on !IEEE80211_BROADCOM_FULLMAC_SDIO
+	depends on DRIVERS_BLUETOOTH && NET_BLUETOOTH
+	depends on WIRELESS_BLUETOOTH_HOST
+	default n
+	---help---
+		Register the Bluetooth HCI host on the existing FullMAC radio bus.
+		The board provides a patchram image. The existing radio daemon
+		services both interfaces; no additional transport thread is used.
+		Wi-Fi need not be associated, but wlan0 must stay up while HCI is
+		open because both interfaces use the same chip and power supply.
+		Hardware qualification is still required.
+
 config IEEE80211_BROADCOM_FWFILES
 	bool "Firmware files"
 	default y
