Subject: [PATCH] bluetooth: propagate advertising command failures

Wait for each advertising setup command and return controller or transport
errors to the caller. Keep the cached enable state aligned with controller
confirmation, abort a restart when stopping the current advertisement fails,
and return stop failures through the Bluetooth ioctl.

diff --git a/wireless/bluetooth/bt_hcicore.c b/wireless/bluetooth/bt_hcicore.c
--- a/wireless/bluetooth/bt_hcicore.c
+++ b/wireless/bluetooth/bt_hcicore.c
@@ -2259,6 +2259,8 @@ int bt_start_advertising(uint8_t type, FAR const struct bt_eir_s *ad,
   FAR struct bt_hci_cp_le_set_adv_data_s *scan_rsp;
   FAR struct bt_hci_cp_le_set_adv_parameters_s *set_param;
   int i;
+  int ret;
+  uint8_t enable;
 
   /* If advertising is already enabled, stop it first.
    * We cannot change advertising parameters while advertising is active.
@@ -2266,7 +2267,11 @@ int bt_start_advertising(uint8_t type, FAR const struct bt_eir_s *ad,
   if (g_btdev.adv_enable)
     {
       wlinfo("Stopping existing advertising before restart\n");
-      bt_stop_advertising();
+      ret = bt_stop_advertising();
+      if (ret != 0)
+        {
+          return ret;
+        }
     }
 
   if (ad == NULL)
@@ -2296,7 +2301,11 @@ int bt_start_advertising(uint8_t type, FAR const struct bt_eir_s *ad,
       set_data->len += ad[i].len + 1;
     }
 
-  bt_hci_cmd_send(BT_HCI_OP_LE_SET_ADV_DATA, buf);
+  ret = bt_hci_cmd_send_sync(BT_HCI_OP_LE_SET_ADV_DATA, buf, NULL);
+  if (ret != 0)
+    {
+      return ret;
+    }
 
 send_scan_rsp:
   if (sd == NULL)
@@ -2336,7 +2345,11 @@ int bt_start_advertising(uint8_t type, FAR const struct bt_eir_s *ad,
       scan_rsp->len += sd[i].len + 1;
     }
 
-  bt_hci_cmd_send(BT_HCI_OP_LE_SET_SCAN_RSP_DATA, buf);
+  ret = bt_hci_cmd_send_sync(BT_HCI_OP_LE_SET_SCAN_RSP_DATA, buf, NULL);
+  if (ret != 0)
+    {
+      return ret;
+    }
 
 send_set_param:
   /* Use public address for advertising (type 0x00).
@@ -2353,6 +2366,10 @@ int bt_start_advertising(uint8_t type, FAR const struct bt_eir_s *ad,
   set_param->channel_map  = 0x07;
 
-  bt_hci_cmd_send(BT_HCI_OP_LE_SET_ADV_PARAMETERS, buf);
+  ret = bt_hci_cmd_send_sync(BT_HCI_OP_LE_SET_ADV_PARAMETERS, buf, NULL);
+  if (ret != 0)
+    {
+      return ret;
+    }
 
   buf = bt_hci_cmd_create(BT_HCI_OP_LE_SET_ADV_ENABLE, 1);
   if (buf == NULL)
@@ -2363,8 +2380,14 @@ int bt_start_advertising(uint8_t type, FAR const struct bt_eir_s *ad,
       return -ENOBUFS;
     }
 
-  g_btdev.adv_enable = 0x01;
-  memcpy(bt_buf_extend(buf, 1), &g_btdev.adv_enable, 1);
+  enable = 0x01;
+  memcpy(bt_buf_extend(buf, 1), &enable, 1);
+  ret = bt_hci_cmd_send_sync(BT_HCI_OP_LE_SET_ADV_ENABLE, buf, NULL);
 
-  return bt_hci_cmd_send_sync(BT_HCI_OP_LE_SET_ADV_ENABLE, buf, NULL);
+  if (ret == 0)
+    {
+      g_btdev.adv_enable = 0x01;
+    }
+
+  return ret;
 }
@@ -2385,5 +2407,7 @@ int bt_stop_advertising(void)
 {
   FAR struct bt_buf_s *buf;
+  uint8_t enable;
+  int ret;
 
   if (!g_btdev.adv_enable)
     {
@@ -2399,8 +2425,13 @@ int bt_stop_advertising(void)
       return -ENOBUFS;
     }
 
-  g_btdev.adv_enable = 0x00;
-  memcpy(bt_buf_extend(buf, 1), &g_btdev.adv_enable, 1);
+  enable = 0x00;
+  memcpy(bt_buf_extend(buf, 1), &enable, 1);
+  ret = bt_hci_cmd_send_sync(BT_HCI_OP_LE_SET_ADV_ENABLE, buf, NULL);
+  if (ret == 0)
+    {
+      g_btdev.adv_enable = enable;
+    }
 
-  return bt_hci_cmd_send_sync(BT_HCI_OP_LE_SET_ADV_ENABLE, buf, NULL);
+  return ret;
 }
diff --git a/wireless/bluetooth/bt_ioctl.c b/wireless/bluetooth/bt_ioctl.c
--- a/wireless/bluetooth/bt_ioctl.c
+++ b/wireless/bluetooth/bt_ioctl.c
@@ -607,8 +607,7 @@ int btnet_ioctl(FAR struct net_driver_s *netdev, int cmd, unsigned long arg)
       case SIOCBTADVSTOP:
         {
           wlinfo("Stop advertising\n");
-          bt_stop_advertising();
-          ret = OK;
+          ret = bt_stop_advertising();
         }
         break;
 
