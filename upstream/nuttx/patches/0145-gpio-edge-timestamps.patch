Subject: [PATCH] gpio: retain edge timestamps and support static ESP callbacks

Expose the retained monotonic edge timestamp through the GPIO device contract
and allow a static ESP GPIO callback without an allocated IRQ adapter. Board
pin registration lives with the selected custom BSP.

--- a/drivers/ioexpander/Kconfig
+++ b/drivers/ioexpander/Kconfig
@@ -644,6 +644,10 @@
 		contributes whatever only it can say, such as which pad carries
 		the line.
 
+config DEV_GPIO_EDGE_TIMESTAMP
+	bool "Retain a monotonic timestamp for GPIO interrupt edges"
+	default n
+
 config DEV_GPIO_NPOLLWAITERS
 	int "Max number of polls"
 	default 1
--- a/include/nuttx/ioexpander/gpio.h
+++ b/include/nuttx/ioexpander/gpio.h
@@ -28,6 +28,9 @@
  ****************************************************************************/
 
 #include <nuttx/config.h>
+#ifdef CONFIG_DEV_GPIO_EDGE_TIMESTAMP
+#  include <time.h>
+#endif
 
 #include <sys/types.h>
 #include <stdint.h>
@@ -90,6 +93,7 @@
 #define GPIOC_SETPINTYPE  _GPIOC(6)
 #define GPIOC_SETDEBOUNCE _GPIOC(7)
 #define GPIOC_IRQ_SETMASK _GPIOC(8)
+#define GPIOC_EDGE_TIME   _GPIOC(9)
 
 /****************************************************************************
  * Public Types
@@ -186,6 +190,18 @@
 
 /* Pin interface definition.  Must lie in writable memory. */
 
+#ifdef CONFIG_DEV_GPIO_EDGE_TIMESTAMP
+/* GPIOC_EDGE_TIME returns and acknowledges the latest edge for this file.
+ * It returns -EAGAIN when no edge is pending. Sequence gaps mean overwritten
+ * edges. The timestamp uses CLOCK_MONOTONIC.
+ */
+struct gpio_edge_s
+{
+  struct timespec time;
+  uintptr_t sequence;
+};
+#endif
+
 struct gpio_dev_s
 {
   /* Information provided from the lower half driver to the upper half
@@ -201,6 +217,9 @@
   /* Number of times interrupt occurred */
 
   uintptr_t int_count;
+#ifdef CONFIG_DEV_GPIO_EDGE_TIMESTAMP
+  struct timespec int_time;
+#endif
 
   /* Writable storage used by the upper half driver */
 
--- a/drivers/ioexpander/gpio.c
+++ b/drivers/ioexpander/gpio.c
@@ -25,6 +25,9 @@
  ****************************************************************************/
 
 #include <nuttx/config.h>
+#ifdef CONFIG_DEV_GPIO_EDGE_TIMESTAMP
+#  include <nuttx/clock.h>
+#endif
 
 #include <sys/types.h>
 #include <inttypes.h>
@@ -526,7 +529,14 @@
 
   DEBUGASSERT(dev != NULL);
 
+#ifdef CONFIG_DEV_GPIO_EDGE_TIMESTAMP
+  irqstate_t flags = enter_critical_section();
+  clock_systime_timespec(&dev->int_time);
   dev->int_count++;
+  leave_critical_section(flags);
+#else
+  dev->int_count++;
+#endif
 
 #if CONFIG_DEV_GPIO_NPOLLWAITERS > 0
   poll_notify(dev->fds, CONFIG_DEV_GPIO_NPOLLWAITERS, POLLIN);
@@ -1035,6 +1045,33 @@
           break;
         }
 
+#ifdef CONFIG_DEV_GPIO_EDGE_TIMESTAMP
+      case GPIOC_EDGE_TIME:
+        {
+          FAR struct gpio_edge_s *out = (FAR struct gpio_edge_s *)arg;
+          struct gpio_edge_s edge;
+
+          if (out == NULL)
+            {
+              return -EINVAL;
+            }
+
+          flags = enter_critical_section();
+          edge.sequence = dev->int_count;
+          if (edge.sequence == (uintptr_t)filep->f_priv)
+            {
+              leave_critical_section(flags);
+              return -EAGAIN;
+            }
+
+          edge.time = dev->int_time;
+          filep->f_priv = (FAR void *)edge.sequence;
+          leave_critical_section(flags);
+          *out = edge;
+        }
+        break;
+#endif
+
       /* Unrecognized command */
 
       default:
--- a/arch/xtensa/src/common/espressif/esp_gpio.h
+++ b/arch/xtensa/src/common/espressif/esp_gpio.h
@@ -320,6 +320,7 @@
  ****************************************************************************/
 
 #ifdef CONFIG_ESPRESSIF_GPIO_IRQ
+int esp_gpio_isr(int id, void (*handler)(void *), void *arg);
 int esp_gpio_irq(int id, xcpt_t irqhandler, void *arg);
 #endif
 
--- a/arch/xtensa/src/common/espressif/esp_gpio.c
+++ b/arch/xtensa/src/common/espressif/esp_gpio.c
@@ -414,6 +414,14 @@
  ****************************************************************************/
 
 #ifdef CONFIG_ESPRESSIF_GPIO_IRQ
+/* Register the board's static callback without allocating an IRQ adapter. */
+int esp_gpio_isr(int id, void (*handler)(void *), void *arg)
+{
+  esp_err_t ret = handler ? gpio_isr_handler_add(id, handler, arg) :
+                            gpio_isr_handler_remove(id);
+  return ret == ESP_OK ? OK : -ERROR;
+}
+
 int esp_gpio_irq(int id, xcpt_t irqhandler, void *arg)
 {
   int ret;
