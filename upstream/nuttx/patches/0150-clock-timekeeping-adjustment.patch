+/****************************************************************************
+ * Name: clock_accumulate_time
+ *
+ * Description:
+ *   Commit elapsed time and adjustment before changing the adjustment or
+ *   its epoch.  The caller holds g_clock_lock.
+ ****************************************************************************/
+
+static int clock_accumulate_time(void)
+{
+  clock_t counter;
+  int ret;
+
+  ret = up_timer_gettick(&counter);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  ret = clock_project_time(counter, &g_clock_wall_time, &g_clock_adjust,
+                           &g_clock_adjust_fraction);
+  if (ret >= 0)
+    {
+      g_clock_last_counter = counter;
+    }
+
+  return ret;
+}
+
+/****************************************************************************
+ * Name: clock_adjust_delta
+ *
+ * Description:
+ *   Convert an adjustment to signed nanoseconds without overflowing either
+ *   multiplication or addition.  The accepted range is limited to int64_t
+ *   nanoseconds; invalid requests leave the current adjustment unchanged.
+ ****************************************************************************/
+
+#ifdef CONFIG_CLOCK_ADJTIME
+static int clock_adjust_delta(FAR const struct timeval *delta,
+                              FAR int64_t *adjust)
+{
+  int64_t usec;
+
+  if (delta->tv_usec <= -USEC_PER_SEC || delta->tv_usec >= USEC_PER_SEC)
+    {
+      return -EINVAL;
+    }
+
+  if (delta->tv_sec > INT64_MAX / USEC_PER_SEC ||
+      delta->tv_sec < INT64_MIN / USEC_PER_SEC)
+    {
+      return -EOVERFLOW;
+    }
+
+  usec = delta->tv_sec * (int64_t)USEC_PER_SEC;
+  if ((delta->tv_usec > 0 && usec > INT64_MAX - delta->tv_usec) ||
+      (delta->tv_usec < 0 && usec < INT64_MIN - delta->tv_usec))
+    {
+      return -EOVERFLOW;
+    }
+
+  usec += delta->tv_usec;
+  if (usec > INT64_MAX / NSEC_PER_USEC ||
+      usec < INT64_MIN / NSEC_PER_USEC)
+    {
+      return -EOVERFLOW;
+    }
+
+  *adjust = usec * NSEC_PER_USEC;
+  return OK;
+}
+#endif
