Subject: wireless/bcm43xxx: compare HCI RAM snapshots after invalid indices

In error-debug builds only, compare the cached Bluetooth RAM base with a
fresh controller register read and compare one paired index read with the
failed single-word reads. Report errno and equality/validity, not addresses
or RAM contents. Failed probes remain unavailable; successful probes cannot
recover the rejected operation. These are sequential snapshots, not an
atomic controller state or evidence of a particular physical fault.

diff --git a/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi_bt.c b/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi_bt.c
index 0bb52ac..6cbb14a 100644
--- a/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi_bt.c
+++ b/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi_bt.c
@@ -159,6 +159,38 @@ static int bcmf_bt_reg(FAR struct bcmf_bt_s *bt, bool write, uint32_t addr,
   return ret;
 }
 
+#ifdef CONFIG_DEBUG_WIRELESS_ERROR
+static void bcmf_bt_ram_diagnostics(FAR struct bcmf_bt_s *bt, uint32_t offset,
+                                    uint32_t in, uint32_t out)
+{
+  uint32_t live_base = 0;
+  uint32_t words[2] = {0};
+  FAR uint8_t *bytes = (FAR uint8_t *)words;
+  uint32_t pair_in;
+  uint32_t pair_out;
+  int base_ret;
+  int pair_ret;
+
+  /* Compare the live base and one paired read with the failed single-word
+   * reads. These are sequential snapshots, not an atomic controller state
+   * or a retry: no result can recover the failed operation. Log only errors
+   * and equality/validity, never addresses or RAM contents.
+   */
+
+  base_ret = bcmf_bt_reg(bt, false, BCMF_BT_RAM_BASE, &live_base);
+  pair_ret = bcmf_bt_mem(bt, false, bt->ram_base + offset, bytes,
+                         sizeof(words));
+  pair_in = bcmf_bt_le32(bytes);
+  pair_out = bcmf_bt_le32(bytes + 4);
+  wlerr("CYW43439 HCI RAM diagnostics base_result=%d base_match=%u "
+        "pair_result=%d pair_match=%u pair_valid=%u\n", base_ret,
+        base_ret == OK && live_base == bt->ram_base, pair_ret,
+        pair_ret == OK && pair_in == in && pair_out == out,
+        pair_ret == OK && ((pair_in | pair_out) & 3) == 0 &&
+        pair_in < BCMF_BT_RING_SIZE && pair_out < BCMF_BT_RING_SIZE);
+}
+#endif
+
 static int bcmf_bt_control(FAR struct bcmf_bt_s *bt, uint32_t value)
 {
   int ret = bcmf_bt_reg(bt, true, BCMF_BT_HOST_CTRL, &value);
@@ -352,6 +384,7 @@ static int bcmf_bt_indices(FAR struct bcmf_bt_s *bt, uint32_t offset,
             offset == BCMF_BT_B2H_IN, (unsigned long)*in,
             (unsigned long)*out);
 #ifdef CONFIG_DEBUG_WIRELESS_ERROR
+      bcmf_bt_ram_diagnostics(bt, offset, *in, *out);
       bcmf_gspi_bus_diagnostics(bt->gbus);
 #endif
       ret = -EPROTO;

