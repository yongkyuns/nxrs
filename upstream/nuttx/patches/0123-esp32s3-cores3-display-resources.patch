Subject: [PATCH] esp32s3: register the CoreS3 display bus

Configure the panel interface, reset and power at BSP bring-up.
Register the existing NuttX SPI character driver for panel commands.

diff --git a/boards/Kconfig b/boards/Kconfig
index 66b7ea6..8039f2a 100644
--- a/boards/Kconfig
+++ b/boards/Kconfig
@@ -518,8 +518,8 @@ config ARCH_BOARD_ESP32S3_M5_CORES3
 	depends on ARCH_CHIP_ESP32S3CUSTOM
 	select ARCH_BOARD_COMMON
 	---help---
-		CoreS3 raw UART and I2C resources. Optional device protocols are
-		owned by their consumers; display, audio and camera stay disabled.
+		CoreS3 UART and I2C resources and optional SPI display wiring.
+		Device protocols are owned by their consumers.
 
 config ARCH_BOARD_ESP32S3_M5_CARDPUTER
 	bool "M5Stack Cardputer (ESP32-S3)"
diff --git a/boards/xtensa/esp32s3/esp32s3-m5-cores3/Kconfig b/boards/xtensa/esp32s3/esp32s3-m5-cores3/Kconfig
index 6026469..453b26c 100644
--- a/boards/xtensa/esp32s3/esp32s3-m5-cores3/Kconfig
+++ b/boards/xtensa/esp32s3/esp32s3-m5-cores3/Kconfig
@@ -1 +1,11 @@
 # CoreS3 resources are configured by the ESP32-S3 UART/I2C Kconfig.
+
+config ESP32S3_M5_CORES3_LCD
+	bool "Register the built-in CoreS3 SPI LCD endpoint"
+	depends on ESP32S3_I2C0_MASTER_MODE && ESP32S3_SPI2
+	depends on ESP32S3_SPI_SWCS && !ESP32S3_SPI_UDCS
+	depends on SPI_DRIVER && SPI_CMDDATA && BOARD_LATE_INITIALIZE
+	depends on !MMCSD_SPI && ESP32S3_SPI2_MISOPIN = -1
+	---help---
+		Bring up the panel rails and register SPI2 for the write-only LCD.
+		GPIO35 is LCD D/C in this mode, so SD card SPI is unavailable.
diff --git a/boards/xtensa/esp32s3/esp32s3-m5-cores3/src/Make.defs b/boards/xtensa/esp32s3/esp32s3-m5-cores3/src/Make.defs
index 8e92817..aa23436 100644
--- a/boards/xtensa/esp32s3/esp32s3-m5-cores3/src/Make.defs
+++ b/boards/xtensa/esp32s3/esp32s3-m5-cores3/src/Make.defs
@@ -2,3 +2,7 @@
 CSRCS = esp32s3_boot.c
 DEPPATH += --dep-path board
 VPATH += :board
+
+ifeq ($(CONFIG_ESP32S3_M5_CORES3_LCD),y)
+  CSRCS += esp32s3_lcd_bus.c
+endif
diff --git a/boards/xtensa/esp32s3/esp32s3-m5-cores3/src/esp32s3_boot.c b/boards/xtensa/esp32s3/esp32s3-m5-cores3/src/esp32s3_boot.c
index 1e8f235..6ca971b 100644
--- a/boards/xtensa/esp32s3/esp32s3-m5-cores3/src/esp32s3_boot.c
+++ b/boards/xtensa/esp32s3/esp32s3-m5-cores3/src/esp32s3_boot.c
@@ -7,6 +7,9 @@
 #include <nuttx/fs/fs.h>
 #include <syslog.h>
 #include "esp32s3_i2c.h"
+#ifdef CONFIG_ESP32S3_M5_CORES3_LCD
+int cores3_lcd_bus_initialize(void);
+#endif
 void esp32s3_board_initialize(void) {}
 #ifdef CONFIG_BOARD_LATE_INITIALIZE
 void board_late_initialize(void)
@@ -19,8 +22,10 @@ void board_late_initialize(void)
   int mounted = nx_mount(NULL, "/proc", "procfs", 0, NULL);
   if (mounted < 0) syslog(LOG_ERR, "CoreS3 procfs mount failed: %d\n", mounted);
 #endif
-  /* Preserve PMIC/charger defaults. No optional display/audio rails or 5V
-   * output are enabled here; those require separate power qualification. */
+#ifdef CONFIG_ESP32S3_M5_CORES3_LCD
+  int lcd = cores3_lcd_bus_initialize();
+  if (lcd < 0) syslog(LOG_ERR, "CoreS3 LCD bus registration failed: %d\n", lcd);
+#endif
 }
 #endif
 #ifdef CONFIG_BOARDCTL_RESET
diff --git a/boards/xtensa/esp32s3/esp32s3-m5-cores3/src/esp32s3_lcd_bus.c b/boards/xtensa/esp32s3/esp32s3-m5-cores3/src/esp32s3_lcd_bus.c
new file mode 100644
index 0000000..0b81d7f
--- /dev/null
+++ b/boards/xtensa/esp32s3/esp32s3-m5-cores3/src/esp32s3_lcd_bus.c
@@ -0,0 +1,140 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+#include <nuttx/arch.h>
+#include <nuttx/i2c/i2c_master.h>
+#include <nuttx/spi/spi.h>
+#include <nuttx/spi/spi_transfer.h>
+#include <errno.h>
+
+#include "espressif/esp_gpio.h"
+#include "esp32s3_i2c.h"
+#include "esp32s3_spi.h"
+
+#define LCD_DC        35
+#define SD_CS         4
+#define AW9523_ADDR   0x58
+#define AXP2101_ADDR  0x34
+#define LCD_RESET     (1 << 1) /* AW9523 P1_1 */
+#define LCD_BACKLIGHT (1 << 7) /* AXP2101 DLDO1 */
+
+static int set_bits(struct i2c_master_s *bus, uint8_t address, uint8_t reg,
+                    uint8_t mask, uint8_t bits)
+{
+  struct i2c_config_s config =
+    {
+      .frequency = I2C_SPEED_STANDARD,
+      .address = address,
+      .addrlen = 7,
+    };
+  uint8_t data[2] = {reg};
+  int ret = i2c_writeread(bus, &config, &reg, 1, &data[1], 1);
+
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  data[1] = (data[1] & ~mask) | bits;
+  return i2c_write(bus, &config, data, sizeof(data));
+}
+
+uint8_t esp32s3_spi2_status(struct spi_dev_s *dev, uint32_t devid)
+{
+  return devid == SPIDEV_DISPLAY(0) ? SPI_STATUS_PRESENT : 0;
+}
+
+int esp32s3_spi2_cmddata(struct spi_dev_s *dev, uint32_t devid, bool command)
+{
+  if (devid != SPIDEV_DISPLAY(0))
+    {
+      return -ENODEV;
+    }
+
+  esp_gpiowrite(LCD_DC, !command);
+  return OK;
+}
+
+int cores3_lcd_bus_initialize(void)
+{
+  struct i2c_master_s *i2c = esp32s3_i2cbus_initialize(0);
+  struct spi_dev_s *spi = NULL;
+  int ret;
+
+  if (i2c == NULL)
+    {
+      return -ENODEV;
+    }
+
+  /* Prevent the SD slot from driving GPIO35 while the LCD owns that pin. */
+
+  esp_gpiowrite(SD_CS, true);
+  esp_configgpio(SD_CS, OUTPUT | PULLUP);
+  esp_gpiowrite(LCD_DC, true);
+  esp_configgpio(LCD_DC, OUTPUT);
+
+  /* Keep the backlight off while pulsing the external active-low reset.
+   * Preserve the other power rails and expander outputs.
+   */
+
+  ret = set_bits(i2c, AXP2101_ADDR, 0x90, LCD_BACKLIGHT, 0);
+  if (ret < 0)
+    {
+      goto out;
+    }
+
+  ret = set_bits(i2c, AW9523_ADDR, 0x03, LCD_RESET, 0);
+  if (ret < 0)
+    {
+      goto out;
+    }
+
+  ret = set_bits(i2c, AW9523_ADDR, 0x13, LCD_RESET, LCD_RESET);
+  if (ret < 0)
+    {
+      goto out;
+    }
+
+  ret = set_bits(i2c, AW9523_ADDR, 0x05, LCD_RESET, 0);
+  if (ret < 0)
+    {
+      goto out;
+    }
+
+  up_mdelay(10);
+  ret = set_bits(i2c, AW9523_ADDR, 0x03, LCD_RESET, LCD_RESET);
+  if (ret < 0)
+    {
+      goto out;
+    }
+
+  up_mdelay(120);
+  spi = esp32s3_spibus_initialize(ESP32S3_SPI2);
+  if (spi == NULL)
+    {
+      ret = -ENODEV;
+      goto out;
+    }
+
+  /* 2.6 V is within the CoreS3 panel backlight supply range. */
+
+  ret = set_bits(i2c, AXP2101_ADDR, 0x99, 0x1f, 21);
+  if (ret >= 0)
+    {
+      ret = set_bits(i2c, AXP2101_ADDR, 0x90, LCD_BACKLIGHT, LCD_BACKLIGHT);
+    }
+
+  if (ret >= 0)
+    {
+      ret = spi_register(spi, ESP32S3_SPI2);
+    }
+
+  if (ret < 0)
+    {
+      set_bits(i2c, AXP2101_ADDR, 0x90, LCD_BACKLIGHT, 0);
+      esp32s3_spibus_uninitialize(spi);
+    }
+
+out:
+  esp32s3_i2cbus_uninitialize(i2c);
+  return ret;
+}
