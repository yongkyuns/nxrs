+static int ov3660_validate_frame_setting(struct imgsensor_s *sensor,
+                                         imgsensor_stream_type_t type,
+                                         uint8_t nr_datafmts,
+                                         imgsensor_format_t *formats,
+                                         imgsensor_interval_t *interval)
+{
+  uint64_t requested;
+  uint64_t supported;
+  (void)type;
+  if (nr_datafmts != 1 || formats == NULL || interval == NULL ||
+      formats[IMGSENSOR_FMT_MAIN].width != OV3660_WIDTH ||
+      formats[IMGSENSOR_FMT_MAIN].height != OV3660_HEIGHT ||
+      formats[IMGSENSOR_FMT_MAIN].pixelformat != IMGSENSOR_PIX_FMT_RGB565X)
+    {
+      return -EINVAL;
+    }
+
+  if (interval->numerator == 0 || interval->denominator == 0)
+    {
+      return -EINVAL;
+    }
+
+  /* Espressif's QVGA preset is 10.25 FPS (4/41 s/frame) at 16 MHz XCLK. */
+  requested = (uint64_t)interval->numerator * 41;
+  supported = (uint64_t)interval->denominator * 4;
+  if (requested != supported)
+    {
+      return -EINVAL;
+    }
+
+  return OK;
+}
+
+static int ov3660_start_capture(struct imgsensor_s *sensor,
+                                imgsensor_stream_type_t type,
+                                uint8_t nr_datafmts,
+                                imgsensor_format_t *formats,
+                                imgsensor_interval_t *interval)
+{
+  struct ov3660_dev_s *priv = (struct ov3660_dev_s *)sensor;
+
+  if (priv->capture_active)
+    {
+      return -EBUSY;
+    }
+
+  if (!priv->initialized)
+    {
+      return -EPIPE;
+    }
+
+  if (ov3660_validate_frame_setting(sensor, type, nr_datafmts,
+                                    formats, interval) < 0)
+    {
+      return -EINVAL;
+    }
+
+  /* This callback can run in the VSYNC path; never perform I2C here. */
+  priv->capture_active = true;
+  return OK;
+}
+
+static int ov3660_stop_capture(struct imgsensor_s *sensor,
+                               imgsensor_stream_type_t type)
+{
+  struct ov3660_dev_s *priv = (struct ov3660_dev_s *)sensor;
+  (void)type;
+  /* complete_capture() may invoke this from interrupt context. Sensor DVP
+   * output remains continuous; uninit() performs the thread-context I2C.
+   */
+  priv->capture_active = false;
+  return OK;
+}
+
+static int ov3660_get_frame_interval(struct imgsensor_s *sensor,
+                                     imgsensor_stream_type_t type,
+                                     imgsensor_interval_t *interval)
+{
+  (void)sensor;
+  (void)type;
+  if (interval == NULL)
+    {
+      return -EINVAL;
+    }
+
+  interval->numerator = 4;
+  interval->denominator = 41;
+  return OK;
+}
+
+static int ov3660_get_supported_value(struct imgsensor_s *sensor,
+                                      uint32_t id,
+                                      imgsensor_supported_value_t *value)
+{
+  (void)sensor;
+  (void)id;
+  (void)value;
+  return -ENOTSUP;
+}
+
+static int ov3660_get_value(struct imgsensor_s *sensor,
+                            uint32_t id, uint32_t size,
+                            imgsensor_value_t *value)
+{
+  (void)sensor;
+  (void)id;
+  (void)size;
+  (void)value;
+  return -ENOTSUP;
+}
+
+static int ov3660_set_value(struct imgsensor_s *sensor,
+                            uint32_t id, uint32_t size,
+                            imgsensor_value_t value)
+{
+  (void)sensor;
+  (void)id;
+  (void)size;
+  (void)value;
+  return -ENOTSUP;
+}
+
+static const struct imgsensor_ops_s g_ov3660_ops =
+{
+  .is_available         = ov3660_is_available,
+  .init                 = ov3660_init,
+  .uninit               = ov3660_uninit,
+  .get_driver_name      = ov3660_get_driver_name,
+  .validate_frame_setting = ov3660_validate_frame_setting,
+  .start_capture        = ov3660_start_capture,
+  .stop_capture         = ov3660_stop_capture,
+  .get_frame_interval   = ov3660_get_frame_interval,
+  .get_supported_value  = ov3660_get_supported_value,
+  .get_value            = ov3660_get_value,
+  .set_value            = ov3660_set_value,
+};
+
+static const struct v4l2_fmtdesc g_ov3660_fmts[] =
+{
+  { .pixelformat = OV3660_RGB565X, .description = "RGB565X" },
+};
+
+struct imgsensor_s *ov3660_initialize(struct i2c_master_s *i2c)
+{
+  struct ov3660_dev_s *priv;
+
+  if (i2c == NULL)
+    {
+      return NULL;
+    }
+
+  priv = kmm_zalloc(sizeof(*priv));
+  if (priv == NULL)
+    {
+      return NULL;
+    }
+
+  priv->i2c = i2c;
+  priv->framesize.type = V4L2_FRMSIZE_TYPE_DISCRETE;
+  priv->framesize.discrete.width = OV3660_WIDTH;
+  priv->framesize.discrete.height = OV3660_HEIGHT;
+  priv->interval.type = V4L2_FRMIVAL_TYPE_DISCRETE;
+  priv->interval.discrete.numerator = 4;
+  priv->interval.discrete.denominator = 41;
+
+  priv->sensor.ops = &g_ov3660_ops;
+  priv->sensor.fmtdescs = g_ov3660_fmts;
+  priv->sensor.fmtdescs_num = sizeof(g_ov3660_fmts) / sizeof(g_ov3660_fmts[0]);
+  priv->sensor.frmsizes = &priv->framesize;
+  priv->sensor.frmsizes_num = 1;
+  priv->sensor.frmintervals = &priv->interval;
+  priv->sensor.frmintervals_num = 1;
+
+  return &priv->sensor;
+}
+
+#endif /* CONFIG_VIDEO_OV3660 */
