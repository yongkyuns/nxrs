From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Nxrs Contributors <dev@nxrs.invalid>
Date: Mon, 19 Oct 2026 00:00:00 -0400
Subject: [PATCH 67] Add OV3660 RGB565 imgsensor lower-half

Register an OV3660 imgsensor lower-half using the NuttX 13.1 API.
The QVGA RGB565 setup is derived from Espressif esp32-camera commit
f37e65608f709bd94846dee01d947f02ae07c0b0. JPEG is deliberately not
advertised because the stock ESP32-S3 imgdata callback reports its
allocated buffer size rather than the variable compressed frame length.

---
diff --git a/drivers/video/Kconfig b/drivers/video/Kconfig
--- a/drivers/video/Kconfig
+++ b/drivers/video/Kconfig
@@ -494,9 +494,18 @@ config VIDEO_GC0308
 	bool "GC0308 camera chip"
 	default n
 	select I2C
 	---help---
 		GC0308 VGA CMOS image sensor with DVP interface.
 
+config VIDEO_OV3660
+	bool "OV3660 camera chip"
+	default n
+	depends on DRIVERS_VIDEO
+	select I2C
+	---help---
+		OV3660 3MP CMOS image sensor. Exposes QVGA RGB565X at 4/41 s/frame.
+		Supply a 16 MHz external clock for this fixed sensor preset.
+
 config GOLDFISH_CAMERA
 	bool "Goldfish camera support"
 	depends on VIDEO
diff --git a/drivers/video/Make.defs b/drivers/video/Make.defs
--- a/drivers/video/Make.defs
+++ b/drivers/video/Make.defs
@@ -63,6 +63,10 @@ ifeq ($(CONFIG_VIDEO_GC0308),y)
   CSRCS += gc0308.c
 endif
 
+ifeq ($(CONFIG_VIDEO_OV3660),y)
+  CSRCS += ov3660.c
+endif
+
 endif
 
 ifeq ($(CONFIG_GOLDFISH_FB),y)
diff --git a/drivers/video/CMakeLists.txt b/drivers/video/CMakeLists.txt
--- a/drivers/video/CMakeLists.txt
+++ b/drivers/video/CMakeLists.txt
@@ -53,6 +53,10 @@ if(CONFIG_VIDEO_GC0308)
       list(APPEND SRCS gc0308.c)
     endif()
 
+    if(CONFIG_VIDEO_OV3660)
+      list(APPEND SRCS ov3660.c)
+    endif()
+
   endif()
 
   if(CONFIG_GOLDFISH_FB)
