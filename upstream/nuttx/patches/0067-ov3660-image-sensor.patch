+/* Espressif's 4:3 QVGA crop/binning sequence for its 2048x1536 array. */
+static int ov3660_configure_qvga_rgb565(struct ov3660_dev_s *priv)
+{
+  static const struct ov3660_reg_s regs[] =
+  {
+    { 0x3800, 0x00 }, { 0x3801, 0x00 }, /* x start 0 */
+    { 0x3802, 0x00 }, { 0x3803, 0x00 }, /* y start 0 */
+    { 0x3804, 0x08 }, { 0x3805, 0x1f }, /* x end 2079 */
+    { 0x3806, 0x06 }, { 0x3807, 0x0b }, /* y end 1547 */
+    { 0x3808, 0x01 }, { 0x3809, 0x40 }, /* output width 320 */
+    { 0x380a, 0x00 }, { 0x380b, 0xf0 }, /* output height 240 */
+    { 0x380c, 0x08 }, { 0x380d, 0xfc }, /* total width 2300 */
+    { 0x380e, 0x03 }, { 0x380f, 0x0f }, /* binned total height 783 */
+    { 0x3810, 0x00 }, { 0x3811, 0x08 }, /* ISP x offset 8 */
+    { 0x3812, 0x00 }, { 0x3813, 0x02 }, /* ISP y offset 2 */
+    { OV3660_TIMING20, 0x01 },          /* vertical binning */
+    { OV3660_TIMING21, 0x01 },          /* horizontal binning */
+    { 0x4514, 0xaa }, { 0x4520, 0x0b },
+    { OV3660_X_INCREMENT, 0x31 },
+    { OV3660_Y_INCREMENT, 0x31 },
+    { OV3660_FORMAT_CTRL, 0x01 },       /* RGB */
+    { OV3660_FORMAT_CTRL00, 0x61 },     /* Espressif RGB565 preset */
+    { OV3660_ISP_CTRL01, 0xa3 },        /* defaults 0x83 plus scale */
+    { OV3660_PLL_CTRL0, 0x00 },
+    { OV3660_PLL_CTRL1, 0x08 },
+    { OV3660_PLL_CTRL2, 0x11 },
+    { OV3660_PLL_CTRL3, 0x02 },         /* predivider 0, seld5 2 */
+    { OV3660_PCLK_RATIO, 0x04 },
+    { OV3660_VFIFO_CTRL0C, 0x22 },
+  };
+  unsigned int i;
+  int ret;
+
+  for (i = 0; i < sizeof(regs) / sizeof(regs[0]); i++)
+    {
+      ret = ov3660_write_reg(priv, regs[i].reg, regs[i].value);
+      if (ret < 0)
+        {
+          return ret;
+        }
+    }
+
+  return OK;
+}
+
+static int ov3660_init(struct imgsensor_s *sensor)
+{
+  struct ov3660_dev_s *priv = (struct ov3660_dev_s *)sensor;
+  int ret;
+  int cleanup;
+
+  priv->initialized = false;
+  priv->capture_active = false;
+  ret = ov3660_read_id(priv);
+
+  if (ret < 0)
+    {
+      if (ret == -ENODEV)
+        {
+          return ret;
+        }
+
+      goto fail;
+    }
+
+  ret = ov3660_write_reg(priv, OV3660_SYSTEM_CTRL0, 0x82);
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  up_mdelay(10);
+  ret = ov3660_write_defaults(priv);
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  ret = ov3660_configure_qvga_rgb565(priv);
+  if (ret < 0)
+    {
+      goto fail;
+    }
+
+  /* The upstream defaults table leaves the sensor's DVP output enabled.
+   * start/stop_capture only track logical V4L2 capture: NuttX may invoke
+   * stop_capture from the frame-completion ISR, where I2C is not safe.
+   */
+  priv->initialized = true;
+  return OK;
+
+fail:
+  cleanup = ov3660_write_reg(priv, OV3660_SYSTEM_CTRL0, 0x42);
+  (void)cleanup;
+
+  return ret;
+}
+
+static int ov3660_uninit(struct imgsensor_s *sensor)
+{
+  struct ov3660_dev_s *priv = (struct ov3660_dev_s *)sensor;
+  int ret;
+
+  ret = ov3660_write_reg(priv, OV3660_SYSTEM_CTRL0, 0x42);
+  if (ret == OK)
+    {
+      priv->initialized = false;
+      priv->capture_active = false;
+    }
+  return ret;
+}
+
+static const char *ov3660_get_driver_name(struct imgsensor_s *sensor)
+{
+  (void)sensor;
+  return "OV3660";
+}
