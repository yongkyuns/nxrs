+struct ov3660_reg_s
+{
+  uint16_t reg;
+  uint16_t value;
+};
+
+struct ov3660_dev_s
+{
+  struct imgsensor_s sensor;
+  struct i2c_master_s *i2c;
+  struct v4l2_frmsizeenum framesize;
+  struct v4l2_frmivalenum interval;
+  bool capture_active;
+  bool initialized;
+};
+
+static int ov3660_write_reg(struct ov3660_dev_s *priv,
+                            uint16_t reg, uint8_t value)
+{
+  struct i2c_msg_s msg;
+  uint8_t data[3] = { reg >> 8, reg & 0xff, value };
+
+  msg.frequency = CONFIG_OV3660_FREQUENCY;
+  msg.addr      = CONFIG_OV3660_I2CADDR;
+  msg.flags     = 0;
+  msg.buffer    = data;
+  msg.length    = sizeof(data);
+  return I2C_TRANSFER(priv->i2c, &msg, 1);
+}
+
+static int ov3660_read_reg(struct ov3660_dev_s *priv,
+                           uint16_t reg, uint8_t *value)
+{
+  struct i2c_msg_s msg[2];
+  uint8_t address[2] = { reg >> 8, reg & 0xff };
+  int ret;
+
+  msg[0].frequency = CONFIG_OV3660_FREQUENCY;
+  msg[0].addr      = CONFIG_OV3660_I2CADDR;
+  msg[0].flags     = I2C_M_NOSTOP;
+  msg[0].buffer    = address;
+  msg[0].length    = sizeof(address);
+  msg[1].frequency = CONFIG_OV3660_FREQUENCY;
+  msg[1].addr      = CONFIG_OV3660_I2CADDR;
+  msg[1].flags     = I2C_M_READ;
+  msg[1].buffer    = value;
+  msg[1].length    = 1;
+
+  ret = I2C_TRANSFER(priv->i2c, msg, 2);
+  return ret;
+}
+
+static int ov3660_read_id(struct ov3660_dev_s *priv)
+{
+  uint8_t high;
+  uint8_t low;
+  int ret;
+
+  ret = ov3660_read_reg(priv, OV3660_ID_HIGH, &high);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  ret = ov3660_read_reg(priv, OV3660_ID_LOW, &low);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  return ((uint16_t)high << 8 | low) == OV3660_ID ? OK : -ENODEV;
+}
+
+static bool ov3660_is_available(struct imgsensor_s *sensor)
+{
+  struct ov3660_dev_s *priv = (struct ov3660_dev_s *)sensor;
+  return ov3660_read_id(priv) == OK;
+}
