From: NXRS project maintainers
Subject: [PATCH] boards/arm/rp23xx: add Pico 2 W CYW43439 Wi-Fi wiring
X-Firmware-Source-Commit: 7e074b23c9efd50489ce04491dbc0b9aa90f1020
X-Board-Wiring-Reference: https://github.com/apache/nuttx/pull/19250
X-Backport-Note: Stages only the firmware helper and Pico 2 W wiring needed by this target; firmware path/length are supplied by the profile-driven preparation helper. GPIO25 is reserved for CYW CS, so both LED paths are disabled in radio mode.

Backport the RP23xx firmware staging support and the Pico 2 W board wiring
from the pending upstream board port. The CYW43439 shares the RP2350 PIO gSPI
data line for traffic and interrupt signaling. Board setup uses GPIO23 for
power, GPIO25 for chip select, GPIO24 for data/IRQ, and GPIO29 for clock.

The Raspberry Pi Pico 2 board's normal user LED is GPIO25, which is the radio
chip-select on Pico 2 W. Radio mode therefore prevents LED Kconfig selection,
skips early LED pin setup, and does not register the user LED driver.

The firmware input is intentionally not embedded or hardcoded in this patch.
The profile's radio-firmware selection lets the build helper validate and
stage the pinned cached image, then inject CYW43439_FIRMWARE_BIN_PATH and
CYW43439_FIRMWARE_LEN before configuration.

---
diff --git a/boards/arm/rp23xx/common/src/CMakeLists.txt b/boards/arm/rp23xx/common/src/CMakeLists.txt
index b56fd15..6a21d62 100644
--- a/boards/arm/rp23xx/common/src/CMakeLists.txt
+++ b/boards/arm/rp23xx/common/src/CMakeLists.txt
@@ -110,6 +110,33 @@ if(CONFIG_ARCH_BOARD_COMMON)
     list(APPEND SRCS rp23xx_max6675.c)
   endif()
 
+  if(CONFIG_IEEE80211_INFINEON_CYW43439)
+    list(APPEND SRCS rp23xx_firmware.c)
+
+    string(REPLACE "\"" "" CYW43439_FIRMWARE_SRC
+                   "${CONFIG_CYW43439_FIRMWARE_BIN_PATH}")
+    string(CONFIGURE "${CYW43439_FIRMWARE_SRC}" CYW43439_FIRMWARE_SRC)
+
+    set(CYW43439_FIRMWARE "${CMAKE_CURRENT_BINARY_DIR}/cyw43439.firmware.image")
+
+    if(EXISTS "${CYW43439_FIRMWARE_SRC}")
+      configure_file("${CYW43439_FIRMWARE_SRC}" "${CYW43439_FIRMWARE}"
+                     COPYONLY)
+    else()
+      message(FATAL_ERROR
+        "CYW43439 firmware not found at ${CYW43439_FIRMWARE_SRC}")
+    endif()
+
+    set_property(
+      SOURCE rp23xx_firmware.c
+      APPEND
+      PROPERTY INCLUDE_DIRECTORIES "${CMAKE_CURRENT_BINARY_DIR}")
+    set_property(
+      SOURCE rp23xx_firmware.c
+      APPEND
+      PROPERTY OBJECT_DEPENDS "${CYW43439_FIRMWARE}")
+  endif()
+
 endif()
 target_sources(board PRIVATE ${SRCS})
 target_compile_options(board PRIVATE ${RP23XXFLAGS})
diff --git a/boards/arm/rp23xx/common/src/Make.defs b/boards/arm/rp23xx/common/src/Make.defs
index 52b1244..abc1c84 100644
--- a/boards/arm/rp23xx/common/src/Make.defs
+++ b/boards/arm/rp23xx/common/src/Make.defs
@@ -110,6 +110,10 @@ ifeq ($(CONFIG_SENSORS_MAX6675),y)
  CSRCS += rp23xx_max6675.c
 endif
 
+ifeq ($(CONFIG_IEEE80211_INFINEON_CYW43439),y)
+ CSRCS += rp23xx_firmware.c
+endif
+
 DEPPATH += --dep-path src
 VPATH += :src
 CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)$(DELIM)arch$(DELIM)$(CONFIG_ARCH)$(DELIM)src$(DELIM)board$(DELIM)src
diff --git a/boards/arm/rp23xx/common/src/rp23xx_firmware.c b/boards/arm/rp23xx/common/src/rp23xx_firmware.c
new file mode 100644
index 0000000..5a8b242
--- /dev/null
+++ b/boards/arm/rp23xx/common/src/rp23xx_firmware.c
@@ -0,0 +1,164 @@
+/****************************************************************************
+ * boards/arm/rp23xx/common/src/rp23xx_firmware.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
