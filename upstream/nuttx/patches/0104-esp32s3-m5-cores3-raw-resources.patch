diff --git a/boards/xtensa/esp32s3/esp32s3-m5-cores3/src/esp32s3_boot.c b/boards/xtensa/esp32s3/esp32s3-m5-cores3/src/esp32s3_boot.c
new file mode 100644
--- /dev/null
+++ b/boards/xtensa/esp32s3/esp32s3-m5-cores3/src/esp32s3_boot.c
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+/* Board registration only; device protocols belong to Rust capability HALs. */
+#include <nuttx/config.h>
+#include <nuttx/board.h>
+#include <nuttx/arch.h>
+#include <arch/board/board.h>
+#include <nuttx/fs/fs.h>
+#include <syslog.h>
+#include "esp32s3_i2c.h"
+void esp32s3_board_initialize(void) {}
+#ifdef CONFIG_BOARD_LATE_INITIALIZE
+void board_late_initialize(void)
+{
+#ifdef CONFIG_I2C_DRIVER
+  int result = board_i2c_init();
+  if (result < 0) syslog(LOG_ERR, "CoreS3 I2C registration failed: %d\n", result);
+#endif
+#ifdef CONFIG_FS_PROCFS
+  int mounted = nx_mount(NULL, "/proc", "procfs", 0, NULL);
+  if (mounted < 0) syslog(LOG_ERR, "CoreS3 procfs mount failed: %d\n", mounted);
+#endif
+  /* Preserve PMIC/charger defaults. No optional display/audio rails or 5V
+   * output are enabled here; those require separate power qualification. */
+}
+#endif
+#ifdef CONFIG_BOARDCTL_RESET
+int board_reset(int status)
+{
+  (void)status;
+  up_systemreset();
+  return 0;
+}
+#endif
