+}
+
+static int spi_flash_read_erased_aware(uint32_t addr, void *dest, uint32_t size)
+{
+  int result;
+  uint32_t data[256 / sizeof(uint32_t)];
+  size_t head = (addr % 16);
+  addr = (addr / 16 * 16);
+  while (size != 0) {
+      size_t bytes = (size < sizeof(data) - head ? size : sizeof(data) - head) + head;
+      size_t aligned_size = ((bytes + 15) / 16 * 16);
+      uint32_t erased = 0;
+      if ((result = spi_flash_read(addr, data, aligned_size)) != ESP_OK) {
+          return result;
+      }
+      for (size_t i = 0; i < aligned_size / 16; i++) {
+          if ((data[4*i] & data[4*i+1] & data[4*i+2] & data[4*i+3]) == UINT32_MAX) {
+              erased |= 1U << i;
+          }
+      }
+      if (erased != ((1U << (aligned_size / 16)) - 1U) &&
+          (result = spi_flash_read_encrypted(addr, data, aligned_size)) != ESP_OK) {
+          return result;
+      }
+      for (size_t i = 0; i < aligned_size / 16; i++) {
+          if (erased & (1U << i)) {
+              memset((uint8_t *)data + 16*i, 0xff, 16);
+          }
+      }
+      memcpy(dest, (uint8_t *)data + head, bytes - head);
+      dest = (uint8_t *)dest + bytes - head;
+      size -= bytes - head;
+      addr += bytes;
+      head = 0;
+  }
+  return ESP_OK;
 }
 
