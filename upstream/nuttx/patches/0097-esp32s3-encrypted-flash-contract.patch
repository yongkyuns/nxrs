@@ -748,7 +767,75 @@
     }
 
   esp_flash_encryption->flash_encryption_disable();
-  return err;
+  if (err != ESP_OK)
+    {
+      return err;
+    }
+
+  /* Read hardware-decrypted bytes, not the erased-value-normalized MTD view.
+   * Otherwise a dropped write of all-0xff data could appear successful.
+   */
+
+  for (uint32_t offset = 0; offset < original_size; offset += sizeof(verify))
+    {
+      err = spi_flash_read(original_address + offset, verify, sizeof(verify));
+      if (err != ESP_OK)
