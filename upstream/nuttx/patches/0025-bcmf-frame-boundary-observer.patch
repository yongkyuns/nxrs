+
 /****************************************************************************
  * Pre-processor Definitions
  ****************************************************************************/
@@ -264,6 +268,15 @@ int bcmf_gspi_read_f2_frame(FAR struct bcmf_dev_s *priv, int frame_length)
 
       case F2_FRAME_DATA_CHANNEL:
 
+#ifdef CONFIG_IEEE80211_BROADCOM_FRAME_TRACE
+        if (header->size <= frame_length)
+          {
+            bcmf_bdc_trace_frame(priv, BCMF_TRACE_BUS_RX,
+                                 iframe->header.data,
+                                 header->size - header->data_offset, 0, NULL);
+          }
+#endif
+
         /* Queue frame and notify network layer frame is available */
 
         if (nxmutex_lock(&gbus->queue_lock) < 0)
@@ -317,6 +330,9 @@ int bcmf_gspi_send_f2_frame(FAR struct bcmf_dev_s *priv)
   FAR bcmf_interface_frame_t *iframe;
   int                         ret;
   bool                        is_txframe;
+#ifdef CONFIG_IEEE80211_BROADCOM_FRAME_TRACE
+  struct bcmf_trace_bus_s      trace_bus;
+#endif
 
   if (list_is_empty(&gbus->tx_queue))
     {
@@ -374,6 +390,15 @@ int bcmf_gspi_send_f2_frame(FAR struct bcmf_dev_s *priv)
 
   /* Write the frame data (the buffer is DMA aligned here) */
 
+#ifdef CONFIG_IEEE80211_BROADCOM_FRAME_TRACE
+  trace_bus.cached_ready = !!(gbus->trace_status &
+                              CYW_REG_STATUS_F2_RECEIVE_RDY);
+  trace_bus.sequence = header->sequence;
+  trace_bus.credit = gbus->max_seq;
+  trace_bus.ticket = ++gbus->trace_ticket;
+  gbus->trace_written = true;
+#endif
+
   ret = gspi->write(gspi,
                     true,
                     gspi_f2_dma,
@@ -383,6 +408,15 @@ int bcmf_gspi_send_f2_frame(FAR struct bcmf_dev_s *priv)
 
   /* Free frame buffer */
 
+#ifdef CONFIG_IEEE80211_BROADCOM_FRAME_TRACE
+  if ((header->channel & 0x0f) == F2_FRAME_DATA_CHANNEL)
+    {
+      bcmf_bdc_trace_frame(priv, BCMF_TRACE_BUS_TX, iframe->header.data,
+                           iframe->header.len -
+                             (iframe->header.data - iframe->header.base), ret,
+                           &trace_bus);
+    }
+#endif
   bcmf_interface_free_frame(priv, iframe);
 
   if (ret == OK && is_txframe)
