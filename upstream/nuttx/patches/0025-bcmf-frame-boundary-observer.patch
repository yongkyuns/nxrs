diff --git a/include/nuttx/wireless/ieee80211/bcmf_trace.h b/include/nuttx/wireless/ieee80211/bcmf_trace.h
new file mode 100644
index 0000000..4b3b76f
--- /dev/null
+++ b/include/nuttx/wireless/ieee80211/bcmf_trace.h
@@ -0,0 +1,92 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+#ifndef __INCLUDE_NUTTX_WIRELESS_IEEE80211_BCMF_TRACE_H
+#define __INCLUDE_NUTTX_WIRELESS_IEEE80211_BCMF_TRACE_H
+
+#include <nuttx/config.h>
+#include <nuttx/compiler.h>
+#include <stddef.h>
+#include <stdint.h>
+
+struct net_driver_s;
+
+enum bcmf_trace_stage_e
+{
+  BCMF_TRACE_NET_TX = 0, /* Ethernet frame entering the driver */
+  BCMF_TRACE_BUS_TX,     /* gSPI write returned; NOT an over-air ACK */
+  BCMF_TRACE_BUS_RX,     /* Valid gSPI data frame, before RX queue */
+  BCMF_TRACE_NET_RX,     /* Ethernet IPv4 frame entering the network stack */
+  BCMF_TRACE_STAGE_COUNT
+};
+
+struct bcmf_trace_bus_s
+{
+  uint32_t ticket;        /* Diagnostic write ID, independent of SDPCM wrap */
+  uint8_t cached_ready;   /* Last F2-ready bit before write, not a fresh read */
+  uint8_t sequence;       /* Assigned SDPCM sequence */
+  uint8_t credit;         /* Driver's credit limit before the write */
+};
+
+enum bcmf_trace_status_e
+{
+  BCMF_TRACE_STATUS_READY = 1u << 0,
+  BCMF_TRACE_STATUS_DATA_MISSING = 1u << 1,
+  BCMF_TRACE_STATUS_UNDERFLOW = 1u << 2,
+  BCMF_TRACE_STATUS_OVERFLOW = 1u << 3,
+  BCMF_TRACE_STATUS_COMMAND_ERROR = 1u << 4,
+  BCMF_TRACE_STATUS_PACKET_AVAILABLE = 1u << 5
+};
+
+struct bcmf_trace_counts_s
+{
+  int packet_result;
+  int retry_result;
+  uint16_t version;
+  uint16_t length;
+  uint32_t rx_good_pkt;
+  uint32_t rx_bad_pkt;
+  uint32_t tx_good_pkt;
+  uint32_t tx_bad_pkt;
+  uint32_t rx_ocast_good_pkt;
+  uint32_t txframe;
+  uint32_t txretrans;
+  uint32_t txretry;
+  uint32_t txretrie;
+  uint32_t txfail;
+};
+
+/* Optional synchronous observer, defaulting to a weak no-op. Data is an
+ * Ethernet frame borrowed only for the call. Result is the transport return
+ * value for BUS_TX and zero for other stages. Bus is a borrowed pre-write
+ * snapshot for BUS_TX, NULL otherwise. It adds no register reads. Callbacks
+ * can run with driver
+ * or network locks held: do not block, allocate, log, re-enter the driver,
+ * modify the frame or retain its pointer. Disabled builds have no call sites.
+ */
+
+#ifdef CONFIG_IEEE80211_BROADCOM_FRAME_TRACE
+void bcmf_trace_frame(FAR struct net_driver_s *dev,
+                      enum bcmf_trace_stage_e stage,
+                      FAR const uint8_t *data, size_t len, int result,
+                      FAR const struct bcmf_trace_bus_s *bus);
+
+/* The existing post-write register read, correlated by diagnostic ticket.
+ * Flags are meaningful only when read_result is zero. They are a bus-status
+ * observation, not proof of controller acceptance or an over-air ACK. The
+ * same nonblocking callback restrictions above apply.
+ */
+
+void bcmf_trace_status(FAR struct net_driver_s *dev, uint32_t ticket,
+                       int read_result, uint32_t flags);
+
+/* Task-context diagnostic only. Caller holds the network lock and keeps dev
+ * registered. Serializes with normal wireless ioctls; CDC's existing bounded
+ * wait applies. No reset or per-packet query. Individual query results must
+ * be checked before interpreting counters, which are firmware-global and
+ * sampled sequentially, not a per-packet delivery acknowledgement.
+ */
+
+int bcmf_trace_counters(FAR struct net_driver_s *dev,
+                        FAR struct bcmf_trace_counts_s *counts);
+#endif
+
+#endif
