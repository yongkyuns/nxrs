           /* If the above function invocation resulted in data that should be
@@ -940,6 +957,198 @@ static int bcmf_rmmac(FAR struct net_driver_s *dev, FAR const uint8_t *mac)
  *
  ****************************************************************************/
 
+#ifdef CONFIG_IEEE80211_BROADCOM_FRAME_TRACE
+static int bcmf_trace_decode_counts(FAR const uint8_t *data, size_t size,
+                                    FAR struct bcmf_trace_counts_s *counts)
+{
+  struct trace_layout_s
+  {
+    uint16_t version;
+    size_t size;
+    bool exact;
+    size_t fields[5];
+  };
+#define BCMF_TRACE_LAYOUT(v, t, e) {v, sizeof(t), e, \
+  {offsetof(t, txframe), offsetof(t, txretrans), offsetof(t, txretry), \
+   offsetof(t, txretrie), offsetof(t, txfail)}}
+  static const struct trace_layout_s layouts[] =
+  {
+    BCMF_TRACE_LAYOUT(6, wl_cnt_ver_six_t, true),
+    BCMF_TRACE_LAYOUT(7, wl_cnt_ver_seven_t, true),
+    BCMF_TRACE_LAYOUT(8, wl_cnt_ver_eight_t, true),
+    BCMF_TRACE_LAYOUT(10, struct bcmf_trace_cnt10_prefix_s, false)
+  };
+  static const struct trace_layout_s layout30 =
+    BCMF_TRACE_LAYOUT(30, struct bcmf_trace_cnt30_prefix_s, false);
+#undef BCMF_TRACE_LAYOUT
+  FAR const struct trace_layout_s *layout = NULL;
+  FAR const uint8_t *payload = data;
+  uint32_t values[5];
+  uint16_t header[2];
+
+  if (size < sizeof(header))
+    {
+      return -EPROTO;
+    }
+
+  memcpy(header, data, sizeof(header));
+  counts->version = le16toh(header[0]);
+  counts->length = le16toh(header[1]);
+  if (counts->version == 30)
+    {
+      size_t remaining = counts->length;
+      FAR const uint8_t *tuple = data + sizeof(header);
+
+      if (remaining > size - sizeof(header))
+        {
+          return -EPROTO;
+        }
+
+      while (remaining != 0)
+        {
+          size_t length;
+          size_t padded;
+
+          if (remaining < sizeof(header))
+            {
+              return -EPROTO;
+            }
+
+          memcpy(header, tuple, sizeof(header));
+          length = le16toh(header[1]);
+          padded = (sizeof(header) + length + 3) & ~(size_t)3;
+          if (padded > remaining)
+            {
+              return -EPROTO;
+            }
+
+          if (le16toh(header[0]) == BCMF_TRACE_COUNTER_XTLV)
+            {
+              if (layout != NULL || length < layout30.size)
+                {
+                  return -EPROTO;
+                }
+
+              layout = &layout30;
+              payload = tuple + sizeof(header);
+            }
+
+          tuple += padded;
+          remaining -= padded;
+        }
+
+      if (layout == NULL)
+        {
+          return -EPROTONOSUPPORT;
+        }
+    }
+  else
+    {
+      for (size_t i = 0; i < sizeof(layouts) / sizeof(layouts[0]); i++)
+        {
+          if (counts->version != layouts[i].version)
+            {
+              continue;
+            }
+
+          layout = &layouts[i];
+          if (counts->length > size || counts->length < layout->size ||
+              (layout->exact && counts->length != layout->size))
+            {
+              return -EPROTO;
+            }
+
+          break;
+        }
+    }
+
+  if (layout == NULL)
+    {
+      return -EPROTONOSUPPORT;
+    }
+
+  for (size_t j = 0; j < 5; j++)
+    {
+      memcpy(&values[j], payload + layout->fields[j], sizeof(values[j]));
+      values[j] = le32toh(values[j]);
+    }
+
+  counts->txframe = values[0];
+  counts->txretrans = values[1];
+  counts->txretry = values[2];
+  counts->txretrie = values[3];
+  counts->txfail = values[4];
+  return OK;
+}
+
+int bcmf_trace_counters(FAR struct net_driver_s *dev,
+                        FAR struct bcmf_trace_counts_s *counts)
+{
+  FAR struct bcmf_dev_s *priv;
+  get_pktcnt_t packets = {0};
+  uint8_t retries[BCMF_TRACE_COUNTER_BUFSIZE] = {0};
+  uint32_t size;
+  int result;
+
+  if (dev == NULL || counts == NULL)
+    {
+      return -EINVAL;
+    }
+
+  if (dev->d_ioctl != bcmf_ioctl || dev->d_private == NULL)
+    {
+      return -ENODEV;
+    }
+
+  priv = (FAR struct bcmf_dev_s *)dev->d_private;
+  result = nxmutex_lock(&priv->ioctl_mutex);
+  if (result < 0)
+    {
+      return result;
+    }
+
+  if (!priv->bc_bifup)
+    {
+      nxmutex_unlock(&priv->ioctl_mutex);
+      return -EPERM;
+    }
+
+#ifdef CONFIG_IEEE80211_BROADCOM_LOWPOWER
+  bcmf_lowpower_poll(priv);
+#endif
+  memset(counts, 0, sizeof(*counts));
+  size = sizeof(packets);
+  counts->packet_result = bcmf_cdc_ioctl(priv, 0, false, WLC_GET_PKTCNTS,
+                                         (FAR uint8_t *)&packets, &size);
+  if (counts->packet_result == OK && size != sizeof(packets))
+    {
+      counts->packet_result = -EPROTO;
+    }
+
+  if (counts->packet_result == OK)
+    {
+      counts->rx_good_pkt = le32toh(packets.rx_good_pkt);
+      counts->rx_bad_pkt = le32toh(packets.rx_bad_pkt);
+      counts->tx_good_pkt = le32toh(packets.tx_good_pkt);
+      counts->tx_bad_pkt = le32toh(packets.tx_bad_pkt);
+      counts->rx_ocast_good_pkt = le32toh(packets.rx_ocast_good_pkt);
+    }
+
+  size = sizeof(retries);
+  counts->retry_result = bcmf_cdc_iovar_request(priv, 0, false, "counters",
+                                               retries, &size);
+  if (counts->retry_result == OK)
+    {
+      counts->retry_result = size <= sizeof(retries) ?
+        bcmf_trace_decode_counts(retries, size, counts) :
+        -EPROTO;
+    }
+
+  nxmutex_unlock(&priv->ioctl_mutex);
+  return OK;
+}
+#endif
+
 #ifdef CONFIG_NETDEV_IOCTL
 static int bcmf_ioctl(FAR struct net_driver_s *dev, int cmd,
                       unsigned long arg)
