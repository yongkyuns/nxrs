diff --git a/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.c b/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.c
index 3e266b3..9d30229 100644
--- a/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.c
+++ b/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.c
@@ -93,6 +93,46 @@ extern const struct bcmf_chip_data g_cyw43439_config_data;
  *
  ****************************************************************************/
 
+#ifdef CONFIG_IEEE80211_BROADCOM_FRAME_TRACE
+/* Replaces (not supplements) the worker's existing post-send status read.
+ * A failed read is reported as unknown, never as verified zero status.
+ */
+
+static uint32_t bcmf_gspi_trace_status(FAR struct bcmf_dev_s *priv)
+{
+  FAR bcmf_gspi_dev_t *gbus = (FAR bcmf_gspi_dev_t *)priv->bus;
+  FAR gspi_dev_t *gspi = gbus->gspi;
+  uint32_t status = 0;
+  uint32_t flags = 0;
+  int result;
+
+  result = gspi->read(gspi, true, gspi_f0_bus, CYW_REG_STATUS,
+                      sizeof(status), &status);
+  if (result == OK)
+    {
+      flags = ((status & CYW_STATUS_F2_RECEIVE_RDY) ?
+                 BCMF_TRACE_STATUS_READY : 0) |
+              ((status & CYW_STATUS_DATA_NOT_AVAIL) ?
+                 BCMF_TRACE_STATUS_DATA_MISSING : 0) |
+              ((status & CYW_STATUS_FIFO_UNDERFLOW) ?
+                 BCMF_TRACE_STATUS_UNDERFLOW : 0) |
+              ((status & CYW_STATUS_FIFO_OVERFLOW) ?
+                 BCMF_TRACE_STATUS_OVERFLOW : 0) |
+              ((status & CYW_STATUS_CMD_DATA_ERROR) ?
+                 BCMF_TRACE_STATUS_COMMAND_ERROR : 0) |
+              ((status & CYW_STATUS_F2_PKT_AVAIL) ?
+                 BCMF_TRACE_STATUS_PACKET_AVAILABLE : 0);
+    }
+
+  if (gbus->trace_written)
+    {
+      bcmf_trace_status(&priv->bc_dev, gbus->trace_ticket, result, flags);
+    }
+
+  return status;
+}
+#endif
+
 static inline uint32_t bcmf_gspi_read_reg_32(FAR gspi_dev_t       *gspi,
                                              enum gspi_cmd_func_e  function,
                                              uint32_t              address)
@@ -499,9 +539,17 @@ static int bcmf_gspi_thread(int argc, FAR char **argv)
 
           do
             {
+#ifdef CONFIG_IEEE80211_BROADCOM_FRAME_TRACE
+              gbus->trace_status = status;
+              gbus->trace_written = false;
+#endif
               ret = bcmf_gspi_send_f2_frame(priv);
+#ifdef CONFIG_IEEE80211_BROADCOM_FRAME_TRACE
+              status = bcmf_gspi_trace_status(priv);
+#else
               status = bcmf_gspi_read_reg_32(gspi,
                                              gspi_f0_bus, CYW_REG_STATUS);
+#endif
             }
           while (ret == OK && (status & CYW_REG_STATUS_F2_RECEIVE_RDY));
 
