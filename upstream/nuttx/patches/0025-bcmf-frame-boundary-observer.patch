+#ifndef __DRIVERS_WIRELESS_IEEE80211_BCM43XXX_BCMF_TRACE_COUNTERS_H
+#define __DRIVERS_WIRELESS_IEEE80211_BCM43XXX_BCMF_TRACE_COUNTERS_H
+
+#include <stdint.h>
+
+/* Wire prefixes through txretrie, not complete counter structures.  Field
+ * order is from Infineon WHD whd_wlioctl.h (Apache-2.0), revision
+ * bd99da7b005c97500d7c697f544b36fabdaa3f5e, COMPONENT_WIFI6/src/include.
+ * Version 30 carries this prefix in a 32-bit-padded XTLV of type 0x100.
+ * The counters iovar requires at least 1636 reply bytes in that header.
+ */
+
+#define BCMF_TRACE_COUNTER_BUFSIZE 1636
+#define BCMF_TRACE_COUNTER_XTLV    0x100
+
+struct bcmf_trace_cnt30_prefix_s
+{
+  uint32_t txframe;
+  uint32_t txbyte;
+  uint32_t txretrans;
+  uint32_t txerror;
+  uint32_t txctl;
+  uint32_t txprshort;
+  uint32_t txserr;
+  uint32_t txnobuf;
+  uint32_t txnoassoc;
+  uint32_t txrunt;
+  uint32_t txchit;
+  uint32_t txcmiss;
+  uint32_t txuflo;
+  uint32_t txphyerr;
+  uint32_t txphycrs;
+  uint32_t rxframe;
+  uint32_t rxbyte;
+  uint32_t rxerror;
+  uint32_t rxctl;
+  uint32_t rxnobuf;
+  uint32_t rxnondata;
+  uint32_t rxbadds;
+  uint32_t rxbadcm;
+  uint32_t rxfragerr;
+  uint32_t rxrunt;
+  uint32_t rxgiant;
+  uint32_t rxnoscb;
+  uint32_t rxbadproto;
+  uint32_t rxbadsrcmac;
+  uint32_t rxbadda;
+  uint32_t rxfilter;
+  uint32_t rxoflo;
+  uint32_t rxuflo[6];
+  uint32_t d11cnt_txrts_off;
+  uint32_t d11cnt_rxcrc_off;
+  uint32_t d11cnt_txnocts_off;
+  uint32_t dmade;
+  uint32_t dmada;
+  uint32_t dmape;
