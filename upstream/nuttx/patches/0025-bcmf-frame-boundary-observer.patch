Subject: [PATCH] wireless/bcmf: optional frame-boundary observer

Add default-off Ethernet/gSPI observers and task-context controller counters.
Callbacks must not allocate, block, log, mutate or retain borrowed frame data.
Pre-write state and the existing post-write register read share a diagnostic
write ticket, independent of SDPCM sequence wrap; no extra SPI reads or retry
policy. Failed diagnostic status reads are reported, never verified as zero.
Controller counters validate native layouts, including version 10 prefixes
and bounded version 30 XTLVs. A fixed 1636-byte reply buffer follows WHD;
the SDPCM allocator remains responsible for configured frame capacity.
Counters are firmware-global, not per-packet delivery acknowledgements.
This is diagnostic instrumentation, not an upstream-accepted corrective API.

diff --git a/drivers/wireless/ieee80211/bcm43xxx/Kconfig b/drivers/wireless/ieee80211/bcm43xxx/Kconfig
index 0deb31f..e937f7c 100644
--- a/drivers/wireless/ieee80211/bcm43xxx/Kconfig
+++ b/drivers/wireless/ieee80211/bcm43xxx/Kconfig
@@ -12,6 +12,17 @@ config IEEE80211_BROADCOM_HAVE_CLM
 	bool
 	default n
 
+config IEEE80211_BROADCOM_FRAME_TRACE
+	bool "Broadcom FullMAC frame boundary observer"
+	depends on IEEE80211_BROADCOM_FULLMAC_GSPI && DEBUG_FEATURES && NETDEV_IOCTL
+	default n
+	---help---
+		Enable a synchronous, weak frame observer at Ethernet and gSPI
+		boundaries for local diagnostics. The default observer does nothing.
+		An override must not block, allocate, log or retain frame pointers.
+		A successful bus write does not mean the radio delivered the frame.
+		Disabled builds contain no observer calls or diagnostic storage.
+
 config IEEE80211_BROADCOM_BCM4301X
 	bool "Broadcom 4301x chip support"
 	depends on IEEE80211_BROADCOM_FULLMAC
diff --git a/drivers/wireless/ieee80211/bcm43xxx/bcmf_bdc.c b/drivers/wireless/ieee80211/bcm43xxx/bcmf_bdc.c
index 0f3e620..79a7bd1 100644
--- a/drivers/wireless/ieee80211/bcm43xxx/bcmf_bdc.c
+++ b/drivers/wireless/ieee80211/bcm43xxx/bcmf_bdc.c
@@ -110,6 +110,54 @@ struct bcmf_frame_s *bcmf_bdc_allocate_frame(FAR struct bcmf_dev_s *priv,
   return frame;
 }
 
+#ifdef CONFIG_IEEE80211_BROADCOM_FRAME_TRACE
+void weak_function bcmf_trace_frame(FAR struct net_driver_s *dev,
+                                    enum bcmf_trace_stage_e stage,
+                                    FAR const uint8_t *data, size_t len,
+                                    int result,
+                                    FAR const struct bcmf_trace_bus_s *bus)
+{
+  (void)dev;
+  (void)stage;
+  (void)data;
+  (void)len;
+  (void)result;
+  (void)bus;
+}
+
+void weak_function bcmf_trace_status(FAR struct net_driver_s *dev,
+                                     uint32_t ticket, int read_result,
+                                     uint32_t flags)
+{
+  (void)dev;
+  (void)ticket;
+  (void)read_result;
+  (void)flags;
+}
+
+void bcmf_bdc_trace_frame(FAR struct bcmf_dev_s *priv,
+                          enum bcmf_trace_stage_e stage,
+                          FAR const uint8_t *data, size_t len, int result,
+                          FAR const struct bcmf_trace_bus_s *bus)
+{
+  size_t offset;
+
+  if (len < sizeof(struct bcmf_bdc_header))
+    {
+      return;
+    }
+
+  offset = sizeof(struct bcmf_bdc_header) + (size_t)data[3] * 4;
+  if (offset > len)
+    {
+      return;
+    }
+
+  bcmf_trace_frame(&priv->bc_dev, stage, data + offset, len - offset, result,
+                   bus);
+}
+#endif
+
 int bcmf_bdc_process_event_frame(FAR struct bcmf_dev_s *priv,
                                  struct bcmf_frame_s *frame)
 {
