Subject: wireless/bcmf: read back bus configuration on shared-bus faults

In error-debug Bluetooth builds, distinguish bad shared-memory reads from
bus configuration faults. Read back the F1 response delay and compare the
SPI test pattern and hardware/cached backplane windows after invalid HCI
indices or frame metadata, or once per daemon FIFO error burst. Hold the
window mutex during the snapshot and report failed reads as unavailable.

These are failure-only reads, never a retry or repair. Do not reprogram
registers, advance ring pointers, clear HCI faults or change deadlines.
Suppress duplicate FIFO warnings within a burst so bounded RAM logs retain
the first-fault context. Rearm only after a valid healthy status read. Emit
only configuration numbers and comparisons, never addresses or contents.

diff --git a/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.c b/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.c
index eb94051..5e93d7f 100644
--- a/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.c
+++ b/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.c
@@ -143,6 +143,70 @@ static void bcmf_gspi_trace_status(FAR struct bcmf_dev_s *priv, bool post,
 }
 #endif
 
+#if defined(CONFIG_DEBUG_WIRELESS_ERROR) && \
+    defined(CONFIG_IEEE80211_INFINEON_CYW43439_BLUETOOTH)
+void bcmf_gspi_bus_diagnostics(FAR bcmf_gspi_dev_t *gbus)
+{
+  uint32_t pattern = 0;
+  uint32_t window = 0;
+  uint32_t cached = 0;
+  uint8_t low = 0;
+  uint8_t mid = 0;
+  uint8_t high = 0;
+  uint8_t delay = 0;
+  int ret;
+
+  /* Failure-only readback, not a retry or repair. Hold the window lock so
+   * the cached and hardware windows describe the same bus state.
+   */
+
+  ret = nxmutex_lock(&gbus->backplane_lock);
+  if (ret == OK)
+    {
+      cached = gbus->backplane_current_addr;
+      ret = bcmf_read_reg(gbus, 1, SBSDIO_FUNC1_SBADDRLOW, &low);
+      if (ret == OK)
+        {
+          ret = bcmf_read_reg(gbus, 1, SBSDIO_FUNC1_SBADDRMID, &mid);
+        }
+
+      if (ret == OK)
+        {
+          ret = bcmf_read_reg(gbus, 1, SBSDIO_FUNC1_SBADDRHIGH, &high);
+        }
+
+      if (ret == OK)
+        {
+          ret = bcmf_read_reg(gbus, 0, CYW_REG_RESP_DELAY_F1, &delay);
+        }
+
+      if (ret == OK)
+        {
+          ret = gbus->gspi->read(gbus->gspi, true, gspi_f0_bus,
+                                  CYW_REG_TEST_RO, 4, &pattern);
+          if (ret > 0)
+            {
+              ret = -EIO;
+            }
+        }
+
+      window = ((uint32_t)low << 8 | (uint32_t)mid << 16 |
+                (uint32_t)high << 24) & ~SBSDIO_SB_OFT_ADDR_MASK;
+      nxmutex_unlock(&gbus->backplane_lock);
+    }
+
+  /* Only numeric bus configuration and comparisons, no memory contents,
+   * addresses or peer identifiers. A nonzero result makes comparisons
+   * unavailable, not evidence that either register actually mismatched.
+   */
+
+  wlerr("BCMF GSPI bus diagnostics result=%d window_match=%u "
+        "delay=%u pattern_match=%u\n", ret,
+        ret == OK && window == cached, delay,
+        ret == OK && pattern == CYW_REG_TEST_RO_PATTERN);
+}
+#endif
+
 static inline int bcmf_gspi_check_result(int ret)
 {
   return ret > 0 ? -EIO : ret;
@@ -578,6 +642,10 @@ static int bcmf_gspi_thread(int argc, FAR char **argv)
   bool                   power_ready;
   bool                   bus_error;
   bool                   enter_low_power = false;
+#if defined(CONFIG_DEBUG_WIRELESS_ERROR) && \
+    defined(CONFIG_IEEE80211_INFINEON_CYW43439_BLUETOOTH)
+  bool                   fault_reported = false;
+#endif
 
   priv = (FAR struct bcmf_dev_s *)((uintptr_t)strtoul(argv[1], NULL, 16));
   gbus = (FAR bcmf_gspi_dev_t *)priv->bus;
@@ -627,14 +695,19 @@ static int bcmf_gspi_thread(int argc, FAR char **argv)
         }
 
 #ifdef CONFIG_DEBUG_WIRELESS_ERROR
-      if (status_valid && (status & (1 << 2)))
+#ifdef CONFIG_IEEE80211_INFINEON_CYW43439_BLUETOOTH
+      if (!fault_reported)
+#endif
         {
-          wlerr("CYW_REG_STATUS_FIFO_OVERFLOW\n");
-        }
+          if (status_valid && (status & (1 << 2)))
+            {
+              wlerr("CYW_REG_STATUS_FIFO_OVERFLOW\n");
+            }
 
-      if (status_valid && (status & (1 << 7)))
-        {
-          wlerr("CYW_REG_STATUS_CMD_DATA_ERROR\n");
+          if (status_valid && (status & (1 << 7)))
+            {
+              wlerr("CYW_REG_STATUS_CMD_DATA_ERROR\n");
+            }
         }
 #endif
 
@@ -643,6 +716,19 @@ static int bcmf_gspi_thread(int argc, FAR char **argv)
                              CYW_REG_STATUS_FIFO_OVERFLOW |
                              CYW_REG_STATUS_CMD_DATA_ERROR));
 
+#if defined(CONFIG_DEBUG_WIRELESS_ERROR) && \
+    defined(CONFIG_IEEE80211_INFINEON_CYW43439_BLUETOOTH)
+      if (bus_error && !fault_reported)
+        {
+          bcmf_gspi_bus_diagnostics(gbus);
+        }
+
+      if (status_valid)
+        {
+          fault_reported = bus_error;
+        }
+#endif
+
       /* A polled bus error also needs acknowledgement: a lost/masked IRQ
        * must not leave a sticky FIFO error waiting for another RX packet.
        */
diff --git a/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.h b/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.h
index d1047ec..634fa5c 100644
--- a/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.h
+++ b/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.h
@@ -128,6 +128,9 @@ int bcmf_gspi_initialize(FAR struct gspi_dev_s *gspi);
 int bcmf_gspi_bt_poll(FAR bcmf_gspi_dev_t *gbus);
 bool bcmf_gspi_bt_active(FAR bcmf_gspi_dev_t *gbus);
 int bcmf_gspi_bt_power(FAR bcmf_gspi_dev_t *gbus, bool active);
+#ifdef CONFIG_DEBUG_WIRELESS_ERROR
+void bcmf_gspi_bus_diagnostics(FAR bcmf_gspi_dev_t *gbus);
+#endif
 #endif
 
 int bcmf_bus_gspi_active(FAR struct bcmf_dev_s *priv,
diff --git a/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi_bt.c b/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi_bt.c
index e5cbe23..0bb52ac 100644
--- a/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi_bt.c
+++ b/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi_bt.c
@@ -334,6 +334,7 @@ static int bcmf_bt_firmware(FAR struct bcmf_bt_s *bt, bool upload)
   return -EINVAL;
 }
 
+
 static int bcmf_bt_indices(FAR struct bcmf_bt_s *bt, uint32_t offset,
                            FAR uint32_t *in, FAR uint32_t *out)
 {
@@ -350,6 +351,9 @@ static int bcmf_bt_indices(FAR struct bcmf_bt_s *bt, uint32_t offset,
       wlerr("CYW43439 HCI invalid indices rx=%u in=%lu out=%lu\n",
             offset == BCMF_BT_B2H_IN, (unsigned long)*in,
             (unsigned long)*out);
+#ifdef CONFIG_DEBUG_WIRELESS_ERROR
+      bcmf_gspi_bus_diagnostics(bt->gbus);
+#endif
       ret = -EPROTO;
     }
 
@@ -550,6 +554,9 @@ static int bcmf_bt_receive_one(FAR struct bcmf_bt_s *bt)
             frame[3] == 4 && len >= 2 ? (size_t)frame[5] + 2 :
             frame[3] == 2 && len >= 4 ?
               ((size_t)frame[6] | (size_t)frame[7] << 8) + 4 : 0);
+#ifdef CONFIG_DEBUG_WIRELESS_ERROR
+      bcmf_gspi_bus_diagnostics(bt->gbus);
+#endif
       return -EPROTO;
     }
 
