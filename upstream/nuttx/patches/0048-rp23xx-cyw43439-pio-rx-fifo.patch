Subject: arm/rp23xx: reject CYW43439 DMA reads from an empty PIO FIFO

A DMA completion interrupt does not validate its peripheral read: an empty
PIO RX FIFO read returns undefined data and sets RXUNDER, without necessarily
raising a DMA bus error. Clear the owned state machine's sticky flag before
each read and reject a transfer that sets it, preserving an earlier wait or
DMA error. Reuse the existing checked failure cleanup.

Do not reset request credits, retry commands or change deadlines. This guard
identifies invalid peripheral reads; it does not repair their pacing cause.

diff --git a/arch/arm/src/rp23xx/rp23xx_cyw43439.c b/arch/arm/src/rp23xx/rp23xx_cyw43439.c
--- a/arch/arm/src/rp23xx/rp23xx_cyw43439.c
+++ b/arch/arm/src/rp23xx/rp23xx_cyw43439.c
@@ -646,6 +646,8 @@
   int            ret;
   uint32_t       temp_word;
   uint32_t       bit_length;
+  uint32_t       rx_under = UINT32_C(1) <<
+                           (RP23XX_PIO_FDEBUG_RXUNDER_SHIFT + rp_io->pio_sm);
   uint32_t       command    = ((increment ? 1 : 0) << 30)
                             | ((function & 0x3)    << 28)
                             | ((address & 0x1ffff) << 11)
@@ -817,6 +819,11 @@
                        dma_complete,
                        &dma_info);
 
+  /* Attribute read-on-empty to this transfer, not an earlier transaction.
+   * This clears a sticky debug flag only; it does not flush or repair data.
+   */
+
+  putreg32(rx_under, RP23XX_PIO_FDEBUG(rp_io->pio));
   rp23xx_dmastart(ctrl_dma, NULL, NULL);
 
   /* Assert gpio_select by pulling line low */
@@ -836,6 +843,18 @@
       ret = -EIO;
     }
 
+  /* DMA completion alone cannot make an empty FIFO read valid. Such a read
+   * returns undefined data without necessarily raising a DMA bus error.
+   */
+
+  if ((getreg32(RP23XX_PIO_FDEBUG(rp_io->pio)) & rx_under) != 0)
+    {
+      if (ret == OK)
+        {
+          ret = -EIO;
+        }
+    }
+
   PRINT_GSPI(
     bcmf_hexdump((void *)buffer, length, (uint32_t)buffer);
   )
