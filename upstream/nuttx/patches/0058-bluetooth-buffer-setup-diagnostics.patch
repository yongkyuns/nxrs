Subject: bluetooth: defer setup diagnostics until disconnect

Keep first-occurrence setup records in a fixed, allocation-free buffer. Capture
native ticks under the same critical section as the seen mask, but do not format
or print these records on the connection-setup path. Snapshot at most eleven
records at disconnect and drain outside the critical section; a new connection
cannot overwrite the snapshot while it is being printed.

The existing opt-in link-event records are still immediate, so this reduces
rather than eliminates observer effects. Controller-global window semantics
remain unchanged: overlapping links can replace an unfinished window. An
unfinished window is not printed until its disconnect is handled. All storage
and hooks remain behind the existing default-off option. No controller policy,
packet contents, deadlines, error returns or retries change.

diff --git a/wireless/bluetooth/bt_hcicore.c b/wireless/bluetooth/bt_hcicore.c
--- a/wireless/bluetooth/bt_hcicore.c
+++ b/wireless/bluetooth/bt_hcicore.c
@@ -129,47 +129,93 @@
 #ifdef CONFIG_BLUETOOTH_LINK_TRACE
-static uint16_t g_setup_seen;
-static unsigned long g_setup_window;
-static bool g_setup_active;
-
-void bt_hci_setup_trace(enum bt_setup_stage_e stage, int value)
-{
-  irqstate_t flags;
-  unsigned long window;
-  unsigned long ticks;
-  uint16_t bit;
-
-  if ((unsigned int)stage > BT_SETUP_END)
-    {
-      return;
-    }
-
-  bit = (uint16_t)(1u << stage);
-  flags = enter_critical_section();
-  if (stage == BT_SETUP_BEGIN)
-    {
-      g_setup_seen = 0;
-      g_setup_window++;
-      g_setup_active = true;
-    }
-
-  if (!g_setup_active || (g_setup_seen & bit) != 0)
-    {
-      leave_critical_section(flags);
-      return;
-    }
-
-  g_setup_seen |= bit;
-  window = g_setup_window;
-  ticks = (unsigned long)clock_systime_ticks();
-  if (stage == BT_SETUP_END)
-    {
-      g_setup_active = false;
-    }
-
-  leave_critical_section(flags);
-  syslog(LOG_INFO, "BT_SETUP_EVENT window=%lu stage=%u value=%d "
-         "ticks=%lu tick_hz=%lu\n", window, (unsigned int)stage, value,
-         ticks, (unsigned long)TICK_PER_SEC);
-}
+struct bt_setup_record_s
+{
+  unsigned long ticks;
+  enum bt_setup_stage_e stage;
+  int value;
+};
+
+static uint16_t g_setup_seen;
+static unsigned long g_setup_window;
+static bool g_setup_active;
+static unsigned int g_setup_count;
+static struct bt_setup_record_s g_setup_records[BT_SETUP_END + 1];
+
+static void bt_setup_flush(int value)
+{
+  struct bt_setup_record_s records[BT_SETUP_END + 1];
+  irqstate_t flags;
+  unsigned long window;
+  unsigned int count;
+  unsigned int i;
+
+  flags = enter_critical_section();
+  if (!g_setup_active)
+    {
+      leave_critical_section(flags);
+      return;
+    }
+
+  g_setup_records[g_setup_count].ticks =
+    (unsigned long)clock_systime_ticks();
+  g_setup_records[g_setup_count].stage = BT_SETUP_END;
+  g_setup_records[g_setup_count++].value = value;
+  count = g_setup_count;
+  window = g_setup_window;
+  memcpy(records, g_setup_records, count * sizeof(records[0]));
+  g_setup_active = false;
+  leave_critical_section(flags);
+
+  /* A new window may start during output; drain only the private snapshot.
+   * The bounded stack copy is used only at disconnect, not for every packet.
+   */
+
+  for (i = 0; i < count; i++)
+    {
+      syslog(LOG_INFO, "BT_SETUP_EVENT window=%lu stage=%u value=%d "
+             "ticks=%lu tick_hz=%lu\n", window,
+             (unsigned int)records[i].stage, records[i].value,
+             records[i].ticks, (unsigned long)TICK_PER_SEC);
+    }
+}
+
+void bt_hci_setup_trace(enum bt_setup_stage_e stage, int value)
+{
+  irqstate_t flags;
+  uint16_t bit;
+
+  if ((unsigned int)stage > BT_SETUP_END)
+    {
+      return;
+    }
+
+  if (stage == BT_SETUP_END)
+    {
+      bt_setup_flush(value);
+      return;
+    }
+
+  bit = (uint16_t)(1u << stage);
+  flags = enter_critical_section();
+  if (stage == BT_SETUP_BEGIN)
+    {
+      g_setup_seen = 0;
+      g_setup_count = 0;
+      g_setup_window++;
+      g_setup_active = true;
+    }
+
+  if (!g_setup_active || (g_setup_seen & bit) != 0)
+    {
+      leave_critical_section(flags);
+      return;
+    }
+
+  g_setup_seen |= bit;
+  g_setup_records[g_setup_count].ticks =
+    (unsigned long)clock_systime_ticks();
+  g_setup_records[g_setup_count].stage = stage;
+  g_setup_records[g_setup_count++].value = value;
+  leave_critical_section(flags);
+}
 
 static void bt_setup_received(enum bt_buf_type_e type, FAR const void *data,
