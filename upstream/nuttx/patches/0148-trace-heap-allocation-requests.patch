+#ifdef CONFIG_MM_ALLOC_REQUEST_TRACE
+void sched_note_heap_request(FAR void *heap, uint64_t request_id,
+                             uint8_t operation, size_t size, FAR void *caller,
+                             FAR void *oldmem, size_t alignment)
+{
+  FAR struct note_driver_s **driver;
+  struct note_heap_request_s note;
+  bool formatted = false;
+  irqstate_t flags = up_irq_save();
+  FAR struct tcb_s *tcb = this_task();
+
+  /* Keep timestamp/append ordered against this CPU's IRQs without taking
+   * the scheduler global lock across a note-driver callback.
+   */
+
+  for (driver = g_note_drivers; *driver; driver++)
+    {
+      if (!note_isenabled(*driver) || (*driver)->ops->add == NULL)
+        {
+          continue;
+        }
+
+      if (!formatted)
+        {
+          formatted = true;
+          memset(&note, 0, sizeof(note));
+          note_common(tcb, &note.nhq_cmn, sizeof(note), NOTE_HEAP_REQUEST);
+          note.heap = heap;
+          note.caller = caller;
+          note.oldmem = oldmem;
+          note.size = size;
+          note.alignment = alignment;
+          note.request_id = request_id;
+          note.operation = operation;
+        }
+
+      note_add(*driver, &note, sizeof(note));
+    }
+
+  up_irq_restore(flags);
+}
+
+void sched_note_heap_result(FAR void *heap, uint64_t request_id,
+                            uint8_t operation, FAR void *result)
+{
+  FAR struct note_driver_s **driver;
+  struct note_heap_result_s note;
+  bool formatted = false;
+  irqstate_t flags = up_irq_save();
+  FAR struct tcb_s *tcb = this_task();
+
+  /* Keep timestamp/append ordered against this CPU's IRQs without taking
+   * the scheduler global lock across a note-driver callback.
+   */
+
+  for (driver = g_note_drivers; *driver; driver++)
+    {
+      if (!note_isenabled(*driver) || (*driver)->ops->add == NULL)
+        {
+          continue;
+        }
+
+      if (!formatted)
+        {
+          formatted = true;
+          memset(&note, 0, sizeof(note));
+          note_common(tcb, &note.nhr_cmn, sizeof(note), NOTE_HEAP_RESULT);
+          note.heap = heap;
+          note.result = result;
+          note.request_id = request_id;
+          note.operation = operation;
+        }
+
+      note_add(*driver, &note, sizeof(note));
+    }
+
+  up_irq_restore(flags);
+}
+#endif
