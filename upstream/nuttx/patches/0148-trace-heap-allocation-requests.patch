+#ifdef CONFIG_MM_ALLOC_REQUEST_TRACE
+uint64_t mm_request_begin(FAR struct mm_heap_s *heap, uint8_t operation,
+                          size_t size, FAR void *oldmem, size_t alignment,
+                          FAR void *caller)
+{
+  uint64_t request_id = 0;
+  irqstate_t flags;
+
+  /* Preserve the existing per-heap counter, including filtered calls. */
+
+  atomic64_add_relaxed(&heap->mm_alloc_requests, 1);
+
+  /* This bounded, non-instrumented section serializes only ID assignment.
+   * No allocator work or note-driver callback executes while it is held.
+   * Saturation disables correlated notes until the next boot.
+   */
+
+  flags = enter_critical_section_notrace();
+  if (g_mm_request_id != UINT64_MAX)
+    {
+      request_id = ++g_mm_request_id;
+    }
+
+  leave_critical_section_notrace(flags);
+
+  if (request_id != 0)
+    {
+      sched_note_heap_request(heap, request_id, operation, size, caller,
+                              oldmem, alignment);
+    }
+
+  return request_id;
+}
+
+FAR void *mm_request_end(FAR struct mm_heap_s *heap, uint64_t request_id,
+                         uint8_t operation, FAR void *result)
+{
+  if (request_id != 0)
+    {
+      sched_note_heap_result(heap, request_id, operation, result);
+    }
+
+  return result;
+}
+
+uint64_t mm_alloc_requests(FAR struct mm_heap_s *heap)
+{
+  return atomic64_read(&heap->mm_alloc_requests);
+}
+#endif
