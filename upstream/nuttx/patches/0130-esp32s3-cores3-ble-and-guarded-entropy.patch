-#ifdef CONFIG_ESPRESSIF_WIFI
+#if defined(CONFIG_ESPRESSIF_WIFI) || defined(CONFIG_ESPRESSIF_BLE)
 #  include "esp_private/phy.h"
 #endif
 
@@ -144,8 +144,8 @@
 static ssize_t esp32s3_trng_read(struct file *filep, char *buffer,
                                  size_t buflen)
 {
-#if defined(CONFIG_ESPRESSIF_WIFI) && !defined(CONFIG_ESPRESSIF_AUTO_SLEEP) && \
-    !defined(CONFIG_PM) && !defined(CONFIG_ESP32S3_AUTO_SLEEP)
+#if (defined(CONFIG_ESPRESSIF_WIFI) || defined(CONFIG_ESPRESSIF_BLE)) && \
+    !defined(CONFIG_ESPRESSIF_AUTO_SLEEP) && !defined(CONFIG_PM) && !defined(CONFIG_ESP32S3_AUTO_SLEEP)
   _lock_t lock;
   ssize_t ret = -EAGAIN;
 
@@ -166,7 +166,11 @@
    * Keep it through the last sample; do not take ownership of a modem bit.
    */
 
+#ifdef CONFIG_ESPRESSIF_WIFI
   if ((phy_get_modem_flag() & PHY_MODEM_WIFI) != 0)
+#else
+  if ((phy_get_modem_flag() & PHY_MODEM_BT) != 0)
+#endif
     {
       ret = MIN(buflen, 32);
       esp_fill_random(buffer, ret);
