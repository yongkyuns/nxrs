Subject: bluetooth: reclaim per-connection ACL transmit credits

Track ACL packets committed to the controller per connection. Return only
those outstanding credits on Number Of Completed Packets, and reclaim them
on the transition to Disconnected. The controller is allowed to flush those
packets without a completion event (Bluetooth Core, Vol 4, Part E, 4.3).
Without reclamation, reconnects can progressively exhaust the shared packet
semaphore and leave a connection transmit thread blocked.

Account before a possibly concurrent transport call, return a rejected send's
credit, and protect short state/counter updates without holding a critical
section across I/O. Clamp stale/excess completion counts, ignore unknown
handles and balance lookup references to avoid inventing controller credits.
No retry, larger buffer, timer or application deadline change is introduced.

https://www.bluetooth.com/wp-content/uploads/Files/Specification/HTML/Core-54/out/en/host-controller-interface/host-controller-interface-functional-specification.html

diff --git a/wireless/bluetooth/bt_conn.c b/wireless/bluetooth/bt_conn.c
index bab5b5e..8499253 100644
--- a/wireless/bluetooth/bt_conn.c
+++ b/wireless/bluetooth/bt_conn.c
@@ -51,6 +51,7 @@
 #include <nuttx/debug.h>
 
 #include <nuttx/kthread.h>
+#include <nuttx/irq.h>
 #include <nuttx/mm/iob.h>
 #include <nuttx/wireless/bluetooth/bt_hci.h>
 #include <nuttx/wireless/bluetooth/bt_core.h>
@@ -124,6 +125,30 @@ static void bt_conn_reset_rx_state(FAR struct bt_conn_s *conn)
   conn->rx_len = 0;
 }
 
+static void bt_conn_return_credits(uint16_t count)
+{
+  while (count-- > 0)
+    {
+      nxsem_post(&g_btdev.le_pkts_sem);
+    }
+}
+
+static bool bt_conn_reserve_tx(FAR struct bt_conn_s *conn)
+{
+  irqstate_t flags;
+  bool connected;
+
+  flags = enter_critical_section();
+  connected = conn->state == BT_CONN_CONNECTED;
+  if (connected)
+    {
+      conn->pending_pkts++;
+    }
+
+  leave_critical_section(flags);
+  return connected;
+}
+
 static int conn_tx_kthread(int argc, FAR char *argv[])
 {
   FAR struct bt_conn_s *conn;
@@ -174,7 +199,24 @@ static int conn_tx_kthread(int argc, FAR char *argv[])
         }
 
       wlinfo("passing buf %p len %u to driver\n", buf, buf->len);
-      bt_send(g_btdev.btdev, buf);
+      if (!bt_conn_reserve_tx(conn))
+        {
+          nxsem_post(&g_btdev.le_pkts_sem);
+          bt_buf_release(buf);
+          break;
+        }
+
+      /* Account before handing the packet to a concurrent transport.  Do
+       * not hold a critical section across a possibly blocking driver call.
+       */
+
+      ret = bt_send(g_btdev.btdev, buf);
+      if (ret < 0)
+        {
+          bt_conn_tx_complete(conn, 1);
+          wlerr("ACL transport send failed: %d\n", ret);
+        }
+
       bt_buf_release(buf);
     }
 
@@ -560,17 +602,28 @@ void bt_conn_set_state(FAR struct bt_conn_s *conn,
                        enum bt_conn_state_e state)
 {
   enum bt_conn_state_e old_state;
+  irqstate_t flags;
+  uint16_t pending = 0;
 
   wlinfo("%s -> %s\n", state2str(conn->state), state2str(state));
 
+  flags = enter_critical_section();
   if (conn->state == state)
     {
+      leave_critical_section(flags);
       wlwarn("no transition\n");
       return;
     }
 
   old_state   = conn->state;
   conn->state = state;
+  if (state == BT_CONN_DISCONNECTED)
+    {
+      pending = conn->pending_pkts;
+      conn->pending_pkts = 0;
+    }
+
+  leave_critical_section(flags);
 
   /* Take a reference for the first state transition after bt_conn_add() and
    * keep it until reaching DISCONNECTED again.
@@ -623,6 +676,12 @@ void bt_conn_set_state(FAR struct bt_conn_s *conn,
 
       case BT_CONN_DISCONNECTED:
 
+        /* Disconnection Complete flushes outstanding controller buffers;
+         * a Number Of Completed Packets event is not required for them.
+         */
+
+        bt_conn_return_credits(pending);
+
         /* Send dummy buffer to wake up and stop the Tx thread for states
