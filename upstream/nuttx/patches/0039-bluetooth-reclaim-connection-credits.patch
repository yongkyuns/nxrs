          */
@@ -795,19 +854,44 @@ FAR struct bt_conn_s *bt_conn_addref(FAR struct bt_conn_s *conn)
 }
 
 /****************************************************************************
- * Name: bt_conn_release
+ * Name: bt_conn_tx_complete
  *
  * Description:
- *   Decrement the reference count of a connection object.
+ *   Reclaim completed ACL credits without exceeding the tracked outstanding
+ *   count. Disconnection and a failed transport send may already reclaim them.
  *
  * Input Parameters:
- *   conn - Connection object.
+ *   conn  - Connection object.
+ *   count - Number of completed controller packets.
  *
  * Returned Value:
  *   None
  *
  ****************************************************************************/
 
+void bt_conn_tx_complete(FAR struct bt_conn_s *conn, uint16_t count)
+{
+  irqstate_t flags;
+
+  flags = enter_critical_section();
+  if (count > conn->pending_pkts)
+    {
+      count = conn->pending_pkts;
+    }
+
+  conn->pending_pkts -= count;
+  leave_critical_section(flags);
+  bt_conn_return_credits(count);
+}
+
+/****************************************************************************
+ * Name: bt_conn_release
+ *
+ * Description:
+ *   Decrement the reference count of a connection object.
+ *
+ ****************************************************************************/
+
 void bt_conn_release(FAR struct bt_conn_s *conn)
 {
   bt_atomic_t old_ref;
