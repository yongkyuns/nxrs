--- a/boards/xtensa/esp32s3/common/Kconfig
+++ b/boards/xtensa/esp32s3/common/Kconfig
@@ -85,6 +85,17 @@
 
 endchoice # ESP32S3_SPIFLASH_FS
 
+config ESP32S3_MAINTENANCE_VOLUME
+	bool "Mount the provisioned 64 KiB maintenance volume read-only"
+	default n
+	depends on ESP32S3_FLASH_16M && ESP32S3_SPIRAM
+	depends on ESP32S3_MTD && ESP32S3_HAVE_OTA_PARTITION
+	depends on !ESP32S3_OTA_PARTITION_ENCRYPT && !ESP32S3_PARTITION_TABLE
+	select FS_LITTLEFS
+	---help---
+		Use the reserved 0xf00000 region. Never format the volume on boot.
+		A missing volume does not prevent the application from starting.
+
 config ESP32S3_BOARD_I2C
 	bool
 	default y if ESP32S3_I2C0 || ESP32S3_I2C1
--- a/boards/xtensa/esp32s3/common/src/esp32s3_board_spiflash.c
+++ b/boards/xtensa/esp32s3/common/src/esp32s3_board_spiflash.c
@@ -472,5 +472,42 @@
       return ret;
     }
 
+#ifdef CONFIG_ESP32S3_MAINTENANCE_VOLUME
+  /* Keep this fixed board reservation outside all image and config areas. */
+
+#  define MAINTENANCE_OFFSET 0xf00000
+#  define MAINTENANCE_SIZE   0x10000
+#  if CONFIG_ESP32S3_OTA_PRIMARY_SLOT_OFFSET + CONFIG_ESP32S3_OTA_SLOT_SIZE > MAINTENANCE_OFFSET || \
+      CONFIG_ESP32S3_OTA_SECONDARY_SLOT_OFFSET + CONFIG_ESP32S3_OTA_SLOT_SIZE > MAINTENANCE_OFFSET || \
+      CONFIG_ESP32S3_OTA_SCRATCH_OFFSET + CONFIG_ESP32S3_OTA_SCRATCH_SIZE > MAINTENANCE_OFFSET || \
+      CONFIG_ESP32S3_STORAGE_MTD_OFFSET + CONFIG_ESP32S3_STORAGE_MTD_SIZE > MAINTENANCE_OFFSET
+#    error "Maintenance volume must follow all firmware and config partitions"
+#  endif
+
+  struct mtd_dev_s *maintenance =
+    esp32s3_spiflash_alloc_mtdpart(MAINTENANCE_OFFSET, MAINTENANCE_SIZE, false);
+
+  if (maintenance != NULL)
+    {
+      ret = register_mtddriver("/dev/maintenance", maintenance, 0400, NULL);
+      if (ret == OK)
+        {
+          ret = nx_mount("/dev/maintenance", "/mnt/ssh", "littlefs",
+                         MS_RDONLY, NULL);
+        }
+    }
+  else
+    {
+      ret = -ENOMEM;
+    }
+
+  if (ret < 0)
+    {
+      syslog(LOG_WARNING, "Maintenance volume unavailable: %d\n", ret);
+    }
+
+  ret = OK;
+#endif
+
   return ret;
 }
