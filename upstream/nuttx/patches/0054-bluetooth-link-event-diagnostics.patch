Subject: bluetooth: add opt-in numeric link-event diagnostics

Record the controller's connection parameters and disconnect reason at event
handling, with native tick timestamps. This distinguishes an on-device link
timeout from delayed host-console collection without logging peer addresses,
connection handles, keys or payloads. Emit only one record per connection event,
not per ACL packet; do not alter host/controller policy or retry anything.

Disabled by default. Timestamps wrap at unsigned-long width; tick_hz states
their units. Parameters are valid only for a successful connection event.

diff --git a/wireless/bluetooth/Kconfig b/wireless/bluetooth/Kconfig
--- a/wireless/bluetooth/Kconfig
+++ b/wireless/bluetooth/Kconfig
@@ -61,5 +61,14 @@ menuconfig WIRELESS_BLUETOOTH_HOST
 
 if WIRELESS_BLUETOOTH_HOST
+config BLUETOOTH_LINK_TRACE
+	bool "Numeric connection-event diagnostics"
+	default n
+	depends on SYSLOG
+	---help---
+		Log controller connection parameters and disconnect reasons with
+		native tick timestamps. Do not log peer identifiers or payloads.
+		This is optional diagnostic overhead, not a connection-policy change.
+
 config DEVICE_APPEARANCE
 	int "Appearance sub-category value"
 	default 0
diff --git a/wireless/bluetooth/bt_hcicore.c b/wireless/bluetooth/bt_hcicore.c
--- a/wireless/bluetooth/bt_hcicore.c
+++ b/wireless/bluetooth/bt_hcicore.c
@@ -52,6 +52,11 @@
 
 #include <nuttx/config.h>
 
+#ifdef CONFIG_BLUETOOTH_LINK_TRACE
+#  include <syslog.h>
+#  include <nuttx/clock.h>
+#endif
+
 #include <stdbool.h>
 #include <stdlib.h>
 #include <string.h>
@@ -672,5 +677,12 @@ static void hci_disconn_complete(FAR struct bt_buf_s *buf)
   FAR struct bt_conn_s *conn;
 
+#ifdef CONFIG_BLUETOOTH_LINK_TRACE
+  syslog(LOG_INFO, "BT_LINK_EVENT connected=0 status=%u reason=%u "
+         "ticks=%lu tick_hz=%lu\n", evt->status,
+         evt->status == 0 ? evt->reason : 0,
+         (unsigned long)clock_systime_ticks(), (unsigned long)TICK_PER_SEC);
+#endif
+
   wlinfo("status %u handle %u reason %u\n",
          evt->status, handle, evt->reason);
 
@@ -719,5 +731,15 @@ static void le_conn_complete(FAR struct bt_buf_s *buf)
   FAR struct bt_keys_s *keys;
 
+#ifdef CONFIG_BLUETOOTH_LINK_TRACE
+  syslog(LOG_INFO, "BT_LINK_EVENT connected=1 status=%u role=%u interval=%u "
+         "latency=%u timeout=%u ticks=%lu tick_hz=%lu\n", evt->status,
+         evt->status == 0 ? evt->role : 0,
+         evt->status == 0 ? BT_LE162HOST(evt->interval) : 0,
+         evt->status == 0 ? BT_LE162HOST(evt->latency) : 0,
+         evt->status == 0 ? BT_LE162HOST(evt->supv_timeout) : 0,
+         (unsigned long)clock_systime_ticks(), (unsigned long)TICK_PER_SEC);
+#endif
+
   wlinfo("status %u handle %u role %u %s\n", evt->status, handle,
          evt->role, bt_addr_le_str(&evt->peer_addr));
 
