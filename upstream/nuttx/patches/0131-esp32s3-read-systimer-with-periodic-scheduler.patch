 /****************************************************************************
  * Public Functions
  ****************************************************************************/
+
+/****************************************************************************
+ * Name: up_timer_gettime
+ *
+ * Description:
+ *   Read elapsed time from the counter used by the periodic system timer.
+ *
+ ****************************************************************************/
+
+#ifdef CONFIG_ESP32S3_SYSTIMER_CLOCK
+int up_timer_gettime(struct timespec *ts)
+{
+  uint32_t low;
+  uint32_t high;
+  uint64_t count;
+
+  modifyreg32(SYSTIMER_UNIT0_OP_REG, 0, SYSTIMER_TIMER_UNIT0_UPDATE);
+  while ((getreg32(SYSTIMER_UNIT0_OP_REG) &
+          SYSTIMER_TIMER_UNIT0_VALUE_VALID) == 0)
+    {
+    }
+
+  /* The radio can relatch this counter from the other CPU. */
+
+  do
+    {
+      low = getreg32(SYSTIMER_UNIT0_VALUE_LO_REG);
+      high = getreg32(SYSTIMER_UNIT0_VALUE_HI_REG);
+    }
+  while (low != getreg32(SYSTIMER_UNIT0_VALUE_LO_REG));
+
+  count = ((uint64_t)high << 32) | low;
+  ts->tv_sec = count / ESP32S3_SYSTIMER_TICKS_PER_SEC;
+  ts->tv_nsec = (count % ESP32S3_SYSTIMER_TICKS_PER_SEC) *
+                NSEC_PER_SEC / ESP32S3_SYSTIMER_TICKS_PER_SEC;
+  return OK;
+}
+#endif
 
