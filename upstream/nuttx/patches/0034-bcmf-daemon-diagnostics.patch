Subject: [PATCH] wireless/bcmf: observe existing GSPI daemon reads and wakes

Reuse the default-off diagnostic switch. Observe ISR notifications, existing
daemon status reads and semaphore wait entry/return. No added bus reads, wake
requests, polling, retries or scheduling-policy changes. Overrides obey the
nonblocking observer contract and may run in interrupt context. Status flags
and F2 length are valid only when the native read returned zero. Disabled
builds retain the original register-read and wait paths.

diff --git a/include/nuttx/wireless/ieee80211/bcmf_trace.h b/include/nuttx/wireless/ieee80211/bcmf_trace.h
--- a/include/nuttx/wireless/ieee80211/bcmf_trace.h
+++ b/include/nuttx/wireless/ieee80211/bcmf_trace.h
@@ -43,6 +43,14 @@ enum bcmf_trace_rx_e
   BCMF_TRACE_RX_COUNT
 };
 
+enum bcmf_trace_daemon_e
+{
+  BCMF_TRACE_DAEMON_IRQ = 0,
+  BCMF_TRACE_DAEMON_POLL,
+  BCMF_TRACE_DAEMON_WAIT,
+  BCMF_TRACE_DAEMON_WAKE
+};
+
 struct bcmf_trace_bus_s
 {
   uint32_t ticket;        /* Diagnostic write ID, independent of SDPCM wrap */
@@ -102,7 +110,17 @@ struct bcmf_trace_counts_s
 #ifdef CONFIG_IEEE80211_BROADCOM_FRAME_TRACE
 void bcmf_trace_rx(FAR struct net_driver_s *dev, enum bcmf_trace_rx_e event);
 #define BCMF_TRACE_RX(dev, event) bcmf_trace_rx(dev, event)
 
+/* ISR-safe observer. Flags/length describe an existing status read only for
+ * POLL with result == 0. Other events carry zero metadata. The frame-observer
+ * restrictions also apply here, including no driver re-entry or logging.
+ */
+
+void bcmf_trace_daemon(FAR struct net_driver_s *dev,
+                       enum bcmf_trace_daemon_e event, int result,
+                       uint32_t flags, uint32_t length);
+#define BCMF_TRACE_DAEMON(d, e, r, f, l) bcmf_trace_daemon(d, e, r, f, l)
+
 void bcmf_trace_frame(FAR struct net_driver_s *dev,
                       enum bcmf_trace_stage_e stage,
                       FAR const uint8_t *data, size_t len, int result,
@@ -142,6 +159,7 @@ int bcmf_trace_counters(FAR struct net_driver_s *dev,
                         FAR struct bcmf_trace_counts_s *counts);
 #else
 #define BCMF_TRACE_RX(dev, event) ((void)0)
+#define BCMF_TRACE_DAEMON(d, e, r, f, l) ((void)0)
 #endif
 
 #endif
diff --git a/drivers/wireless/ieee80211/bcm43xxx/bcmf_bdc.c b/drivers/wireless/ieee80211/bcm43xxx/bcmf_bdc.c
--- a/drivers/wireless/ieee80211/bcm43xxx/bcmf_bdc.c
+++ b/drivers/wireless/ieee80211/bcm43xxx/bcmf_bdc.c
@@ -112,5 +112,17 @@ struct bcmf_frame_s *bcmf_bdc_allocate_frame(FAR struct bcmf_dev_s *priv,
 
 #ifdef CONFIG_IEEE80211_BROADCOM_FRAME_TRACE
+void weak_function bcmf_trace_daemon(FAR struct net_driver_s *dev,
+                                     enum bcmf_trace_daemon_e event,
+                                     int result, uint32_t flags,
+                                     uint32_t length)
+{
+  (void)dev;
+  (void)event;
+  (void)result;
+  (void)flags;
+  (void)length;
+}
+
 void weak_function bcmf_trace_rx(FAR struct net_driver_s *dev,
                                  enum bcmf_trace_rx_e event)
 {
diff --git a/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.c b/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.c
--- a/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.c
+++ b/drivers/wireless/ieee80211/bcm43xxx/bcmf_gspi.c
@@ -100,12 +100,13 @@ extern const struct bcmf_chip_data g_cyw43439_config_data;
  * A failed read is reported as unknown, never as verified zero status.
  */
 
-static uint32_t bcmf_gspi_trace_status(FAR struct bcmf_dev_s *priv)
+static uint32_t bcmf_gspi_trace_read(FAR struct bcmf_dev_s *priv, bool post)
 {
   FAR bcmf_gspi_dev_t *gbus = (FAR bcmf_gspi_dev_t *)priv->bus;
   FAR gspi_dev_t *gspi = gbus->gspi;
   uint32_t status = 0;
   uint32_t flags = 0;
+  uint32_t length = 0;
   int result;
 
   result = gspi->read(gspi, true, gspi_f0_bus, CYW_REG_STATUS,
@@ -126,8 +128,15 @@ static uint32_t bcmf_gspi_trace_status(FAR struct bcmf_dev_s *priv)
               ((status & CYW_STATUS_F2_PKT_AVAIL) ?
                  BCMF_TRACE_STATUS_PACKET_AVAILABLE : 0);
+      if (status & CYW_REG_STATUS_F2_PKT_AVAIL)
+        {
+          length = (status & CYW_REG_STATUS_F2_PKT_LEN_MASK) >>
+                   CYW_REG_STATUS_F2_PKT_LEN_SHIFT;
+        }
     }
 
-  if (gbus->trace_written)
+  BCMF_TRACE_DAEMON(&priv->bc_dev, BCMF_TRACE_DAEMON_POLL,
+                     result, flags, length);
+  if (post && gbus->trace_written)
     {
       bcmf_trace_status(&priv->bc_dev, gbus->trace_ticket, result, flags);
     }
@@ -136,6 +145,11 @@ static uint32_t bcmf_gspi_trace_status(FAR struct bcmf_dev_s *priv)
 
   return status;
 }
+
+static uint32_t bcmf_gspi_trace_status(FAR struct bcmf_dev_s *priv)
+{
+  return bcmf_gspi_trace_read(priv, true);
+}
 #endif
 
 static inline uint32_t bcmf_gspi_read_reg_32(FAR gspi_dev_t       *gspi,
@@ -416,5 +430,7 @@ static int bcmf_gspi_thread_isr(int isr, FAR void *context, FAR void *arg)
   int                 semcount;
 
   gbus->irq_pending = true;
+  BCMF_TRACE_DAEMON(&gspi->priv->bc_dev, BCMF_TRACE_DAEMON_IRQ,
+                     0, 0, 0);
 
   nxsem_get_value(&gbus->thread_signal, &semcount);
@@ -469,6 +485,10 @@ static int bcmf_gspi_thread(int argc, FAR char **argv)
 
       /* Get the device status */
 
+#ifdef CONFIG_IEEE80211_BROADCOM_FRAME_TRACE
+      status = bcmf_gspi_trace_read(priv, false);
+#else
       status = bcmf_gspi_read_reg_32(gspi, gspi_f0_bus, CYW_REG_STATUS);
+#endif
 
 #ifdef CONFIG_DEBUG_WIRELESS_ERROR
@@ -587,5 +607,7 @@ static int bcmf_gspi_thread(int argc, FAR char **argv)
           /* Wait for event (device interrupt or user request) */
 
           gspi->interrupt_enable(gspi, true);
+          BCMF_TRACE_DAEMON(&priv->bc_dev, BCMF_TRACE_DAEMON_WAIT,
+                             0, 0, 0);
 
 #ifdef CONFIG_IEEE80211_INFINEON_CYW43439_BLUETOOTH
@@ -626,5 +648,7 @@ static int bcmf_gspi_thread(int argc, FAR char **argv)
                   enter_low_power = true;
                 }
             }
+          BCMF_TRACE_DAEMON(&priv->bc_dev, BCMF_TRACE_DAEMON_WAKE,
+                             0, 0, 0);
         }
     }
