- ****************************************************************************/
-
-#ifdef ESP_WLAN_HAS_STA
-
-/* Whether the station should reconnect after an unsolicited disconnection */
-
-extern volatile bool g_sta_reconnect;
-
-#endif /* ESP_WLAN_HAS_STA */
-
-/****************************************************************************
  * Public Function Prototypes
  ****************************************************************************/
 
@@ -284,14 +272,14 @@
  *   Trigger Wi-Fi station connection action.
  *
  * Input Parameters:
- *   None
- *
- * Returned Value:
- *   OK on success; Negated errno returned on failure.
- *
- ****************************************************************************/
-
-int esp_wifi_sta_connect(void);
+ *   retry - Reconnect only while explicit connection is enabled.
+ *
+ * Returned Value:
+ *   OK on success; Negated errno returned on failure.
+ *
+ ****************************************************************************/
+
+int esp_wifi_sta_connect(bool retry);
 
 /****************************************************************************
  * Name: esp_wifi_sta_disconnect
--- a/arch/xtensa/src/common/espressif/esp_wifi_event_handler.c
+++ b/arch/xtensa/src/common/espressif/esp_wifi_event_handler.c
@@ -103,12 +103,7 @@
   UNUSED(arg);
   int ret;
 
-  if (!g_sta_reconnect)
-    {
-      return;
-    }
-
-  ret = esp_wifi_sta_connect();
+  ret = esp_wifi_sta_connect(true);
   if (ret < 0)
     {
       wlerr("Failed to reconnect to Wi-Fi on callback\n");
@@ -205,11 +200,8 @@
 
           wlinfo("Wi-Fi station disconnected, reason: %u\n", reason);
           esp_wlan_sta_disconnect_hook();
-          if (g_sta_reconnect)
-            {
-              work_queue(LPWORK, &g_wifi_reconnect_work,
-                         esp_reconnect_work_cb, NULL, 0);
-            }
+          work_queue(LPWORK, &g_wifi_reconnect_work,
+                     esp_reconnect_work_cb, NULL, 0);
         }
         break;
 
--- a/arch/xtensa/src/common/espressif/esp_wlan_netdev.c
+++ b/arch/xtensa/src/common/espressif/esp_wlan_netdev.c
@@ -437,7 +437,7 @@
 
   if (priv->mode == IW_MODE_INFRA)
     {
-      ret = esp_wifi_sta_connect();
+      ret = esp_wifi_sta_connect(false);
       if (ret < 0)
         {
           wlerr("Failed to connect to Wi-Fi\n");
