+        if ((flags & TCP_ACKDATA) != 0 && conn->tx_unacked == 0)
           {
             conn->tcpstateflags = TCP_CLOSED;
             ninfo("TCP_LAST_ACK TCP state: TCP_CLOSED\n");
@@ -1749,7 +1749,7 @@
