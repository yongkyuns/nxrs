Subject: arm/rp23xx: add opt-in CYW43439 read observer hooks

Diagnostic only, disabled by default. A board test may supply passive input
capture callbacks around a serialized gSPI read. Begin runs before chip select
and clock generation; end runs after the native PIO is disabled, but before
releasing the bus lock. The callbacks must quiesce their own resources and must
not modify the transfer buffer, bus pins, result, or transaction policy.

This is instrumentation, not a transport fix. No hooks or references remain
when the option is off. Keeping the implementation in the test application
avoids introducing an unconditional logic-analyser driver or buffer.

diff --git a/boards/arm/rp23xx/raspberrypi-pico-2/Kconfig b/boards/arm/rp23xx/raspberrypi-pico-2/Kconfig
--- a/boards/arm/rp23xx/raspberrypi-pico-2/Kconfig
+++ b/boards/arm/rp23xx/raspberrypi-pico-2/Kconfig
@@ -23,6 +23,15 @@ endif
 
 if RP23XX_INFINEON_CYW43439
 
+config RP23XX_CYW43439_READ_OBSERVER
+	bool "Test-only CYW43439 read observer"
+	default n
+	depends on BUILD_FLAT
+	---help---
+		The diagnostic application must provide rp23xx_cyw_read_begin/end.
+		These hooks may passively capture a read using separate resources.
+		Do not enable in production or footprint/performance comparisons.
+
 config CYW43439_FIRMWARE_BIN_PATH
 	string "Path to Infineon 43439 firmware and CLM blob"
 	default "${PICO_SDK_PATH}/lib/cyw43-driver/firmware/43439A0-7.95.49.00.combined"
diff --git a/arch/arm/src/rp23xx/rp23xx_cyw43439.h b/arch/arm/src/rp23xx/rp23xx_cyw43439.h
--- a/arch/arm/src/rp23xx/rp23xx_cyw43439.h
+++ b/arch/arm/src/rp23xx/rp23xx_cyw43439.h
@@ -78,6 +78,17 @@ typedef struct rp23xx_gspi_s
  * Public Function Prototypes
  ****************************************************************************/
 
+#ifdef CONFIG_RP23XX_CYW43439_READ_OBSERVER
+/* Called with the bus lock held, outside critical sections. wire_command is
+ * the exact word supplied to the native TX FIFO, including byte reordering.
+ */
+
+void rp23xx_cyw_read_begin(const rp23xx_gspi_t *io, unsigned int function,
+                           uint32_t address, uint16_t length,
+                           uint32_t wire_command);
+void rp23xx_cyw_read_end(const uint32_t *buffer, int result);
+#endif
+
 /****************************************************************************
  * Name: rp23xx_cyw_setup
  *
diff --git a/arch/arm/src/rp23xx/rp23xx_cyw43439.c b/arch/arm/src/rp23xx/rp23xx_cyw43439.c
--- a/arch/arm/src/rp23xx/rp23xx_cyw43439.c
+++ b/arch/arm/src/rp23xx/rp23xx_cyw43439.c
@@ -837,6 +837,10 @@ static int my_read(struct gspi_dev_s   *gspi,
 
   rp23xx_dmastart(ctrl_dma, NULL, NULL);
 
+#ifdef CONFIG_RP23XX_CYW43439_READ_OBSERVER
+  rp23xx_cyw_read_begin(rp_io, function, address, length, command);
+#endif
+
   /* Assert gpio_select by pulling line low */
 
   rp23xx_gpio_put(rp_io->gpio_select, false);
@@ -916,6 +921,10 @@ static int my_read(struct gspi_dev_s   *gspi,
 
   rp23xx_pio_sm_set_enabled(rp_io->pio, rp_io->pio_sm, false);
 
+#ifdef CONFIG_RP23XX_CYW43439_READ_OBSERVER
+  rp23xx_cyw_read_end(buffer, ret);
+#endif
+
   /* At this point the data pin is input so it should have been
    * pulled high by rp23xx's gpio pullup.
    */
