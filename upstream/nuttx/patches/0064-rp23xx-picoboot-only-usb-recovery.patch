Subject: [PATCH] rp23xx: make MSD-free USB recovery opt-in

Make disabling the ROM's mass-storage interface an opt-in policy for the
explicitly enabled USB CDC 1200-baud recovery trigger. The ROM's normal MSD
behavior remains the default. Keep ordinary board reset status 3 on the ROM's
default BOOTSEL path so manual UF2 entry remains available.

diff --git a/arch/arm/src/rp23xx/Kconfig b/arch/arm/src/rp23xx/Kconfig
--- a/arch/arm/src/rp23xx/Kconfig
+++ b/arch/arm/src/rp23xx/Kconfig
@@ -5,6 +5,15 @@
 
 comment "RP23XX Configuration Options"
 
+config RP23XX_USB_BOOTSEL_DISABLE_MSD
+	bool "Disable the BOOTSEL mass-storage interface for USB recovery"
+	default n
+	depends on BOARD_USBDEV_BOOTLOADER
+	---help---
+		When entering BOOTSEL through the configured USB recovery hook,
+		disable the ROM mass-storage interface while retaining PicoBoot.
+		This does not affect the normal board reset BOOTSEL path.
+
 config RP23XX_RP2350B
 	bool "Use RP2350B variant (QFN-80)"
 	default n
diff --git a/boards/arm/rp23xx/common/src/rp23xx_reset.c b/boards/arm/rp23xx/common/src/rp23xx_reset.c
--- a/boards/arm/rp23xx/common/src/rp23xx_reset.c
+++ b/boards/arm/rp23xx/common/src/rp23xx_reset.c
@@ -42,7 +42,7 @@
-static void rp23xx_bootloader(void)
+static void rp23xx_bootloader(uint32_t flags)
 {
   rom_reboot_fn reboot = (rom_reboot_fn)rom_func_lookup(ROM_FUNC_REBOOT);
 
   reboot(REBOOT2_FLAG_REBOOT_TYPE_BOOTSEL |
-         REBOOT2_FLAG_NO_RETURN_ON_SUCCESS, 10, 0, 0);
+         REBOOT2_FLAG_NO_RETURN_ON_SUCCESS, 10, flags, 0);
 }
@@ -50,6 +50,10 @@
 #ifdef CONFIG_BOARD_USBDEV_BOOTLOADER
 void board_usbdev_bootloader(void)
 {
-  rp23xx_bootloader();
+#ifdef CONFIG_RP23XX_USB_BOOTSEL_DISABLE_MSD
+  rp23xx_bootloader(BOOTSEL_FLAG_DISABLE_MSD_INTERFACE);
+#else
+  rp23xx_bootloader(0);
+#endif
 }
 #endif
@@ -82,6 +86,6 @@
   if (status == 3)
     {
-      rp23xx_bootloader();
+      rp23xx_bootloader(0);
     }
   else
     {
