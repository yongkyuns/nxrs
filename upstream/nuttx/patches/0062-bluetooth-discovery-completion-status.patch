+      /* Handles and record order must stay inside the requested range. */
 
-      if (!handle)
+      if (!handle || handle < params->start_handle ||
+          handle > params->end_handle || handle <= previous_handle ||
+          value.value_handle <= handle || value.value_handle > params->end_handle)
         {
+          params->result = BT_ATT_ERR_INVALID_PDU;
           goto done;
         }
+      previous_handle = handle;
 
       /* Convert characteristic data, bt_gatt_chrc and gatt_chrc_s have
@@ -815,5 +850,1 @@ static void att_read_type_rsp(FAR struct bt_conn_s *conn, uint8_t err,
