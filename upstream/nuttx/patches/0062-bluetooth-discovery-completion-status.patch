   if (err)
     {
+      params->result = err;
       goto done;
     }
 
+  params->result = 0;
+  if (pdu == NULL)
+    {
+      params->result = BT_ATT_ERR_INVALID_PDU;
+      goto done;
+    }
+
   /* Parse attributes found */
 
   if (length == 0)
     {
+      params->result = BT_ATT_ERR_INVALID_PDU;
       goto done;
     }
@@ -674,5 +682,6 @@ static void att_find_type_rsp(FAR struct bt_conn_s *conn, uint8_t err,
       if (start_handle < params->start_handle || end_handle < start_handle ||
           end_handle > params->end_handle)
         {
+          params->result = BT_ATT_ERR_INVALID_PDU;
           goto done;
         }
@@ -693,4 +702,5 @@ static void att_find_type_rsp(FAR struct bt_conn_s *conn, uint8_t err,
   if (length > 0)
     {
+      params->result = BT_ATT_ERR_INVALID_PDU;
       goto done;
     }
@@ -711,7 +721,9 @@ static void att_find_type_rsp(FAR struct bt_conn_s *conn, uint8_t err,
   params->start_handle = end_handle + 1;
-  if (!bt_gatt_discover(conn, params))
+  if (bt_gatt_discover(conn, params) == 0)
     {
       return;
     }
+
+  params->result = BT_ATT_ERR_UNLIKELY;
 
 done:
@@ -768,4 +768,5 @@ static void att_read_type_rsp(FAR struct bt_conn_s *conn, uint8_t err,
   struct bt_gatt_chrc_s value;
   uint16_t handle = 0;
+  uint16_t previous_handle = 0;
 
   wlinfo("err 0x%02x\n", err);
