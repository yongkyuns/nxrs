   for (length--, pdu = rsp->data; length >= rsp->len;
@@ -802,10 +829,18 @@ static void att_read_type_rsp(FAR struct bt_conn_s *conn, uint8_t err,
       handle = BT_LE162HOST(data->handle);
 
