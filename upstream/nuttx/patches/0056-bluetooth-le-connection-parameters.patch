Subject: [PATCH] Bluetooth: allow callers to supply LE connection timing

Keep the existing create API and timing defaults. Validate the HCI ranges
and supervision inequality before allocating/scanning, and copy the requested
parameters into the connection. Use those values when the existing scan
path submits LE Create Connection. No board-specific policy or feature flag.

--- a/wireless/bluetooth/bt_conn.h
+++ b/wireless/bluetooth/bt_conn.h
@@ -75,6 +75,16 @@
   BT_CONN_AUTO_CONNECT,
 };
 
+/* LE connection timing, in HCI units (Core Vol 4, Part E, 7.8.12). */
+
+struct bt_le_conn_param_s
+{
+  uint16_t interval_min;       /* 1.25 ms, 6..3200 */
+  uint16_t interval_max;       /* 1.25 ms, interval_min..3200 */
+  uint16_t latency;            /* Skipped events, 0..499 */
+  uint16_t timeout;            /* 10 ms, 10..3200; exceeds twice latency span */
+};
+
 struct bt_conn_s
 {
   uint16_t handle;
@@ -103,6 +113,7 @@
   FAR void *att;
   FAR void *smp;
 
+  struct bt_le_conn_param_s le_create_param;
-  uint8_t le_conn_interval;
+  uint16_t le_conn_interval;
   enum bt_security_e sec_level;
   bt_atomic_t ref;
@@ -387,6 +398,26 @@
 FAR struct bt_conn_s *bt_conn_create_le(FAR const bt_addr_le_t *peer);
 
 /****************************************************************************
+ * Name: bt_conn_create_le_with_params
+ *
+ * Description:
+ *   Initiate an LE link with validated, caller-supplied timing. Parameters are
+ *   copied before scanning starts. Existing connections are returned with a
+ *   new reference, without changing their parameters. The caller owns the
+ *   returned reference, as with bt_conn_create_le().
+ *
+ * Input Parameters:
+ *   peer  - Remote peer address.
+ *   param - HCI connection timing, including the supervision inequality.
+ *
+ * Returned Value:
+ *   Connection reference, or NULL for invalid parameters/unavailable state.
+ ****************************************************************************/
+
+FAR struct bt_conn_s *bt_conn_create_le_with_params(
+  FAR const bt_addr_le_t *peer, FAR const struct bt_le_conn_param_s *param);
+
+/****************************************************************************
  * Name: bt_conn_le_start_encryption
  *
  * Description:
--- a/wireless/bluetooth/bt_conn.c
+++ b/wireless/bluetooth/bt_conn.c
@@ -78,6 +78,11 @@
  * Private Data
  ****************************************************************************/
 
+static const struct bt_le_conn_param_s g_default_le_param =
+{
+  0x0018, 0x0028, 0, 0x07d0
+};
+
 static struct bt_conn_s g_conns[CONFIG_BLUETOOTH_MAX_CONN];
 static struct bt_conn_handoff_s g_conn_handoff =
 {
@@ -577,6 +582,7 @@
 
   bt_atomic_set(&conn->ref, 1);
   conn->role = role;
+  conn->le_create_param = g_default_le_param;
   bt_addr_le_copy(&conn->dst, peer);
 
   return conn;
@@ -1096,7 +1102,34 @@
 
 FAR struct bt_conn_s *bt_conn_create_le(FAR const bt_addr_le_t *peer)
 {
+  return bt_conn_create_le_with_params(peer, &g_default_le_param);
+}
+
+/* Supervision timeout (10 ms) must exceed twice the maximum interval
+ * (1.25 ms) times (latency + 1). Use 32-bit arithmetic before multiplying.
+ */
+
+static bool le_conn_param_valid(FAR const struct bt_le_conn_param_s *param)
+{
+  return param != NULL &&
+         param->interval_min >= 6 &&
+         param->interval_min <= param->interval_max &&
+         param->interval_max <= 3200 &&
+         param->latency <= 499 &&
+         param->timeout >= 10 && param->timeout <= 3200 &&
+         (uint32_t)param->timeout * 4 >
+         ((uint32_t)param->latency + 1) * param->interval_max;
+}
+
+FAR struct bt_conn_s *bt_conn_create_le_with_params(
+  FAR const bt_addr_le_t *peer, FAR const struct bt_le_conn_param_s *param)
+{
   FAR struct bt_conn_s *conn;
+
+  if (peer == NULL || !le_conn_param_valid(param))
+    {
+      return NULL;
+    }
 
   /* First check if this connection exists and that it is in a proper
    * state.
@@ -1128,6 +1161,7 @@
       return NULL;
     }
 
+  conn->le_create_param = *param;
   bt_conn_set_state(conn, BT_CONN_CONNECT_SCAN);
   bt_le_scan_update();
   return conn;
--- a/wireless/bluetooth/bt_hcicore.c
+++ b/wireless/bluetooth/bt_hcicore.c
@@ -646,7 +646,8 @@
   return ret;
 }
 
-static int hci_le_create_conn(FAR const bt_addr_le_t *addr)
+static int hci_le_create_conn(FAR const bt_addr_le_t *addr,
+                              FAR const struct bt_le_conn_param_s *param)
 {
   FAR struct bt_buf_s *buf;
   FAR struct bt_hci_cp_le_create_conn_s *cp;
@@ -661,11 +662,12 @@
   cp                      = bt_buf_extend(buf, sizeof(*cp));
   memset(cp, 0x0, sizeof(*cp));
   bt_addr_le_copy(&cp->peer_addr, addr);
-  cp->conn_interval_max   = BT_HOST2LE16(0x0028);
-  cp->conn_interval_min   = BT_HOST2LE16(0x0018);
+  cp->conn_interval_max   = BT_HOST2LE16(param->interval_max);
+  cp->conn_interval_min   = BT_HOST2LE16(param->interval_min);
+  cp->conn_latency        = BT_HOST2LE16(param->latency);
   cp->scan_interval       = BT_HOST2LE16(0x0060);
   cp->scan_window         = BT_HOST2LE16(0x0030);
-  cp->supervision_timeout = BT_HOST2LE16(0x07d0);
+  cp->supervision_timeout = BT_HOST2LE16(param->timeout);
 
   return bt_hci_cmd_send_sync(BT_HCI_OP_LE_CREATE_CONN, buf, NULL);
 }
@@ -842,7 +844,7 @@
       goto done;
     }
 
-  if (hci_le_create_conn(addr))
+  if (hci_le_create_conn(addr, &conn->le_create_param))
     {
       goto done;
     }
