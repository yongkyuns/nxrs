Subject: arm/rp23xx: preserve CYW43439 DMA lifetime across interrupted waits

Do not configure shared PIO after a failed mutex acquisition. Allocate DMA
channels only while owning the bus and unwind partial allocation failures.
Wait uninterruptibly for DMA completion so an ordinary signal cannot release
a live channel or report an untouched receive buffer as successfully filled.
Propagate other wait failures and normalize DMA errors to negative errno.

On failure, stop PIO, disable both chained DMA channels before aborting, and
retire the control channel before the transfer channel. Keep completion IRQs
masked across abort/release and semaphore destruction so callbacks cannot
outlive their stack storage. Restore the shared data pin to input on failure.
Use an unsigned command-bit literal so bit31 construction is defined in C.
Do not retry bus commands, change transfer framing or alter deadlines.

diff --git a/arch/arm/src/rp23xx/rp23xx_cyw43439.c b/arch/arm/src/rp23xx/rp23xx_cyw43439.c
index c6bb021..0201119 100644
--- a/arch/arm/src/rp23xx/rp23xx_cyw43439.c
+++ b/arch/arm/src/rp23xx/rp23xx_cyw43439.c
@@ -413,8 +413,10 @@ static int my_write(struct gspi_dev_s   *gspi,
 {
   rp23xx_gspi_t *rp_io      = (rp23xx_gspi_t *)(gspi->io_dev);
   dma_info_t         dma_info;
-  DMA_HANDLE         xfer_dma   = rp23xx_dmachannel();
-  uint32_t           command    =    (0x1                  << 31)
+  DMA_HANDLE         xfer_dma;
+  irqstate_t         flags;
+  int                ret;
+  uint32_t           command    =    (UINT32_C(1)           << 31)
                                    | ((increment ? 1 : 0)  << 30)
                                    | ((function & 0x3)     << 28)
                                    | ((address  & 0x1ffff) << 11)
@@ -440,7 +442,18 @@ static int my_write(struct gspi_dev_s   *gspi,
 
   /* Claim the exclusive lock */
 
-  nxmutex_lock(&gspi->lock);
+  ret = nxmutex_lock(&gspi->lock);
+  if (ret < 0)
+    {
+      return ret;
+    }
+
+  xfer_dma = rp23xx_dmachannel();
+  if (xfer_dma == NULL)
+    {
+      nxmutex_unlock(&gspi->lock);
+      return -ENOMEM;
+    }
 
   /* Reset the PIO state machine just to be sure. */
 
@@ -544,7 +557,11 @@ static int my_write(struct gspi_dev_s   *gspi,
 
   /* Wait for transfer to complete */
 
-  nxsem_wait(&dma_info.sem);
+  ret = nxsem_wait_uninterruptible(&dma_info.sem);
+  if (ret == OK && dma_info.status != 0)
+    {
+      ret = -EIO;
+    }
 
   /* At this point all the data has been queued but my not have all been
    * sent.  We know that the PIO program will make the data line an input
@@ -555,14 +572,30 @@ static int my_write(struct gspi_dev_s   *gspi,
    * the two carry the same value.
    */
 
-  while (getreg32(RP23XX_IO_BANK0_GPIO_STATUS(rp_io->gpio_data))
-                  & RP23XX_IO_BANK0_GPIO_STATUS_OETOPAD)
+  while (ret == OK &&
+         (getreg32(RP23XX_IO_BANK0_GPIO_STATUS(rp_io->gpio_data)) &
+          RP23XX_IO_BANK0_GPIO_STATUS_OETOPAD) != 0)
     {
       /* Just busy wait -- testing indicates a worst case of
        * 20 loops (100 instructions).
        */
     }
 
+  /* Retire aborted DMA and its callback before destroying stack storage.
+   * Keep completion IRQs masked until the channel is released.
+   */
+
+  flags = enter_critical_section();
+  if (ret < 0)
+    {
+      rp23xx_pio_sm_set_enabled(rp_io->pio, rp_io->pio_sm, false);
+      putreg32(0, rp23xx_dma_register(xfer_dma,
+                                      RP23XX_DMA_CTRL_TRIG_OFFSET));
+      rp23xx_dmastop(xfer_dma);
+      rp23xx_pio_sm_set_pindirs_with_mask(rp_io->pio, rp_io->pio_sm, 0,
+                                          1 << rp_io->gpio_data);
+    }
+
   /* Un-assert select by pulling line high. */
 
   UP_DMB();
@@ -572,6 +605,7 @@ static int my_write(struct gspi_dev_s   *gspi,
 
   rp23xx_dmafree(xfer_dma);
   nxsem_destroy(&dma_info.sem);
+  leave_critical_section(flags);
 
   /* Disable the PIO */
 
@@ -586,7 +620,7 @@ static int my_write(struct gspi_dev_s   *gspi,
   /* Release the exclusive lock */
 
   nxmutex_unlock(&gspi->lock);
-  return dma_info.status;
+  return ret;
 }
 
