diff --git a/llvm/test/CodeGen/Xtensa/mixed-widening-multiply.ll b/llvm/test/CodeGen/Xtensa/mixed-widening-multiply.ll
new file mode 100644
--- /dev/null
+++ b/llvm/test/CodeGen/Xtensa/mixed-widening-multiply.ll
@@ -0,0 +1,67 @@
+; RUN: llc -mtriple=xtensa -mcpu=esp32s3 -verify-machineinstrs < %s | FileCheck %s
+; RUN: llc -mtriple=xtensa -mcpu=esp32 -verify-machineinstrs < %s | FileCheck %s
+; RUN: llc -mtriple=xtensa -mcpu=esp32s3 -filetype=obj -verify-machineinstrs < %s -o %t.s3.o
+; RUN: llc -mtriple=xtensa -mcpu=esp32 -filetype=obj -verify-machineinstrs < %s -o %t.esp32.o
+; RUN: llc -mtriple=xtensa -mcpu=esp32s3 -mattr=-mul32high -filetype=obj -verify-machineinstrs < %s -o %t.fallback.o
+
+; Each product needs one low and one unsigned high multiply. Correct the high
+; word by subtracting (signed_operand >> 31) & unsigned_operand, not another
+; multiply. Check the operand roles in both orientations, and return both words.
+define i64 @signed_unsigned(i32 %signed, i32 %unsigned) {
+; CHECK-LABEL: signed_unsigned:
+; CHECK: entry a1, 32
+; CHECK-DAG: srai [[SIGN:a[0-9]+]], a2, 31
+; CHECK-DAG: muluh [[HIGH:a[0-9]+]], a2, a3
+; CHECK-NEXT: and [[SIGN]], [[SIGN]], a3
+; CHECK-NEXT: sub [[HIGH]], [[HIGH]], [[SIGN]]
+; CHECK-NEXT: mull a2, a2, a3
+; CHECK-NEXT: mov.n a3, [[HIGH]]
+; CHECK-NEXT: retw.n
+  %s = sext i32 %signed to i64
+  %u = zext i32 %unsigned to i64
+  %r = mul i64 %s, %u
+  ret i64 %r
+}
+
+define i64 @unsigned_signed(i32 %unsigned, i32 %signed) {
+; CHECK-LABEL: unsigned_signed:
+; CHECK: entry a1, 32
+; CHECK-DAG: srai [[RSIGN:a[0-9]+]], a3, 31
+; CHECK-DAG: muluh [[RHIGH:a[0-9]+]], a2, a3
+; CHECK-NEXT: and [[RSIGN]], [[RSIGN]], a2
+; CHECK-NEXT: sub [[RHIGH]], [[RHIGH]], [[RSIGN]]
+; CHECK-NEXT: mull a2, a2, a3
+; CHECK-NEXT: mov.n a3, [[RHIGH]]
+; CHECK-NEXT: retw.n
+  %u = zext i32 %unsigned to i64
+  %s = sext i32 %signed to i64
+  %r = mul i64 %u, %s
+  ret i64 %r
+}
+
+; Existing same-signedness widening paths must remain available.
+define i64 @signed_signed(i32 %a, i32 %b) {
+; CHECK-LABEL: signed_signed:
+; CHECK: entry a1, 32
+; CHECK-NEXT: mull [[LOW:a[0-9]+]], a2, a3
+; CHECK-NEXT: mulsh a3, a2, a3
+; CHECK-NEXT: mov.n a2, [[LOW]]
+; CHECK-NEXT: retw.n
+  %aw = sext i32 %a to i64
+  %bw = sext i32 %b to i64
+  %r = mul i64 %aw, %bw
+  ret i64 %r
+}
+
+define i64 @unsigned_unsigned(i32 %a, i32 %b) {
+; CHECK-LABEL: unsigned_unsigned:
+; CHECK: entry a1, 32
+; CHECK-NEXT: mull [[ULOW:a[0-9]+]], a2, a3
+; CHECK-NEXT: muluh a3, a2, a3
+; CHECK-NEXT: mov.n a2, [[ULOW]]
+; CHECK-NEXT: retw.n
+  %aw = zext i32 %a to i64
+  %bw = zext i32 %b to i64
+  %r = mul i64 %aw, %bw
+  ret i64 %r
+}
