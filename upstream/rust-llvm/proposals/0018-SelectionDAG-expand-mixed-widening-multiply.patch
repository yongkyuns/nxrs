Subject: [PATCH RFC 18/18] SelectionDAG: expand mixed signed/unsigned widening multiply

For a sign-extended half-width operand multiplied by a zero-extended one,
compute the unsigned low/high product and subtract the unsigned operand
masked by the signed operand's sign from the high word. This avoids an
extra multiplication for the sign correction. Handle both operand orders.

Keep this scalar MUL optimization inside the existing capability-gated
expander; no target flags or application workarounds are introduced.
Test operand roles, return words, same-signedness controls and the fallback
without hardware high multiply. Refresh affected x86 overflow checks.

Apply after the frozen seventeen-patch hardening RFC chain.

---
diff --git a/llvm/lib/CodeGen/SelectionDAG/TargetLowering.cpp b/llvm/lib/CodeGen/SelectionDAG/TargetLowering.cpp
--- a/llvm/lib/CodeGen/SelectionDAG/TargetLowering.cpp
+++ b/llvm/lib/CodeGen/SelectionDAG/TargetLowering.cpp
@@ -7683,6 +7683,29 @@
     }
   }
 
+  if (!VT.isVector() && Opcode == ISD::MUL) {
+    // A signed half-width value times an unsigned half-width value fits in
+    // the full signed result. Use an unsigned high product and subtract the
+    // unsigned operand when the signed operand is negative.
+    bool LSign = DAG.ComputeMaxSignificantBits(LHS) <= InnerBitSize;
+    bool RSign = DAG.ComputeMaxSignificantBits(RHS) <= InnerBitSize;
+    bool LZero = DAG.MaskedValueIsZero(LHS, HighMask);
+    bool RZero = DAG.MaskedValueIsZero(RHS, HighMask);
+    if (((LSign && RZero) || (RSign && LZero)) &&
+        MakeMUL_LOHI(LL, RL, Lo, Hi, false)) {
+      SDValue SignedLo = LSign && RZero ? LL : RL;
+      SDValue UnsignedLo = LSign && RZero ? RL : LL;
+      SDValue Sign = DAG.getNode(
+          ISD::SRA, dl, HiLoVT, SignedLo,
+          DAG.getShiftAmountConstant(InnerBitSize - 1, HiLoVT, dl));
+      Hi = DAG.getNode(ISD::SUB, dl, HiLoVT, Hi,
+                       DAG.getNode(ISD::AND, dl, HiLoVT, Sign, UnsignedLo));
+      Result.push_back(Lo);
+      Result.push_back(Hi);
+      return true;
+    }
+  }
+
   unsigned ShiftAmount = OuterBitSize - InnerBitSize;
   SDValue Shift = DAG.getShiftAmountConstant(ShiftAmount, VT, dl);
 
