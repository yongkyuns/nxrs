Subject: [PATCH RFC] Xtensa: select native in-register sign extension

Use the existing SEXT instruction for scalar i8/i16 SIGN_EXTEND_INREG on
subtargets advertising HasSEXT. Previously these nodes were expanded to two
shifts even when the instruction was available. Keep i1/i32 and unsupported
subtargets on their existing expansion. Predicate both instruction patterns
and operation legality; test arbitrary upper bits, signed divide/remainder,
and signed loads with and without the capability. No application changes.

Apply after the signed-overflow evaluation chain.

---
diff --git a/llvm/lib/Target/Xtensa/XtensaISelLowering.cpp b/llvm/lib/Target/Xtensa/XtensaISelLowering.cpp
--- a/llvm/lib/Target/Xtensa/XtensaISelLowering.cpp
+++ b/llvm/lib/Target/Xtensa/XtensaISelLowering.cpp
@@ -284,8 +284,10 @@
   setOperationAction(ISD::UMUL_LOHI, MVT::i64, Expand);
 
   setOperationAction(ISD::SIGN_EXTEND_INREG, MVT::i1, Expand);
-  setOperationAction(ISD::SIGN_EXTEND_INREG, MVT::i8, Expand);
-  setOperationAction(ISD::SIGN_EXTEND_INREG, MVT::i16, Expand);
+  setOperationAction(ISD::SIGN_EXTEND_INREG, MVT::i8,
+                     Subtarget.hasSEXT() ? Legal : Expand);
+  setOperationAction(ISD::SIGN_EXTEND_INREG, MVT::i16,
+                     Subtarget.hasSEXT() ? Legal : Expand);
   setOperationAction(ISD::SIGN_EXTEND_INREG, MVT::i32, Expand);
 
   // Handle floating-point types.
diff --git a/llvm/lib/Target/Xtensa/XtensaInstrInfo.td b/llvm/lib/Target/Xtensa/XtensaInstrInfo.td
--- a/llvm/lib/Target/Xtensa/XtensaInstrInfo.td
+++ b/llvm/lib/Target/Xtensa/XtensaInstrInfo.td
@@ -1677,6 +1677,11 @@
   let t = imm;
 }
 
+let Predicates = [HasSEXT] in {
+  def : Pat<(sext_inreg AR:$src, i8), (SEXT AR:$src, 7)>;
+  def : Pat<(sext_inreg AR:$src, i16), (SEXT AR:$src, 15)>;
+}
+
 //===----------------------------------------------------------------------===//
 // CLAMPS Instructions
 //===----------------------------------------------------------------------===//
diff --git a/llvm/test/CodeGen/Xtensa/load.ll b/llvm/test/CodeGen/Xtensa/load.ll
--- a/llvm/test/CodeGen/Xtensa/load.ll
+++ b/llvm/test/CodeGen/Xtensa/load.ll
@@ -1,12 +1,17 @@
-; NOTE: Assertions have been autogenerated by utils/update_llc_test_checks.py UTC_ARGS: --version 5
-; RUN: llc --mtriple=xtensa < %s | FileCheck %s
+; RUN: llc -mtriple=xtensa -mcpu=generic -mattr=-sext -verify-machineinstrs < %s | FileCheck %s --check-prefix=BASE
+; RUN: llc -mtriple=xtensa -mcpu=generic -mattr=+sext -verify-machineinstrs < %s | FileCheck %s --check-prefix=SEXT
+; RUN: llc -mtriple=xtensa -mcpu=esp32s3 -verify-machineinstrs -filetype=obj < %s -o %t
 
 define signext i8 @test_load_i8(ptr %p){
-; CHECK-LABEL: test_load_i8:
-; CHECK:         l8ui a8, a2, 0
-; CHECK-NEXT:    slli a8, a8, 24
-; CHECK-NEXT:    srai a2, a8, 24
-; CHECK-NEXT:    ret
+; BASE-LABEL: test_load_i8:
+; BASE:         l8ui a8, a2, 0
+; BASE-NEXT:    slli a8, a8, 24
+; BASE-NEXT:    srai a2, a8, 24
+; BASE-NEXT:    ret
+; SEXT-LABEL: test_load_i8:
+; SEXT:         l8ui a8, a2, 0
+; SEXT-NEXT:    sext a2, a8, 7
+; SEXT-NEXT:    ret
   %1 = load i8, ptr %p, align 1
   ret i8 %1
 }
diff --git a/llvm/test/CodeGen/Xtensa/sign-extend-inreg.ll b/llvm/test/CodeGen/Xtensa/sign-extend-inreg.ll
new file mode 100644
--- /dev/null
+++ b/llvm/test/CodeGen/Xtensa/sign-extend-inreg.ll
@@ -0,0 +1,92 @@
+; RUN: llc -mtriple=xtensa -mcpu=generic -mattr=+sext,+div32 -verify-machineinstrs < %s | FileCheck %s --check-prefix=SEXT
+; RUN: llc -mtriple=xtensa -mcpu=generic -mattr=-sext,+div32 -verify-machineinstrs < %s | FileCheck %s --check-prefix=BASE
+; RUN: llc -mtriple=xtensa -mcpu=esp32s3 -verify-machineinstrs -filetype=obj < %s -o %t
+
+; The input has arbitrary upper bits.  Truncation followed by extension must
+; sign-extend only the low 8 or 16 bits.
+define i32 @sign_extend_i8_inreg(i32 %x) nounwind {
+; SEXT-LABEL: sign_extend_i8_inreg:
+; SEXT:       sext {{.*}}, {{.*}}, 7
+; SEXT-NOT:   slli
+; SEXT-NOT:   srai
+; BASE-LABEL: sign_extend_i8_inreg:
+; BASE:       slli {{.*}}, {{.*}}, 24
+; BASE:       srai {{.*}}, {{.*}}, 24
+  %narrow = trunc i32 %x to i8
+  %extended = sext i8 %narrow to i32
+  ret i32 %extended
+}
+
+define i32 @sign_extend_i16_inreg(i32 %x) nounwind {
+; SEXT-LABEL: sign_extend_i16_inreg:
+; SEXT:       sext {{.*}}, {{.*}}, 15
+; SEXT-NOT:   slli
+; SEXT-NOT:   srai
+; BASE-LABEL: sign_extend_i16_inreg:
+; BASE:       slli {{.*}}, {{.*}}, 16
+; BASE:       srai {{.*}}, {{.*}}, 16
+  %narrow = trunc i32 %x to i16
+  %extended = sext i16 %narrow to i32
+  ret i32 %extended
+}
+
+define i32 @sdiv_i8_operands(i32 %a, i32 %b) nounwind {
+; SEXT-LABEL: sdiv_i8_operands:
+; SEXT:       sext
+; SEXT:       sext
+; SEXT:       quos
+; BASE-LABEL: sdiv_i8_operands:
+; BASE:       slli
+; BASE:       srai
+; BASE:       slli
+; BASE:       srai
+; BASE:       quos
+  %a8 = trunc i32 %a to i8
+  %b8 = trunc i32 %b to i8
+  %as = sext i8 %a8 to i32
+  %bs = sext i8 %b8 to i32
+  %q = sdiv i32 %as, %bs
+  ret i32 %q
+}
+
+define i32 @srem_i16_operands(i32 %a, i32 %b) nounwind {
+; SEXT-LABEL: srem_i16_operands:
+; SEXT:       sext
+; SEXT:       sext
+; SEXT:       rems
+; BASE-LABEL: srem_i16_operands:
+; BASE:       slli
+; BASE:       srai
+; BASE:       slli
+; BASE:       srai
+; BASE:       rems
+  %a16 = trunc i32 %a to i16
+  %b16 = trunc i32 %b to i16
+  %as = sext i16 %a16 to i32
+  %bs = sext i16 %b16 to i32
+  %r = srem i32 %as, %bs
+  ret i32 %r
+}
+
+; Widths outside the instruction's supported i8/i16 patterns stay unchanged.
+define i32 @sign_extend_i1_inreg(i32 %x) {
+; SEXT-LABEL: sign_extend_i1_inreg:
+; SEXT-NOT: sext
+; SEXT: ret
+; BASE-LABEL: sign_extend_i1_inreg:
+; BASE-NOT: sext
+; BASE: ret
+  %n = trunc i32 %x to i1
+  %r = sext i1 %n to i32
+  ret i32 %r
+}
+
+define i32 @sign_extend_i32_inreg(i32 %x) {
+; SEXT-LABEL: sign_extend_i32_inreg:
+; SEXT-NOT: sext
+; SEXT: ret
+; BASE-LABEL: sign_extend_i32_inreg:
+; BASE-NOT: sext
+; BASE: ret
+  ret i32 %x
+}
