diff --git a/llvm/test/CodeGen/Xtensa/bit-test-branch.ll b/llvm/test/CodeGen/Xtensa/bit-test-branch.ll
new file mode 100644
--- /dev/null
+++ b/llvm/test/CodeGen/Xtensa/bit-test-branch.ll
@@ -0,0 +1,194 @@
+; RUN: llc -mtriple=xtensa -mcpu=generic -disable-block-placement -verify-machineinstrs < %s | FileCheck %s --check-prefix=CHECK
+; RUN: llc -mtriple=xtensa -mcpu=esp32 -disable-block-placement -verify-machineinstrs < %s | FileCheck %s --check-prefix=CHECK
+; RUN: llc -mtriple=xtensa -mcpu=esp32s3 -disable-block-placement -verify-machineinstrs < %s | FileCheck %s --check-prefix=CHECK
+; RUN: llc -mtriple=xtensa -mcpu=generic -verify-machineinstrs -filetype=obj -o /dev/null %s
+; RUN: llc -mtriple=xtensa -mcpu=esp32 -verify-machineinstrs -filetype=obj -o /dev/null %s
+; RUN: llc -mtriple=xtensa -mcpu=esp32s3 -verify-machineinstrs -filetype=obj -o /dev/null %s
+
+; A single-bit mask used only by a branch is selected as BBCI/BBSI. Keep the
+; false block next in layout so the emitted condition has the source polarity.
+define i32 @eq_bit0(i32 %x) {
+; CHECK-LABEL: eq_bit0:
+; CHECK:       bbci {{a[0-9]+}}, 0,
+  %masked = and i32 %x, 1
+  %test = icmp eq i32 %masked, 0
+  br i1 %test, label %set, label %clear
+clear:
+  ret i32 0
+set:
+  ret i32 1
+}
+
+define i32 @ne_bit0(i32 %x) {
+; CHECK-LABEL: ne_bit0:
+; CHECK:       bbsi {{a[0-9]+}}, 0,
+  %masked = and i32 %x, 1
+  %test = icmp ne i32 %masked, 0
+  br i1 %test, label %set, label %clear
+clear:
+  ret i32 0
+set:
+  ret i32 1
+}
+
+define i32 @eq_bit7(i32 %x) {
+; CHECK-LABEL: eq_bit7:
+; CHECK:       bbci {{a[0-9]+}}, 7,
+  %masked = and i32 %x, 128
+  %test = icmp eq i32 %masked, 0
+  br i1 %test, label %set, label %clear
+clear:
+  ret i32 0
+set:
+  ret i32 1
+}
+
+define i32 @ne_bit7(i32 %x) {
+; CHECK-LABEL: ne_bit7:
+; CHECK:       bbsi {{a[0-9]+}}, 7,
+  %masked = and i32 %x, 128
+  %test = icmp ne i32 %masked, 0
+  br i1 %test, label %set, label %clear
+clear:
+  ret i32 0
+set:
+  ret i32 1
+}
+
+define i32 @eq_bit16(i32 %x) {
+; CHECK-LABEL: eq_bit16:
+; CHECK:       bbci {{a[0-9]+}}, 16,
+  %masked = and i32 %x, 65536
+  %test = icmp eq i32 %masked, 0
+  br i1 %test, label %set, label %clear
+clear:
+  ret i32 0
+set:
+  ret i32 1
+}
+
+define i32 @ne_bit16(i32 %x) {
+; CHECK-LABEL: ne_bit16:
+; CHECK:       bbsi {{a[0-9]+}}, 16,
+  %masked = and i32 %x, 65536
+  %test = icmp ne i32 %masked, 0
+  br i1 %test, label %set, label %clear
+clear:
+  ret i32 0
+set:
+  ret i32 1
+}
+
+define i32 @eq_bit30(i32 %x) {
+; CHECK-LABEL: eq_bit30:
+; CHECK:       bbci {{a[0-9]+}}, 30,
+  %masked = and i32 %x, 1073741824
+  %test = icmp eq i32 %masked, 0
+  br i1 %test, label %set, label %clear
+clear:
+  ret i32 0
+set:
+  ret i32 1
+}
+
+define i32 @ne_bit30(i32 %x) {
+; CHECK-LABEL: ne_bit30:
+; CHECK:       bbsi {{a[0-9]+}}, 30,
+  %masked = and i32 %x, 1073741824
+  %test = icmp ne i32 %masked, 0
+  br i1 %test, label %set, label %clear
+clear:
+  ret i32 0
+set:
+  ret i32 1
+}
+
+; Bit 31 can be represented by the signed zero branches instead. Exercise the
+; case without requiring one particular canonical instruction.
+define i32 @eq_bit31(i32 %x) {
+; CHECK-LABEL: eq_bit31:
+; CHECK:       ret
+  %masked = and i32 %x, -2147483648
+  %test = icmp eq i32 %masked, 0
+  br i1 %test, label %set, label %clear
+clear:
+  ret i32 0
+set:
+  ret i32 1
+}
+
+define i32 @ne_bit31(i32 %x) {
+; CHECK-LABEL: ne_bit31:
+; CHECK:       ret
+  %masked = and i32 %x, -2147483648
+  %test = icmp ne i32 %masked, 0
+  br i1 %test, label %set, label %clear
+clear:
+  ret i32 0
+set:
+  ret i32 1
+}
+
+; Multi-bit masks must retain their general mask-and-compare lowering.
+define i32 @multi_bit_mask(i32 %x) {
+; CHECK-LABEL: multi_bit_mask:
+; CHECK-NOT:   bbci
+; CHECK-NOT:   bbsi
+; CHECK:       ret
+  %masked = and i32 %x, 5
+  %test = icmp eq i32 %masked, 0
+  br i1 %test, label %set, label %clear
+clear:
+  ret i32 0
+set:
+  ret i32 1
+}
+
+; A materialized Boolean is not a branch and must not select a bit branch.
+define i32 @bit_test_value_only(i32 %x) {
+; CHECK-LABEL: bit_test_value_only:
+; CHECK-NOT:   bbci
+; CHECK-NOT:   bbsi
+; CHECK:       ret
+  %masked = and i32 %x, 128
+  %test = icmp eq i32 %masked, 0
+  %value = zext i1 %test to i32
+  ret i32 %value
+}
+
+; The masked value has another live use, so selecting the branch must not
+; discard or duplicate its materialized value.
+define i32 @shared_mask_value(i32 %x) {
+; CHECK-LABEL: shared_mask_value:
+; CHECK-NOT:   bbci
+; CHECK-NOT:   bbsi
+; CHECK:       and
+  %masked = and i32 %x, 1
+  %test = icmp eq i32 %masked, 0
+  br i1 %test, label %set, label %clear
+clear:
+  ret i32 %masked
+set:
+  %value = add i32 %masked, 1
+  ret i32 %value
+}
+
+; BBCI/BBSI have signed 8-bit PC-relative offsets. The true target is placed
+; after a 1 KiB block; relaxation must invert the local bit test and jump to
+; the far destination while preserving the original branch's true semantics.
+define i32 @far_bit_branch(i32 %x) {
+; CHECK-LABEL: far_bit_branch:
+; CHECK:       bbsi {{a[0-9]+}}, 0, [[FALLTHROUGH:.LBB[0-9]+_[0-9]+]]
+; CHECK-NEXT:  j [[FAR:.LBB[0-9]+_[0-9]+]]
+; CHECK:       [[FALLTHROUGH]]:
+; CHECK:       .space 1024
+; CHECK:       [[FAR]]:
+  %masked = and i32 %x, 1
+  %test = icmp eq i32 %masked, 0
+  br i1 %test, label %far, label %near
+near:
+  call void asm sideeffect ".space 1024", ""()
+  ret i32 0
+far:
+  ret i32 1
+}
diff --git a/llvm/test/CodeGen/Xtensa/bit-test-branch.mir b/llvm/test/CodeGen/Xtensa/bit-test-branch.mir
new file mode 100644
--- /dev/null
+++ b/llvm/test/CodeGen/Xtensa/bit-test-branch.mir
@@ -0,0 +1,66 @@
+# RUN: llc -mtriple=xtensa -mcpu=esp32s3 -run-pass=branch-folder -verify-machineinstrs %s -o - | FileCheck %s
+
+--- |
+  target triple = "xtensa"
+  define i32 @duplicate_bit_test(i32 %x) { ret i32 0 }
+  define i32 @different_bit_indices(i32 %x) { ret i32 0 }
+  define i32 @different_source_registers(i32 %x, i32 %y) { ret i32 0 }
+...
+---
+name: duplicate_bit_test
+tracksRegLiveness: false
+body: |
+  bb.0:
+    successors: %bb.1, %bb.2
+    BBCI $a2, 7, %bb.2
+    BBCI $a2, 7, %bb.2
+    J %bb.1
+  bb.1:
+    $a2 = MOVI 0
+    RETW implicit $a0, implicit $a2
+  bb.2:
+    $a2 = MOVI 1
+    RETW implicit $a0, implicit $a2
+...
+# CHECK-LABEL: name:{{ *}}duplicate_bit_test
+# CHECK:       BBCI $a2, 7, %[[DEST:bb\.[0-9]+]]
+# CHECK-NOT:   BBCI
+# CHECK:       RETW
+---
+name: different_bit_indices
+tracksRegLiveness: false
+body: |
+  bb.0:
+    successors: %bb.1, %bb.2
+    BBCI $a2, 0, %bb.2
+    BBCI $a2, 16, %bb.2
+    J %bb.1
+  bb.1:
+    $a2 = MOVI 0
+    RETW implicit $a0, implicit $a2
+  bb.2:
+    $a2 = MOVI 1
+    RETW implicit $a0, implicit $a2
+...
+# CHECK-LABEL: name:{{ *}}different_bit_indices
+# CHECK:       BBCI $a2, 0, %[[INDEX_DEST:bb\.[0-9]+]]
+# CHECK-NEXT:  BBCI $a2, 16, %[[INDEX_DEST]]
+---
+name: different_source_registers
+tracksRegLiveness: false
+body: |
+  bb.0:
+    successors: %bb.1, %bb.2
+    BBSI $a2, 3, %bb.2
+    BBSI $a3, 3, %bb.2
+    J %bb.1
+  bb.1:
+    $a2 = MOVI 0
+    RETW implicit $a0, implicit $a2
+  bb.2:
+    $a2 = MOVI 1
+    RETW implicit $a0, implicit $a2
+...
+# CHECK-LABEL: name:{{ *}}different_source_registers
+# CHECK:       BBSI $a2, 3, %[[REG_DEST:bb\.[0-9]+]]
+# CHECK-NEXT:  BBSI $a3, 3, %[[REG_DEST]]
