+static SDValue PerformBitTestBranchCombine(SDNode *N, SelectionDAG &DAG) {
+  ISD::CondCode CC = cast<CondCodeSDNode>(N->getOperand(1))->get();
+  SDValue LHS = N->getOperand(2);
+  if ((CC != ISD::SETEQ && CC != ISD::SETNE) ||
+      LHS.getValueType() != MVT::i32 || LHS.getOpcode() != ISD::AND ||
+      !LHS.hasOneUse())
+    return SDValue();
+  auto *Mask = dyn_cast<ConstantSDNode>(LHS.getOperand(1));
+  if (!Mask || !Mask->getAPIntValue().isPowerOf2())
+    return SDValue();
+  auto *Compare = dyn_cast<ConstantSDNode>(N->getOperand(3));
+  if (!Compare || (!Compare->isZero() &&
+                   Compare->getAPIntValue() != Mask->getAPIntValue()))
+    return SDValue();
+
+  // Preserve the bit index before large masks become literal-pool loads.
+  // The AND must be branch-only; retain shared materialized values.
+  // The DAG can canonicalize (x & mask) != 0 to (x & mask) == mask.
+  SDLoc DL(N);
+  bool BranchOnSet = Compare->isZero() ? CC == ISD::SETNE : CC == ISD::SETEQ;
+  unsigned Opcode = BranchOnSet ? XtensaISD::BR_BIT_SET
+                                : XtensaISD::BR_BIT_CLEAR;
+  return DAG.getNode(Opcode, DL, MVT::Other, N->getOperand(0),
+                     LHS.getOperand(0),
+                     DAG.getConstant(Mask->getAPIntValue().logBase2(),
+                                     DL, MVT::i32),
+                     N->getOperand(4));
+}
+
 static SDValue PerformInequalityBranchCombine(SDNode *N, SelectionDAG &DAG) {
   ISD::CondCode CC = cast<CondCodeSDNode>(N->getOperand(1))->get();
   SDValue LHS = N->getOperand(2);
@@ -1037,6 +1066,8 @@
       return reuseExtendedSignMask(N, DAG);
     break;
   case ISD::BR_CC:
+    if (SDValue Combined = PerformBitTestBranchCombine(N, DAG))
+      return Combined;
     if (SDValue Combined = PerformInequalityBranchCombine(N, DAG))
       return Combined;
     if (Subtarget.hasLoop())
@@ -2449,6 +2480,10 @@
