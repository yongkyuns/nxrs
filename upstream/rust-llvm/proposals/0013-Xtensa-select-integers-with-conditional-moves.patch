+; RUN: llc -mtriple=xtensa -mcpu=esp32s3 -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=ALL,S3
+; RUN: llc -mtriple=xtensa -mcpu=esp32 -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=ALL,OLD
