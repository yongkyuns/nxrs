+; ALL-LABEL: select_eq:
+; ALL:       xor [[COND:a[0-9]+]], a2, a3
+; ALL:       moveqz a5, a4, [[COND]]
+; ALL-NOT:   beq
+; ALL:       ret
+define i32 @select_eq(i32 %lhs, i32 %rhs, i32 %yes, i32 %no) {
+  %cmp = icmp eq i32 %lhs, %rhs
+  %result = select i1 %cmp, i32 %yes, i32 %no
+  ret i32 %result
+}
+
+; ALL-LABEL: select_ne:
+; ALL:       xor [[COND:a[0-9]+]], a2, a3
+; ALL:       movnez a5, a4, [[COND]]
+; ALL-NOT:   bne
+; ALL:       ret
+define i32 @select_ne(i32 %lhs, i32 %rhs, i32 %yes, i32 %no) {
+  %cmp = icmp ne i32 %lhs, %rhs
+  %result = select i1 %cmp, i32 %yes, i32 %no
+  ret i32 %result
+}
+
+; ALL-LABEL: select_negative:
+; ALL:       movltz a4, a3, a2
+; ALL-NOT:   blt
+; ALL:       ret
+define i32 @select_negative(i32 %lhs, i32 %yes, i32 %no) {
+  %cmp = icmp slt i32 %lhs, 0
+  %result = select i1 %cmp, i32 %yes, i32 %no
+  ret i32 %result
+}
+
+; ALL-LABEL: select_nonnegative:
+; ALL:       movltz a3, a4, a2
+; ALL-NOT:   bge
+; ALL:       ret
+define i32 @select_nonnegative(i32 %lhs, i32 %yes, i32 %no) {
+  %cmp = icmp sge i32 %lhs, 0
+  %result = select i1 %cmp, i32 %yes, i32 %no
+  ret i32 %result
+}
