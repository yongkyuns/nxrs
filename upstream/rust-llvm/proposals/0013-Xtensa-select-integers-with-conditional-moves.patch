   SELECT_CC,
   SELECT_CC_FP,
+  SELECT_EQZ,
+  SELECT_NEZ,
+  SELECT_LTZ,
+  SELECT_GEZ,
 
   // SRCL(R) performs shift left(right) of the concatenation of 2 registers
   // and returns high(low) 32-bit part of 64-bit result
diff --git a/llvm/lib/Target/Xtensa/XtensaInstrInfo.td b/llvm/lib/Target/Xtensa/XtensaInstrInfo.td
--- a/llvm/lib/Target/Xtensa/XtensaInstrInfo.td
+++ b/llvm/lib/Target/Xtensa/XtensaInstrInfo.td
@@ -124,14 +124,20 @@
   def : Pat<(setne AR:$s, AR:$t), (SALTU (MOVI 0), (XOR AR:$s, AR:$t))>;
 }
 
-def MOVEQZ : RRR_Inst<0x00, 0x03, 0x08, (outs AR:$r), (ins AR:$s, AR:$t),
-                     "moveqz\t$r, $s, $t", []>;
-def MOVNEZ : RRR_Inst<0x00, 0x03, 0x09, (outs AR:$r), (ins AR:$s, AR:$t),
-                     "movnez\t$r, $s, $t", []>;
-def MOVLTZ : RRR_Inst<0x00, 0x03, 0x0A, (outs AR:$r), (ins AR:$s, AR:$t),
-                     "movltz\t$r, $s, $t", []>;
-def MOVGEZ : RRR_Inst<0x00, 0x03, 0x0B, (outs AR:$r), (ins AR:$s, AR:$t),
-                     "movgez\t$r, $s, $t", []>;
+// The destination retains its old value when the predicate is false. Model
+// that read as a tied input so allocation cannot discard the false value.
+class ConditionalMove<bits<4> Op, string Name, SDNode Node>
+    : RRR_Inst<0x00, 0x03, Op, (outs AR:$r),
+               (ins AR:$false, AR:$s, AR:$t),
+               Name#"\t$r, $s, $t",
+               [(set AR:$r, (Node AR:$false, AR:$s, AR:$t))]> {
+  let Constraints = "$false = $r";
+  let hasSideEffects = 0;
+}
+def MOVEQZ : ConditionalMove<0x08, "moveqz", Xtensa_select_eqz>;
+def MOVNEZ : ConditionalMove<0x09, "movnez", Xtensa_select_nez>;
+def MOVLTZ : ConditionalMove<0x0A, "movltz", Xtensa_select_ltz>;
+def MOVGEZ : ConditionalMove<0x0B, "movgez", Xtensa_select_gez>;
 
 //===----------------------------------------------------------------------===//
 // Shift instructions
