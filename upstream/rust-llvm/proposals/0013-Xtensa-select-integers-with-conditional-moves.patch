From: nxrs contributors
Subject: [PATCH RFC] Xtensa: select integers with tied conditional moves

The existing conditional-move definitions omit the destination's preserved
false-value input and have no selection patterns. Integer SELECT_CC is
therefore expanded into branch/copy/sink CFG even when native conditional
moves can represent the operation.

Model the read-modify-write destination as a tied input and select equality
and signed-zero predicates with XOR/sign tests. On ESP32-S3, use native
SALT/SALTU for other signed/unsigned predicates; retain the original branch
fallback on older profiles. Recover the canonical -1 comparison form of sign
tests. No new application feature, layout override or handwritten assembly.

The focused test checks both predicate operands and true/false selection,
aliasing, older/disabled CPU fallback and verified native object output.
Existing generated assembly checks are refreshed without changing IR or RUN
commands. Applied after the separate call-frame correctness RFC; wider
profitability and device qualification are reported independently.

diff --git a/llvm/lib/Target/Xtensa/XtensaISelLowering.cpp b/llvm/lib/Target/Xtensa/XtensaISelLowering.cpp
--- a/llvm/lib/Target/Xtensa/XtensaISelLowering.cpp
+++ b/llvm/lib/Target/Xtensa/XtensaISelLowering.cpp
@@ -1583,6 +1583,46 @@
                        LHS, RHS, TrueValue, FalseValue, TargetCC);
   else if (TrueValue.getValueType().isVector())
     return Op;
+
+  if (Ty == MVT::i32 && TrueValue.getValueType() == MVT::i32) {
+    unsigned Move = 0;
+    SDValue Condition;
+    if (CC == ISD::SETEQ || CC == ISD::SETNE) {
+      Move = CC == ISD::SETEQ ? XtensaISD::SELECT_EQZ : XtensaISD::SELECT_NEZ;
+      Condition = DAG.getNode(ISD::XOR, DL, MVT::i32, LHS, RHS);
+    } else if (isNullConstant(RHS) &&
+               (CC == ISD::SETLT || CC == ISD::SETGE)) {
+      Move = CC == ISD::SETLT ? XtensaISD::SELECT_LTZ : XtensaISD::SELECT_GEZ;
+      Condition = LHS;
+    } else if (isAllOnesConstant(LHS) &&
+               (CC == ISD::SETLT || CC == ISD::SETGE)) {
+      // Canonicalization represents x >= 0 as -1 < x (and x < 0 as
+      // -1 >= x). Recover the sign predicate without materializing -1.
+      Move = CC == ISD::SETLT ? XtensaISD::SELECT_GEZ : XtensaISD::SELECT_LTZ;
+      Condition = RHS;
+    } else if (Subtarget.hasESP32S3Ops()) {
+      // SALT/SALTU materialize a predicate on ESP32-S3. Do not request a
+      // non-native SETCC on older cores, which still use their branch path.
+      ISD::CondCode Less = ISD::SETLT;
+      bool Swap = false, Invert = false;
+      switch (CC) {
+      case ISD::SETLT: break;
+      case ISD::SETULT: Less = ISD::SETULT; break;
+      case ISD::SETGE: Invert = true; break;
+      case ISD::SETUGE: Less = ISD::SETULT; Invert = true; break;
+      case ISD::SETGT: Swap = true; break;
+      case ISD::SETUGT: Less = ISD::SETULT; Swap = true; break;
+      case ISD::SETLE: Swap = true; Invert = true; break;
+      case ISD::SETULE: Less = ISD::SETULT; Swap = true; Invert = true; break;
+      default: llvm_unreachable("Unexpected integer select condition");
+      }
+      Condition = DAG.getSetCC(DL, MVT::i32, Swap ? RHS : LHS,
+                              Swap ? LHS : RHS, Less);
+      Move = Invert ? XtensaISD::SELECT_EQZ : XtensaISD::SELECT_NEZ;
+    }
+    if (Move)
+      return DAG.getNode(Move, DL, MVT::i32, FalseValue, TrueValue, Condition);
+  }
 
   return DAG.getNode(XtensaISD::SELECT_CC, DL, Ty, LHS, RHS, TrueValue,
                      FalseValue, TargetCC);
@@ -2318,6 +2358,14 @@
     return "XtensaISD::RETW";
   case XtensaISD::SELECT_CC:
     return "XtensaISD::SELECT_CC";
+  case XtensaISD::SELECT_EQZ:
+    return "XtensaISD::SELECT_EQZ";
+  case XtensaISD::SELECT_NEZ:
+    return "XtensaISD::SELECT_NEZ";
+  case XtensaISD::SELECT_LTZ:
+    return "XtensaISD::SELECT_LTZ";
+  case XtensaISD::SELECT_GEZ:
+    return "XtensaISD::SELECT_GEZ";
   case XtensaISD::SELECT_CC_FP:
     return "XtensaISD::SELECT_CC_FP";
   case XtensaISD::BR_T:
