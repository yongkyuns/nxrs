+
+def SDT_XtensaSelectMove : SDTypeProfile<1, 3,
+    [SDTCisVT<0, i32>, SDTCisSameAs<0, 1>, SDTCisSameAs<0, 2>,
+     SDTCisSameAs<0, 3>]>;
 
 def SDT_XtensaMOVSP               : SDTypeProfile<1, 1, [SDTCisSameAs<0, 1>, SDTCisVT<0, i32>]>;
 def SDT_XtensaBrBool              : SDTypeProfile<0, 2, [SDTCisVT<0, v1i1>, SDTCisVT<1, OtherVT>]>;
@@ -80,6 +84,10 @@
                             [SDNPInGlue]>;
 def Xtensa_select_cc_fp: SDNode<"XtensaISD::SELECT_CC_FP", SDT_XtensaSelectCCFP,
                             [SDNPInGlue]>;
+def Xtensa_select_eqz : SDNode<"XtensaISD::SELECT_EQZ", SDT_XtensaSelectMove>;
+def Xtensa_select_nez : SDNode<"XtensaISD::SELECT_NEZ", SDT_XtensaSelectMove>;
+def Xtensa_select_ltz : SDNode<"XtensaISD::SELECT_LTZ", SDT_XtensaSelectMove>;
+def Xtensa_select_gez : SDNode<"XtensaISD::SELECT_GEZ", SDT_XtensaSelectMove>;
 
 def Xtensa_srcl: SDNode<"XtensaISD::SRCL", SDT_XtensaSRC>;
 
