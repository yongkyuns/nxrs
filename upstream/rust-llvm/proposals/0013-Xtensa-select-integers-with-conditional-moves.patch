+; RUN: llc -mtriple=xtensa -mcpu=esp32s3 -mattr=-esp32s3 -verify-machineinstrs %s -o - | FileCheck %s --check-prefixes=ALL,OLD
+; RUN: llc -mtriple=xtensa -mcpu=esp32s3 -verify-machineinstrs -filetype=obj %s -o /dev/null
+; RUN: llc -mtriple=xtensa -mcpu=esp32 -verify-machineinstrs -filetype=obj %s -o /dev/null
+; RUN: llc -mtriple=xtensa -mcpu=generic -verify-machineinstrs -filetype=obj %s -o /dev/null
