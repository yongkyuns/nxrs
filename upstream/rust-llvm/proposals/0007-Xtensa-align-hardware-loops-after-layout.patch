+namespace {
+// Branch relaxation can move a previously aligned hardware loop. Align its
+// body only after layout is stable. Padding stays outside the repeated body.
+class XtensaAlignHwLoops : public MachineFunctionPass {
+public:
+  static char ID;
+  XtensaAlignHwLoops() : MachineFunctionPass(ID) {
+    initializeXtensaAlignHwLoopsPass(*PassRegistry::getPassRegistry());
+  }
+
+  StringRef getPassName() const override {
+    return "Xtensa Final Hardware Loop Alignment";
+  }
+
+  void getAnalysisUsage(AnalysisUsage &AU) const override {
+    AU.setPreservesCFG();
+    MachineFunctionPass::getAnalysisUsage(AU);
+  }
+
+  MachineFunctionProperties getRequiredProperties() const override {
+    return MachineFunctionProperties().set(
+        MachineFunctionProperties::Property::NoVRegs);
+  }
+
+  bool runOnMachineFunction(MachineFunction &MF) override {
+    if (skipFunction(MF.getFunction()))
+      return false;
+    bool HasLoop = false;
+    bool HasInlineAsm = false;
+    Align FunctionAlignment(4);
+    for (const MachineBasicBlock &MBB : MF) {
+      FunctionAlignment = std::max(FunctionAlignment, MBB.getAlignment());
+      for (const MachineInstr &MI : MBB) {
+        HasLoop |= MI.getOpcode() == Xtensa::LOOP;
+        HasInlineAsm |= MI.isInlineAsm();
+      }
+    }
+    if (!HasLoop)
+      return false;
+    // Normal compilation takes the software-loop fallback before this pass.
+    // Reject unsupported explicit MIR loops rather than guess assembly sizes.
+    if (HasInlineAsm)
+      report_fatal_error("cannot align explicit Xtensa hardware loop with inline assembly");
+
+    // A word-aligned function makes body offsets independent of link address.
+    // Cover stronger block alignments too, so their offsets are known exactly.
+    bool Changed = MF.getAlignment() < FunctionAlignment;
+    MF.ensureAlignment(FunctionAlignment);
+    const auto &ST = MF.getSubtarget<XtensaSubtarget>();
+    const TargetInstrInfo *TII = ST.getInstrInfo();
+    uint64_t Offset = 0;
+    for (MachineBasicBlock &MBB : MF) {
+      uint64_t Padding = offsetToAlignment(Offset, MBB.getAlignment());
+      unsigned MaxPadding = MBB.getMaxBytesForAlignment();
+      if (!MaxPadding || Padding <= MaxPadding)
+        Offset += Padding;
+      for (MachineInstr &MI : MBB) {
+        if (MI.isMetaInstruction() || MI.getOpcode() == Xtensa::LOOPEND)
+          continue;
+        if (MI.getOpcode() == Xtensa::LOOP) {
+          // Start the body on a word boundary, including four-byte ESP32-S3
+          // instructions. Without density, only three-byte NOPs are available.
+          static const unsigned DensityPadding[] = {5, 0, 3, 2};
+          static const unsigned BasePadding[] = {9, 0, 3, 6};
+          unsigned Padding = ST.hasDensity() ? DensityPadding[Offset & 3]
+                                            : BasePadding[Offset & 3];
+          Offset += Padding;
+          while (Padding) {
+            const unsigned Size = Padding == 2 ? 2 : 3;
+            BuildMI(MBB, MI.getIterator(), MI.getDebugLoc(),
+                    TII->get(Size == 2 ? Xtensa::NOP_N : Xtensa::NOP));
+            Padding -= Size;
+            Changed = true;
+          }
+        }
+        // LOOP has a conservative range reservation, not a twelve-byte
+        // encoding. Use actual encoding sizes for final alignment offsets.
+        Offset += MI.getOpcode() == Xtensa::LOOP ? 3
+                  : TII->getInstSizeInBytes(MI);
+      }
+    }
+    return Changed;
+  }
+};
+char XtensaAlignHwLoops::ID = 0;
+} // namespace
+
+INITIALIZE_PASS(XtensaAlignHwLoops, "xtensa-align-hwloops",
+                "Xtensa Final Hardware Loop Alignment", false, false)
+
+FunctionPass *llvm::createXtensaAlignHwLoops() {
+  return new XtensaAlignHwLoops();
+}
