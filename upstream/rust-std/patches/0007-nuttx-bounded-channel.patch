+/* Header ABI translation only; all queue behavior is Rust. */
+#include <stdint.h>
+#include <nuttx/spinlock.h>
+_Static_assert(sizeof(spinlock_t) <= 2 * sizeof(uintptr_t), "spinlock storage size");
+_Static_assert(_Alignof(spinlock_t) <= _Alignof(uintptr_t), "spinlock storage alignment");
+_Static_assert(sizeof(irqstate_t) <= sizeof(uintptr_t), "interrupt state ABI");
+void __rust_nuttx_spin_init(void *storage) { spin_lock_init((spinlock_t *)storage); }
+uintptr_t __rust_nuttx_spin_lock(void *storage) {
+  return (uintptr_t)spin_lock_irqsave((volatile spinlock_t *)storage);
+}
+void __rust_nuttx_spin_unlock(void *storage, uintptr_t flags) {
+  spin_unlock_irqrestore((volatile spinlock_t *)storage, (irqstate_t)flags);
+}
