diff --git a/std/src/num/f32.rs b/std/src/num/f32.rs
index 5dee68a..648ca55 100644
--- a/std/src/num/f32.rs
+++ b/std/src/num/f32.rs
@@ -1077,5 +1077,14 @@
     pub fn asinh(self) -> f32 {
+        #[cfg(target_os = "nuttx")]
+        {
+            cmath::asinhf(self)
+        }
+        #[cfg(not(target_os = "nuttx"))]
+        {
-        let ax = self.abs();
-        let ix = 1.0 / ax;
-        (ax + (ax / (Self::hypot(1.0, ix) + ix))).ln_1p().copysign(self)
+            let ax = self.abs();
+            let ix = 1.0 / ax;
+            (ax + (ax / (Self::hypot(1.0, ix) + ix)))
+                .ln_1p()
+                .copysign(self)
+        }
     }
@@ -1105,7 +1112,14 @@
     pub fn acosh(self) -> f32 {
+        #[cfg(target_os = "nuttx")]
+        {
+            cmath::acoshf(self)
+        }
+        #[cfg(not(target_os = "nuttx"))]
+        {
-        if self < 1.0 {
-            Self::NAN
-        } else {
-            (self + ((self - 1.0).sqrt() * (self + 1.0).sqrt())).ln()
-        }
+            if self < 1.0 {
+                Self::NAN
+            } else {
+                (self + ((self - 1.0).sqrt() * (self + 1.0).sqrt())).ln()
+            }
+        }
     }
@@ -1135,3 +1149,10 @@
     pub fn atanh(self) -> f32 {
