+        {
+            cmath::atanhf(self)
+        }
+        #[cfg(not(target_os = "nuttx"))]
+        {
-        0.5 * ((2.0 * self) / (1.0 - self)).ln_1p()
+            0.5 * ((2.0 * self) / (1.0 - self)).ln_1p()
+        }
     }
