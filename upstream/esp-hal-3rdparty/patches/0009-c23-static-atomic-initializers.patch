From: nxrs contributors
Subject: [PATCH] use direct static atomic initializers with C23

GCC 16 defaults to C23 and removes ATOMIC_VAR_INIT from its stdatomic.h.
NuttX consumes the compiler header rather than ESP-IDF's compatibility wrapper.
Use direct constant initialization for the same static atomic objects and
members. Preserve every initial value and all subsequent atomic operations.

Source: b90b1837cb5ad24747deb4c895246037cc206ce5

--- a/components/esp_adc/adc_oneshot.c
+++ b/components/esp_adc/adc_oneshot.c
@@ -55,9 +55,9 @@
 } adc_oneshot_ctx_t;
 
 static adc_oneshot_ctx_t s_ctx;    //ADC oneshot mode context
-static atomic_bool s_adc_unit_claimed[SOC_ADC_PERIPH_NUM] = {ATOMIC_VAR_INIT(false),
+static atomic_bool s_adc_unit_claimed[SOC_ADC_PERIPH_NUM] = {false,
 #if (SOC_ADC_PERIPH_NUM >= 2)
-                                                             ATOMIC_VAR_INIT(false)
+                                                             false
 #endif
                                                             };
 
--- a/components/esp_adc/adc_filter.c
+++ b/components/esp_adc/adc_filter.c
@@ -21,9 +21,9 @@
 static portMUX_TYPE s_filter_spinlock = portMUX_INITIALIZER_UNLOCKED;
 
 #if SOC_ADC_DIG_IIR_FILTER_UNIT_BINDED
-static atomic_bool s_adc_filter_claimed[SOC_ADC_DIGI_IIR_FILTER_NUM] = {ATOMIC_VAR_INIT(false),
+static atomic_bool s_adc_filter_claimed[SOC_ADC_DIGI_IIR_FILTER_NUM] = {false,
 #if (SOC_ADC_DIGI_IIR_FILTER_NUM >= 2)
-                                                                        ATOMIC_VAR_INIT(false)
+                                                                        false
 #endif
                                                                        };
 
--- a/components/upper_hal_i2s/lp_i2s_vad.c
+++ b/components/upper_hal_i2s/lp_i2s_vad.c
@@ -31,7 +31,7 @@
