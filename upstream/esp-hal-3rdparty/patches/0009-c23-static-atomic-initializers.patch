 } vad_unit_ctx_t;
 
-static atomic_bool s_vad_id_claimed[SOC_ADC_PERIPH_NUM] = {ATOMIC_VAR_INIT(false)};
+static atomic_bool s_vad_id_claimed[SOC_ADC_PERIPH_NUM] = {false};
 
 static bool s_vad_claim(lp_vad_t vad_id)
 {
--- a/components/esp_hw_support/spi_share_hw_ctrl.c
+++ b/components/esp_hw_support/spi_share_hw_ctrl.c
