--- a/hw/char/esp32_uart.c
+++ b/hw/char/esp32_uart.c
@@ -58,7 +58,9 @@
 
 void esp32_uart_set_rx_timeout(ESP32UARTState *s)
 {
-    if (s->rx_tout_ena) {
+    /* Timeout marks a gap after reception. Enabling RX with an empty
+     * FIFO must not raise an interrupt without a received byte. */
+    if (s->rx_tout_ena && s->rx_cnt != 0) {
         int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
         int64_t tout_ns = s->rx_tout_thres * NANOSECONDS_PER_SECOND / s->baud_rate;
         int64_t rx_timeout_ns = now + tout_ns;
@@ -74,7 +76,9 @@
         timer_mod_ns(&s->rx_timeout_timer, rx_timeout_ns);
     } else {
         timer_del(&s->rx_timeout_timer);
-        s->rxfifo_tout = false;
+        if (!s->rx_tout_ena) {
+            s->rxfifo_tout = false;
+        }
     }
 }
 
@@ -105,6 +109,9 @@
             s->rx_rd = (s->rx_rd + 1) % UART_FIFO_LENGTH;
             if (s->rx_cnt > 0) {
                 s->rx_cnt--;
+                if (s->rx_cnt == 0) {
+                    timer_del(&s->rx_timeout_timer);
+                }
             }
             esp32_uart_update_irq(s);
             qemu_chr_fe_accept_input(&s->chr);
