+      close(listener);
+    }
+
+  if (svr_opts.hostkey != NULL)
+    {
+      sign_key_free(svr_opts.hostkey);
+    }
+
+  dropbear_random_cleanup();
+  m_malloc_free_epoch(0, 1);
+  memset(&svr_opts, 0, sizeof(svr_opts));
+  memset(&opts, 0, sizeof(opts));
+  memset(&ses, 0, sizeof(ses));
+  memset(&svr_ses, 0, sizeof(svr_ses));
+  result = g_server_result;
+  dropbear_service_finish(generation, result);
+  return result < 0 ? EXIT_FAILURE : EXIT_SUCCESS;
+}
