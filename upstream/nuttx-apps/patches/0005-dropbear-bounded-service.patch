+/* SPDX-License-Identifier: Apache-2.0 */
+#ifndef DROPBEAR_NUTTX_CONTROL_H
+#define DROPBEAR_NUTTX_CONTROL_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <sys/types.h>
+
+enum dropbear_service_state
+{
+  DROPBEAR_STOPPED,
+  DROPBEAR_STARTING,
