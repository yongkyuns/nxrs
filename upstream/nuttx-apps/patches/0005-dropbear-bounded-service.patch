diff --git a/netutils/dropbear/port/dropbear_entropy.c b/netutils/dropbear/port/dropbear_entropy.c
new file mode 100644
--- /dev/null
+++ b/netutils/dropbear/port/dropbear_entropy.c
@@ -0,0 +1,107 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+#include <nuttx/config.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "dropbear_control.h"
+
+/* Match the qualified native entropy sources, including the simulator's
+ * explicit host CSPRNG driver.  A configured software pool is not proof of
+ * readiness.  The hardware drivers retain their own health/failure policy.
+ */
+
+static bool dropbear_entropy_admitted(void)
+{
+#if defined(CONFIG_BUILD_FLAT) && defined(CONFIG_DEV_RANDOM) && \
+    defined(CONFIG_ARCH_SIM) && defined(CONFIG_SIM_RANDOM)
+  return true;
+#elif defined(CONFIG_BUILD_FLAT) && defined(CONFIG_ARCH_CHIP_RP23XX) && \
+      defined(CONFIG_RP23XX_RNG) && defined(CONFIG_DEV_RANDOM) && \
+      defined(CONFIG_DEV_URANDOM_ARCH) && !defined(CONFIG_SMP) && \
+      !defined(CONFIG_DEV_URANDOM_XORSHIFT128) && \
+      !defined(CONFIG_DEV_URANDOM_CONGRUENTIAL) && \
+      !defined(CONFIG_DEV_URANDOM_RANDOM_POOL) && \
+      CONFIG_RP23XX_RNG_POLL_TIMEOUT >= 1000 && \
+      CONFIG_RP23XX_RNG_POLL_TIMEOUT <= 1000000
+  return true;
+#elif defined(CONFIG_BUILD_FLAT) && defined(CONFIG_ARCH_CHIP_ESP32S3) && \
+      defined(CONFIG_ESP32S3_RNG) && defined(CONFIG_DEV_RANDOM) && \
+      defined(CONFIG_ESPRESSIF_WIFI) && !defined(CONFIG_SMP) && \
+      !defined(CONFIG_PM) && !defined(CONFIG_ESPRESSIF_AUTO_SLEEP) && \
+      !defined(CONFIG_ESP32S3_AUTO_SLEEP)
+  return true;
+#else
+  return false;
+#endif
+}
+
+int dropbear_entropy_read(void *buffer, size_t length)
+{
+  unsigned char *bytes = buffer;
+  size_t done = 0;
+  unsigned int interrupted = 0;
+  int result = -ENOTSUP;
+  int fd;
+
+  if (length == 0)
+    {
+      return 0;
+    }
+
+  if (!dropbear_entropy_admitted())
+    {
+      goto failed;
+    }
+
+  fd = open("/dev/random", O_RDONLY | O_NONBLOCK);
+  if (fd < 0)
+    {
+      result = -errno;
+      goto failed;
+    }
+
+  while (done < length)
+    {
+      ssize_t count;
+      size_t request = length - done;
+
+      if (dropbear_service_stopping())
+        {
+          result = -ECANCELED;
+          goto close_failed;
+        }
+
+      if (request > 32)
+        {
+          request = 32;
+        }
+
+      count = read(fd, bytes + done, request);
+      if (count > 0 && (size_t)count <= request)
+        {
+          done += count;
+          interrupted = 0;
+        }
+      else if (count < 0 && errno == EINTR && interrupted++ < 7)
+        {
+          continue;
+        }
+      else
+        {
+          result = count < 0 ? -errno : -EIO;
+          goto close_failed;
+        }
+    }
+
+  close(fd);
+  return 0;
+
+close_failed:
+  close(fd);
+failed:
+  explicit_bzero(buffer, length);
+  return result;
+}
