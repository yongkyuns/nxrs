+static int dropbear_open_listener(void)
+{
+  struct sockaddr_in address;
+  int flags;
+  int fd;
+  int result;
+  int reuse = 1;
+
+  memset(&address, 0, sizeof(address));
+  address.sin_family = AF_INET;
+  address.sin_port = htons(CONFIG_NETUTILS_DROPBEAR_PORT);
+  if (inet_pton(AF_INET, CONFIG_NETUTILS_DROPBEAR_BIND_ADDRESS,
+                &address.sin_addr) != 1)
+    {
+      return -EINVAL;
+    }
+
+  fd = socket(AF_INET, SOCK_STREAM, 0);
+  if (fd < 0)
+    {
+      return -errno;
+    }
+
+  /* One explicitly IPv4 socket avoids the upstream wrapper's first-address
+   * accept bug.  The owner keeps it nonblocking for cancellation and for a
+   * readiness notification that loses a race with a disconnected peer.
+   */
+
+  if (setsockopt(fd, SOL_SOCKET, SO_REUSEADDR, &reuse, sizeof(reuse)) < 0 ||
+      (flags = fcntl(fd, F_GETFL)) < 0 ||
+      fcntl(fd, F_SETFL, flags | O_NONBLOCK) < 0 ||
+      bind(fd, (struct sockaddr *)&address, sizeof(address)) < 0 ||
+      listen(fd, 1) < 0)
+    {
+      result = -errno;
+      close(fd);
+      return result;
+    }
+
+  return fd;
+}
+
+static int dropbear_wait_listener(void)
+{
+  int attempt;
+  int delay = 1;
+  int result = -ECANCELED;
+
+  for (attempt = 0; attempt <= CONFIG_NETUTILS_DROPBEAR_LISTEN_RETRIES;
+       attempt++)
+    {
+      int slice;
+
+      if (dropbear_service_stopping())
+        {
+          return -ECANCELED;
+        }
+
+      result = dropbear_open_listener();
+      if (result >= 0 || result == -EINVAL ||
+          attempt == CONFIG_NETUTILS_DROPBEAR_LISTEN_RETRIES)
+        {
+          return result;
+        }
+
+      dropbear_log(LOG_WARNING, "listen failed: %s; retry %d in %d seconds",
+                   strerror(-result), attempt + 1, delay);
+      for (slice = 0; slice < delay * 10; slice++)
+        {
+          if (dropbear_service_stopping())
+            {
+              return -ECANCELED;
+            }
+
+          poll(NULL, 0, 100);
+        }
+
+      if (delay < CONFIG_NETUTILS_DROPBEAR_LISTEN_RETRY_MAX)
+        {
+          delay *= 2;
+          if (delay > CONFIG_NETUTILS_DROPBEAR_LISTEN_RETRY_MAX)
+            {
+              delay = CONFIG_NETUTILS_DROPBEAR_LISTEN_RETRY_MAX;
+            }
+        }
+    }
+
+  return result;
+}
