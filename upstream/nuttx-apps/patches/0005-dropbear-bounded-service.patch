   if (cfd < 0)
     {
       return CRYPT_ERROR;
     }
 
   memset(&session, 0, sizeof(session));
   session.mac = CRYPTO_SHA2_256_HMAC;
   session.mackey = (caddr_t)key;
   session.mackeylen = (int)keylen;
   if (ioctl(cfd, CIOCGSESSION, &session) < 0)
     {
       close(cfd);
-      zeromem(hmac, sizeof(*hmac));
       return CRYPT_ERROR;
     }
 
