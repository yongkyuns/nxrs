diff --git a/netutils/dropbear/port/dropbear_control.c b/netutils/dropbear/port/dropbear_control.c
new file mode 100644
--- /dev/null
+++ b/netutils/dropbear/port/dropbear_control.c
@@ -0,0 +1,201 @@
+/* SPDX-License-Identifier: Apache-2.0 */
+
+#include <nuttx/config.h>
+#include <errno.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "dropbear_control.h"
+
+/* Built-in tasks share this state in a flat build.  Only the successful
+ * claimant accesses Dropbear's global protocol and allocation state.  Control
+ * commands never operate on descriptors belonging to another task group.
+ * A generation and state share one atomic word so a completed stop cannot
+ * accidentally wait for a subsequently started instance.
+ */
+
+#if ATOMIC_INT_LOCK_FREE != 2
+#  error "Dropbear control requires lock-free native unsigned atomics"
+#endif
+
+#define STATE_BITS 3u
+#define STATE_MASK ((1u << STATE_BITS) - 1u)
+#define GENERATION_STEP (1u << STATE_BITS)
+
+static atomic_uint g_control;
+static atomic_int g_owner;
+static atomic_int g_shell;
+static atomic_int g_result;
+
+static bool dropbear_active(unsigned int control)
+{
+  unsigned int state = control & STATE_MASK;
+  return state != DROPBEAR_STOPPED && state != DROPBEAR_FAILED;
+}
+
+int dropbear_service_begin(unsigned int *generation)
+{
+  unsigned int old = atomic_load(&g_control);
+  unsigned int next;
+
+  do
+    {
+      if (dropbear_active(old))
+        {
+          return -EBUSY;
+        }
+
+      next = ((old & ~STATE_MASK) + GENERATION_STEP) | DROPBEAR_STARTING;
+    }
+  while (!atomic_compare_exchange_weak(&g_control, &old, next));
+
+  *generation = next & ~STATE_MASK;
+  atomic_store(&g_owner, getpid());
+  atomic_store(&g_shell, -1);
+  atomic_store(&g_result, 0);
+  return 0;
+}
+
+void dropbear_service_phase(unsigned int generation,
+                            enum dropbear_service_state state)
+{
+  unsigned int old = atomic_load(&g_control);
+
+  while ((old & ~STATE_MASK) == generation && dropbear_active(old) &&
+         (old & STATE_MASK) != DROPBEAR_STOPPING)
+    {
+      if (atomic_compare_exchange_weak(&g_control, &old, generation | state))
+        {
+          return;
+        }
+    }
+}
+
+void dropbear_service_finish(unsigned int generation, int result)
+{
+  /* Publish completion only after descriptors, children, waiters and both
+   * allocation epochs have been retired by the owner.
+   */
+
+  atomic_store(&g_shell, -1);
+  atomic_store(&g_owner, 0);
+  atomic_store(&g_result, result);
+  atomic_store(&g_control, generation |
+               (result < 0 ? DROPBEAR_FAILED : DROPBEAR_STOPPED));
+}
+
+bool dropbear_service_stopping(void)
+{
+  return (atomic_load(&g_control) & STATE_MASK) == DROPBEAR_STOPPING;
+}
+
+void dropbear_service_cancel(void)
+{
+  unsigned int old = atomic_load(&g_control);
+  while (dropbear_active(old))
+    {
+      if (atomic_compare_exchange_weak(&g_control, &old,
+                                       (old & ~STATE_MASK) | DROPBEAR_STOPPING))
+        {
+          return;
+        }
+    }
+}
+
+void dropbear_service_shell(pid_t pid)
+{
+  atomic_store(&g_shell, pid);
+}
+
+int dropbear_service_stop(void)
+{
+  unsigned int old = atomic_load(&g_control);
+  unsigned int generation;
+  struct timespec start;
+  struct timespec now;
+  const struct timespec pause = {0, 10000000};
+  pid_t shell = atomic_load(&g_shell);
+  pid_t caller = getpid();
+
+  if (!dropbear_active(old))
+    {
+      return 0;
+    }
+
+  /* An NSH command can run in the shell or as its synchronous builtin child.
+   * Waiting here would prevent that same shell's waiter from joining.
+   */
+
+  if (caller == atomic_load(&g_owner) ||
+      (shell > 0 && (caller == shell || getppid() == shell)))
+    {
+      return -EDEADLK;
+    }
+
+  if (clock_gettime(CLOCK_MONOTONIC, &start) < 0)
+    {
+      return -errno;
+    }
+
+  generation = old & ~STATE_MASK;
+  while (dropbear_active(old) && (old & ~STATE_MASK) == generation)
+    {
+      if (atomic_compare_exchange_weak(&g_control, &old,
+                                       generation | DROPBEAR_STOPPING))
+        {
+          break;
+        }
+    }
+
+  for (;;)
+    {
+      old = atomic_load(&g_control);
+      if (!dropbear_active(old) || (old & ~STATE_MASK) != generation)
+        {
+          return 0;
+        }
+
+      if (clock_gettime(CLOCK_MONOTONIC, &now) < 0)
+        {
+          return -errno;
+        }
+
+      if (now.tv_sec - start.tv_sec > CONFIG_NETUTILS_DROPBEAR_STOP_TIMEOUT ||
+          (now.tv_sec - start.tv_sec == CONFIG_NETUTILS_DROPBEAR_STOP_TIMEOUT &&
+           now.tv_nsec >= start.tv_nsec))
+        {
+          /* Keep STOPPING and exclusive ownership.  Never free live state or
+           * admit another instance merely because the control wait expired.
+           */
+
+          return -ETIMEDOUT;
+        }
+
+      nanosleep(&pause, NULL);
+    }
+}
+
+void dropbear_service_status(void)
+{
+  static const char * const names[] =
+  {
+    "stopped", "starting", "listening", "session", "stopping", "failed"
+  };
+  unsigned int control;
+  int owner;
+  int result;
+
+  do
+    {
+      control = atomic_load(&g_control);
+      owner = atomic_load(&g_owner);
+      result = atomic_load(&g_result);
+    }
+  while (control != atomic_load(&g_control));
+
+  printf("dropbear: state=%s pid=%d result=%d\n",
+         names[control & STATE_MASK], owner, result);
+}
diff --git a/netutils/dropbear/port/dropbear_control.h b/netutils/dropbear/port/dropbear_control.h
new file mode 100644
--- /dev/null
