From eaab369070bf5b67fbcd035feafac3f24d831f1a Mon Sep 17 00:00:00 2001
From: Yongkyun Shin <yongkyuns@gmail.com>
Date: Fri, 23 Jan 2026 23:14:43 -0500
Subject: [PATCH] Add ESP32S3 VHCI transport support for NimBLE

- Update Makefile.nimble to use esp32s3_vhci transport when CONFIG_ESP32S3_NIMBLE_HCI is enabled
- Update nimble_bleprph_main.c to conditionally compile socket HCI code
- Include GATT service header

Co-Authored-By: Claude <noreply@anthropic.com>
---
 examples/nimble_bleprph/nimble_bleprph_main.c | 21 +++++++++++++++++++
 wireless/bluetooth/nimble/Makefile.nimble     | 11 ++++++++++
 2 files changed, 32 insertions(+)

diff --git a/examples/nimble_bleprph/nimble_bleprph_main.c b/examples/nimble_bleprph/nimble_bleprph_main.c
index 9dea4d226..ef9777180 100644
--- a/examples/nimble_bleprph/nimble_bleprph_main.c
+++ b/examples/nimble_bleprph/nimble_bleprph_main.c
@@ -36,6 +36,7 @@
 #include "host/ble_hs.h"
 #include "host/util/util.h"
 #include "services/gap/ble_svc_gap.h"
+#include "services/gatt/ble_svc_gatt.h"
 #include "services/bas/ble_svc_bas.h"
 
 /* Application-specified header. */
@@ -56,8 +57,10 @@
  * External Functions Prototypes
  ****************************************************************************/
 
+#ifndef CONFIG_ESP32S3_NIMBLE_HCI
 void ble_hci_sock_ack_handler(FAR void *param);
 void ble_hci_sock_set_device(int dev);
+#endif
 
 /****************************************************************************
  * Private Functions Prototypes
@@ -65,7 +68,9 @@ void ble_hci_sock_set_device(int dev);
 
 static void bleprph_advertise(void);
 static void nimble_host_task(FAR void *param);
+#ifndef CONFIG_ESP32S3_NIMBLE_HCI
 static FAR void *ble_hci_sock_task(FAR void *param);
+#endif
 static FAR void *ble_host_task(FAR void *param);
 static int bleprph_gap_event(FAR struct ble_gap_event *event, FAR void *arg);
 
@@ -330,6 +335,7 @@ static void nimble_host_task(FAR void *param)
   nimble_port_run();
 }
 
+#ifndef CONFIG_ESP32S3_NIMBLE_HCI
 /****************************************************************************
  * Name: ble_hci_sock_task
  ****************************************************************************/
@@ -339,6 +345,7 @@ static FAR void *ble_hci_sock_task(FAR void *param)
   ble_hci_sock_ack_handler(param);
   return NULL;
 }
+#endif
 
 /****************************************************************************
  * Name: ble_host_task
@@ -361,16 +368,23 @@ static FAR void *ble_host_task(FAR void *param)
 int main(int argc, FAR char *argv[])
 {
   struct ble_npl_task s_task_host;
+#ifndef CONFIG_ESP32S3_NIMBLE_HCI
   struct ble_npl_task s_task_hci;
+#endif
   uint8_t batt_level = 0;
   int ret = 0;
 
+#ifndef CONFIG_ESP32S3_NIMBLE_HCI
   /* allow to specify custom hci */
 
   if (argc > 1)
     {
       ble_hci_sock_set_device(atoi(argv[1]));
     }
+#else
+  (void)argc;
+  (void)argv;
+#endif
 
 #ifndef CONFIG_NSH_ARCHINIT
   /* Perform architecture-specific initialization */
@@ -386,6 +400,11 @@ int main(int argc, FAR char *argv[])
 
   nimble_port_init();
 
+  /* Initialize mandatory GAP and GATT services */
+
+  ble_svc_gap_init();
+  ble_svc_gatt_init();
+
   /* Initialize the NimBLE host configuration. */
 
   ble_hs_cfg.reset_cb = bleprph_on_reset;
@@ -398,6 +417,7 @@ int main(int argc, FAR char *argv[])
   ret = gatt_svr_init();
   assert(ret == 0);
 
+#ifndef CONFIG_ESP32S3_NIMBLE_HCI
   /* Create task which handles HCI socket */
 
   ret = ble_npl_task_init(&s_task_hci, "hci_sock", ble_hci_sock_task,
@@ -407,6 +427,7 @@ int main(int argc, FAR char *argv[])
     {
       printf("ERROR: starting hci task: %i\n", ret);
     }
+#endif
 
   /* Create task which handles default event queue for host stack. */
 
diff --git a/wireless/bluetooth/nimble/Makefile.nimble b/wireless/bluetooth/nimble/Makefile.nimble
index 8a4281dfa..bf60695c7 100644
--- a/wireless/bluetooth/nimble/Makefile.nimble
+++ b/wireless/bluetooth/nimble/Makefile.nimble
@@ -47,14 +47,25 @@ CSRCS += $(NIMBLE_SRC)
 # Source files for NPL OSAL
 
 CSRCS += $(wildcard $(NIMBLE_ROOT)/porting/npl/nuttx/src/*.c)
+
+# Transport layer: use VHCI for ESP32S3, socket for others
+ifeq ($(CONFIG_ESP32S3_NIMBLE_HCI),y)
+CSRCS += $(wildcard $(NIMBLE_ROOT)/nimble/transport/esp32s3_vhci/src/*.c)
+else
 CSRCS += $(wildcard $(NIMBLE_ROOT)/nimble/transport/socket/src/*.c)
+endif
+
 CSRCS += $(TINYCRYPT_SRC)
 
 # Add NPL and all NimBLE directories to include paths
 
 NIMBLE_ALL_INC =  $(APPDIR)/wireless/bluetooth/nimble/include
 NIMBLE_ALL_INC += $(NIMBLE_ROOT)/porting/npl/nuttx/include
+ifeq ($(CONFIG_ESP32S3_NIMBLE_HCI),y)
+NIMBLE_ALL_INC += $(NIMBLE_ROOT)/nimble/transport/esp32s3_vhci/include
+else
 NIMBLE_ALL_INC += $(NIMBLE_ROOT)/nimble/transport/socket/include
+endif
 NIMBLE_ALL_INC += $(NIMBLE_ROOT)/nimble/include
 NIMBLE_ALL_INC += $(NIMBLE_INCLUDE)
 NIMBLE_ALL_INC += $(TINYCRYPT_INCLUDE)
