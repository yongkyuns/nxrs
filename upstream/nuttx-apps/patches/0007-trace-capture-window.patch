From: NXRS maintainers
Subject: [PATCH] trace: add bounded, measured capture windows

Extend the existing built-in native command, leaving ordinary tracing intact.
Record native perf-clock bounds inside the enabled interval, retain category
filters, bound recorder output, and report loss separately from dump completion.
A single-core owner is required; raw device clients must remain inactive.

diff --git a/system/trace/CMakeLists.txt b/system/trace/CMakeLists.txt
--- a/system/trace/CMakeLists.txt
+++ b/system/trace/CMakeLists.txt
@@ -26,6 +26,10 @@
     list(APPEND CSRCS trace_dump.c)
   endif()
 
+  if(CONFIG_SYSTEM_TRACE_CAPTURE)
+    list(APPEND CSRCS trace_capture.c)
+  endif()
+
   nuttx_add_application(
     MODULE
     ${CONFIG_SYSTEM_TRACE}
diff --git a/system/trace/Kconfig b/system/trace/Kconfig
--- a/system/trace/Kconfig
+++ b/system/trace/Kconfig
@@ -11,6 +11,19 @@
 		Enable support for the trace command.
 
 if SYSTEM_TRACE
+
+config SYSTEM_TRACE_CAPTURE
+	bool "Bounded trace capture windows"
+	default n
+	depends on SYSTEM_TRACE = y && BUILD_FLAT
+	depends on DRIVERS_NOTERAM && SCHED_INSTRUMENTATION_FILTER
+	---help---
+		Enable trace capture <seconds> <recording-id>, with measured native
+		clock bounds and bounded no-overwrite dump framing. Other raw note
+		device/control clients must remain inactive. Trace invocations are
+		serialized with a robust mutex that recovers command ownership after
+		task exit. SMP, watchdog instrumentation, and configurations without
+		robust pthread mutex support refuse capture at runtime.
 
 config SYSTEM_TRACE_PROGNAME
 	string "Trace program name"
diff --git a/system/trace/Makefile b/system/trace/Makefile
