+func (a *API) onRecordingPermit(ctx *gin.Context) {
+	name, ok := paramName(ctx)
+	if !ok {
+		a.writeError(ctx, http.StatusBadRequest, fmt.Errorf("invalid name"))
+		return
+	}
+
+	var req struct {
+		PathID   uuid.UUID `json:"pathId"`
+		Revision *uint64   `json:"revision"`
+		Enable   *bool     `json:"enable"`
+	}
+	ctx.Request.Body = http.MaxBytesReader(ctx.Writer, ctx.Request.Body, 256)
+	decoder := json.NewDecoder(ctx.Request.Body)
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&req); err != nil || req.PathID == uuid.Nil ||
+		req.Revision == nil || req.Enable == nil || decoder.Decode(new(any)) != io.EOF {
+		a.writeError(ctx, http.StatusBadRequest, fmt.Errorf("invalid recording permit"))
+		return
+	}
+
+	deadline, cancel := context.WithTimeout(ctx.Request.Context(), 2*time.Second)
+	defer cancel()
+	state, err := a.RecordingPermit(deadline, name, defs.APIRecordingPermit{
+		PathID: req.PathID, Revision: *req.Revision,
+	}, *req.Enable)
+	switch {
+	case err == nil:
+		ctx.JSON(http.StatusOK, state)
+	case errors.Is(err, conf.ErrPathNotFound):
+		a.writeError(ctx, http.StatusNotFound, err)
+	case errors.Is(err, defs.ErrRecordingPermitConflict):
+		a.writeError(ctx, http.StatusConflict, err)
+	default:
+		a.writeError(ctx, http.StatusServiceUnavailable, fmt.Errorf("recording permit unavailable"))
+	}
+}
