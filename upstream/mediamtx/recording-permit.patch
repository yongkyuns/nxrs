+package core
+
+import (
+	"context"
+	"fmt"
+	"time"
+
+	"github.com/bluenviron/mediamtx/internal/defs"
+)
+
+const recordingPermitDuration = 3 * time.Second
+
+type recordingPermit struct {
+	state defs.APIRecordingPermit
+	until time.Time
+	timer *time.Timer
+}
+
+type recordingPermitRequest struct {
+	ctx      context.Context
+	expected defs.APIRecordingPermit
+	enable   bool
+	reply    chan recordingPermitResult
+}
+
+type recordingPermitResult struct {
+	state defs.APIRecordingPermit
+	err   error
+}
+
+func (pa *path) recordingAllowed() bool {
+	return pa.conf.Record && (pa.recordingPermit.timer == nil || time.Now().Before(pa.recordingPermit.until))
+}
+
+func (pa *path) recordingPermitState() *defs.APIRecordingPermit {
+	if pa.recordingPermit.timer == nil || !pa.conf.Record {
+		return nil
+	}
+	state := pa.recordingPermit.state
+	return &state
+}
+
+func (pa *path) recordWhenAvailable() {
+	if pa.stream != nil && pa.recorder == nil &&
+		(!pa.conf.AlwaysAvailable || pa.conf.AlwaysAvailableRecorded || pa.isOnline()) {
+		pa.startRecording()
+	}
+}
+
+func (pa *path) retireRecordingPermit() {
+	pa.recordingPermit.timer.Stop()
+	pa.recordingPermit.until = time.Time{}
+	pa.recordingPermit.state.Revision++
+	if pa.recorder != nil {
+		pa.recorder.Close()
+		pa.recorder = nil
+	}
+}
+
+func (pa *path) doRecordingPermit(req recordingPermitRequest) {
+	if ctxErr := req.ctx.Err(); ctxErr != nil {
+		req.reply <- recordingPermitResult{err: ctxErr}
+		return
+	}
+
+	permit := &pa.recordingPermit
+	if !permit.until.IsZero() && !time.Now().Before(permit.until) {
+		pa.retireRecordingPermit()
+	}
+	if !pa.conf.Record || req.expected != permit.state {
+		req.reply <- recordingPermitResult{err: defs.ErrRecordingPermitConflict}
+		return
+	}
+
+	if req.enable {
+		permit.state.Revision++
+		permit.until = time.Now().Add(recordingPermitDuration)
+		permit.timer.Reset(recordingPermitDuration)
+		pa.recordWhenAvailable()
+	} else {
+		// Retire and join the recorder before acknowledging the write.
+		pa.retireRecordingPermit()
+	}
+	req.reply <- recordingPermitResult{state: permit.state}
+}
+
+func (pa *path) setRecordingPermit(ctx context.Context, expected defs.APIRecordingPermit,
+	enable bool,
+) (defs.APIRecordingPermit, error) {
+	if pa.chRecordingPermit == nil {
+		return defs.APIRecordingPermit{}, defs.ErrRecordingPermitConflict
+	}
+	req := recordingPermitRequest{
+		ctx: ctx, expected: expected, enable: enable,
+		reply: make(chan recordingPermitResult, 1),
+	}
+	select {
+	case pa.chRecordingPermit <- req:
+		select {
+		case result := <-req.reply:
+			return result.state, result.err
+		case <-ctx.Done():
+			return defs.APIRecordingPermit{}, ctx.Err()
+		}
+	case <-ctx.Done():
+		return defs.APIRecordingPermit{}, ctx.Err()
+	case <-pa.ctx.Done():
+		return defs.APIRecordingPermit{}, fmt.Errorf("terminated")
+	}
+}
