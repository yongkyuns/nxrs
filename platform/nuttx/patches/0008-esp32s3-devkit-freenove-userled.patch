--- /dev/null
+++ b/boards/xtensa/esp32s3/esp32s3-devkit/src/esp32s3_freenove_userled.c
@@ -0,0 +1,44 @@
+/****************************************************************************
+ * boards/xtensa/esp32s3/esp32s3-devkit/src/esp32s3_freenove_userled.c
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ ****************************************************************************/
+
+#include <nuttx/config.h>
+#include <nuttx/board.h>
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "esp32s3_gpio.h"
+
+/* Freenove ESP32-S3-WROOM Blink tutorial: active-high onboard LED, GPIO2. */
+
+#define FREENOVE_LED_GPIO 2
+
+uint32_t board_userled_initialize(void)
+{
+  esp32s3_configgpio(FREENOVE_LED_GPIO, INPUT | OUTPUT);
+  esp32s3_gpiowrite(FREENOVE_LED_GPIO, false);
+  return 1;
+}
+
+void board_userled(int led, bool ledon)
+{
+  if (led == 0)
+    {
+      esp32s3_gpiowrite(FREENOVE_LED_GPIO, ledon);
+    }
+}
+
+void board_userled_all(uint32_t ledset)
+{
+  esp32s3_gpiowrite(FREENOVE_LED_GPIO, (ledset & 1u) != 0);
+}
+
+#ifdef CONFIG_USERLED_LOWER_READSTATE
+void board_userled_getall(uint32_t *ledset)
+{
+  *ledset = esp32s3_gpioread(FREENOVE_LED_GPIO) ? 1u : 0u;
+}
+#endif
