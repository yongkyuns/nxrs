diff --git a/llvm/lib/Target/Xtensa/XtensaInstrInfo.cpp b/llvm/lib/Target/Xtensa/XtensaInstrInfo.cpp
--- a/llvm/lib/Target/Xtensa/XtensaInstrInfo.cpp
+++ b/llvm/lib/Target/Xtensa/XtensaInstrInfo.cpp
@@ -52,3 +52,12 @@
       RI(STI), STI(STI) {}
 
+bool XtensaInstrInfo::isSchedulingBoundary(const MachineInstr &MI,
+                                         const MachineBasicBlock *MBB,
+                                         const MachineFunction &MF) const {
+  // LOOPSTART is not a terminator, but moving its body before it changes
+  // program semantics. Preserve this boundary for both scheduling passes.
+  return MI.getOpcode() == Xtensa::LOOPSTART ||
+         XtensaGenInstrInfo::isSchedulingBoundary(MI, MBB, MF);
+}
