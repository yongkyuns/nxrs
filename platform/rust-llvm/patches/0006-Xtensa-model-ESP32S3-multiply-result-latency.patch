 Register XtensaInstrInfo::isLoadFromStackSlot(const MachineInstr &MI,
diff --git a/llvm/test/CodeGen/Xtensa/esp32s3-multiply-scheduling.ll b/llvm/test/CodeGen/Xtensa/esp32s3-multiply-scheduling.ll
new file mode 100644
--- /dev/null
+++ b/llvm/test/CodeGen/Xtensa/esp32s3-multiply-scheduling.ll
@@ -0,0 +1,47 @@
+; RUN: llc -O2 -mtriple=xtensa -mcpu=esp32s3 -verify-machineinstrs < %s | FileCheck %s --check-prefix=S3
+; RUN: llc -O2 -mtriple=xtensa -mcpu=esp32s3 -enable-misched -verify-machineinstrs < %s | FileCheck %s --check-prefix=S3
+; RUN: llc -O2 -mtriple=xtensa -mcpu=esp32s2 -verify-machineinstrs < %s | FileCheck %s --check-prefix=S2
+
+; An independent XOR can cover MULL's second result-latency cycle. The
+; scheduling model and scheduler are selected by CPU, not an application flag.
+define i32 @multiply_and_xor(i32 %value, i32 %token, i32 %mixed) nounwind {
+; S3-LABEL: multiply_and_xor:
+; S3:       ssai 27
+; S3-NEXT:  src
+; S3:       mull [[PRODUCT:a[0-9]+]],
+; S3-NEXT:  xor [[MIX:a[0-9]+]],
+; S3-NEXT:  add{{(\.n)?}} a2, {{.*}}[[PRODUCT]]{{.*}}
+;
+; Other CPU profiles retain their previous source-level scheduler.
+; S2-LABEL: multiply_and_xor:
+; S2:       xor
+; S2:       mull
+  %rotated = call i32 @llvm.fshl.i32(i32 %value, i32 %value, i32 5)
+  %product = mul i32 %rotated, -1640531527
+  %mixed_token = xor i32 %token, %mixed
+  %result = add i32 %product, %mixed_token
+  ret i32 %result
+}
+
+declare i32 @llvm.fshl.i32(i32, i32, i32)
+
+; Moving MULL across LOOPSTART used to collapse this into one multiplication.
+define i32 @loop_boundary(i32 %seed, i32 %factor, i32 %count) {
+; S3-LABEL: loop_boundary:
+; S3: {{^[ \t]+loop(nez|gtz)?[ \t]}}
+; S3: mull
+; S3: retw
+entry:
+  %zero = icmp eq i32 %count, 0
+  br i1 %zero, label %exit, label %body
+body:
+  %value = phi i32 [ %seed, %entry ], [ %next, %body ]
+  %index = phi i32 [ 0, %entry ], [ %inc, %body ]
+  %next = mul i32 %value, %factor
+  %inc = add nuw i32 %index, 1
+  %more = icmp ult i32 %inc, %count
+  br i1 %more, label %body, label %exit
+exit:
+  %result = phi i32 [ %seed, %entry ], [ %next, %body ]
+  ret i32 %result
+}
