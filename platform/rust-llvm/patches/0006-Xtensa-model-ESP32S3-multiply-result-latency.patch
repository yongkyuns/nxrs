From: nxrs contributors
Subject: [PATCH 6/6] Xtensa: model ESP32-S3 low multiply result latency

ESP32-S3 device controls using identical portable C and Rust recurrences
show one additional cycle per iteration when an ADD immediately consumes
MULL. An independent integer operation in that slot removes the cycle.
The old NoSchedModel treats the multiply dependency as one cycle.

Describe the two-cycle result dependency for this CPU only. Leave the
model incomplete: unmeasured instructions retain the existing fallback,
and other configurable Xtensa CPUs keep their previous model.

Use the model-aware post-register-allocation machine scheduler for this CPU,
avoiding changes to register allocation. The legacy post-RA scheduler does
not enforce this model's single-issue width. Treat LOOPSTART as a scheduling
boundary so instructions cannot move out of a hardware-loop body.

diff --git a/llvm/lib/Target/Xtensa/Xtensa.td b/llvm/lib/Target/Xtensa/Xtensa.td
--- a/llvm/lib/Target/Xtensa/Xtensa.td
+++ b/llvm/lib/Target/Xtensa/Xtensa.td
@@ -14,3 +14,4 @@
 
 include "llvm/Target/Target.td"
+include "XtensaScheduleESP32S3.td"
 
@@ -218,3 +219,4 @@
                        FeatureCLAMPS, FeatureESP32S2Ops]>;
 
+let SchedModel = ESP32S3SchedModel in
 def : Proc<"esp32s3", [FeatureDensity, FeatureSingleFloat, FeatureLoop, FeatureMAC16, FeatureWindowed, FeatureBoolean, FeatureSEXT,
diff --git a/llvm/lib/Target/Xtensa/XtensaScheduleESP32S3.td b/llvm/lib/Target/Xtensa/XtensaScheduleESP32S3.td
new file mode 100644
--- /dev/null
+++ b/llvm/lib/Target/Xtensa/XtensaScheduleESP32S3.td
@@ -0,0 +1,22 @@
+//===- XtensaScheduleESP32S3.td - ESP32-S3 scheduling --------*- tablegen -*-===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+def ESP32S3SchedModel : SchedMachineModel {
+  let IssueWidth = 1;
+  let CompleteModel = 0;
+  let PostRAScheduler = 1;
+}
+
+def WriteESP32S3Mul32 : SchedWrite;
+
+let SchedModel = ESP32S3SchedModel in {
+  // The low-product result is available after two cycles. This is a result
+  // dependency, not a two-cycle reservation of the entire integer pipeline.
+  def : WriteRes<WriteESP32S3Mul32, []> { let Latency = 2; }
+  def : InstRW<[WriteESP32S3Mul32], (instregex "^MULL$")>;
+}
diff --git a/llvm/lib/Target/Xtensa/XtensaSubtarget.h b/llvm/lib/Target/Xtensa/XtensaSubtarget.h
--- a/llvm/lib/Target/Xtensa/XtensaSubtarget.h
+++ b/llvm/lib/Target/Xtensa/XtensaSubtarget.h
@@ -169,3 +169,7 @@
   bool isWinABI() const { return hasWindowed(); }
 
+  bool enablePostRAMachineScheduler() const override {
+    return getSchedModel().hasInstrSchedModel();
+  }
+
   bool hasDensity() const { return HasDensity; }
diff --git a/llvm/lib/Target/Xtensa/XtensaTargetMachine.cpp b/llvm/lib/Target/Xtensa/XtensaTargetMachine.cpp
--- a/llvm/lib/Target/Xtensa/XtensaTargetMachine.cpp
