diff --git a/llvm/test/CodeGen/Xtensa/wide-inequality-branch.ll b/llvm/test/CodeGen/Xtensa/wide-inequality-branch.ll
new file mode 100644
--- /dev/null
+++ b/llvm/test/CodeGen/Xtensa/wide-inequality-branch.ll
@@ -0,0 +1,182 @@
+; RUN: llc -mtriple=xtensa -mcpu=esp32s3 -verify-machineinstrs < %s | FileCheck %s --check-prefixes=CHECK,WINDOWED
+; RUN: llc -mtriple=xtensa -mcpu=esp32 -verify-machineinstrs < %s | FileCheck %s --check-prefixes=CHECK,WINDOWED
+; RUN: llc -mtriple=xtensa -mcpu=generic -verify-machineinstrs < %s | FileCheck %s --check-prefixes=CHECK,GENERIC
+; RUN: llc -mtriple=xtensa -mcpu=esp32s3 -verify-machineinstrs -filetype=obj < %s -o /dev/null
+; RUN: llc -mtriple=xtensa -mcpu=esp32 -verify-machineinstrs -filetype=obj < %s -o /dev/null
+; RUN: llc -mtriple=xtensa -mcpu=generic -verify-machineinstrs -filetype=obj < %s -o /dev/null
+
+@branch_yes = internal global i32 0, align 4
+@branch_no = internal global i32 0, align 4
+
+declare void @wide_branch_sink(i64, i64, i64, i64)
+
+define void @ne_i64_registers(i64 %lhs, i64 %rhs) {
+; CHECK-LABEL: ne_i64_registers:
+; CHECK:       bne a2, a4, [[NE_TRUE:.LBB[0-9]+_[0-9]+]]
+; CHECK:       bne a3, a5, [[NE_TRUE]]
+  %different = icmp ne i64 %lhs, %rhs
+  br i1 %different, label %yes, label %no, !prof !0
+yes:
+  store volatile i32 1, ptr @branch_yes
+  ret void
+no:
+  store volatile i32 2, ptr @branch_no
+  ret void
+}
+
+define void @ne_i64_nonzero_constant_halves(i64 %value) {
+; CHECK-LABEL: ne_i64_nonzero_constant_halves:
+; CHECK-DAG:   movi{{(\.n)?}} [[CONST_LOW:a[0-9]+]], 5
+; CHECK-DAG:   movi{{(\.n)?}} [[CONST_HIGH:a[0-9]+]], 1
+; CHECK:       bne a2, [[CONST_LOW]], [[CONST_TRUE:.LBB[0-9]+_[0-9]+]]
+; CHECK:       bne a3, [[CONST_HIGH]], [[CONST_TRUE]]
+  %different = icmp ne i64 %value, 4294967301
+  br i1 %different, label %yes, label %no, !prof !0
+yes:
+  store volatile i32 5, ptr @branch_yes
+  ret void
+no:
+  store volatile i32 6, ptr @branch_no
+  ret void
+}
+
+define void @ne_i64_far_target(i64 %lhs, i64 %rhs) {
+; CHECK-LABEL: ne_i64_far_target:
+; GENERIC-DAG: or [[LHS_LOW:a[0-9]+]], a2, a2
+; GENERIC-DAG: or [[LHS_HIGH:a[0-9]+]], a3, a3
+; WINDOWED:    beq a2, a4, [[HIGH:.LBB[0-9]+_[0-9]+]]
+; GENERIC:     beq [[LHS_LOW]], a4, [[HIGH:.LBB[0-9]+_[0-9]+]]
+; CHECK-NEXT:  j [[FAR_TRUE:.LBB[0-9]+_[0-9]+]]
+; CHECK:       [[HIGH]]:
+; WINDOWED-NEXT: beq a3, a5, [[PADDING:.LBB[0-9]+_[0-9]+]]
+; GENERIC-NEXT: beq [[LHS_HIGH]], a5, [[PADDING:.LBB[0-9]+_[0-9]+]]
+; CHECK-NEXT:  j [[FAR_TRUE]]
+; CHECK:       [[PADDING]]:
+; CHECK-COUNT-24: callx{{[08]}}
+; CHECK:       [[FAR_TRUE]]
+  %different = icmp ne i64 %lhs, %rhs
+  br i1 %different, label %far, label %padding, !prof !0
+padding:
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  call void @wide_branch_sink(i64 %lhs, i64 %rhs, i64 %lhs, i64 %rhs)
+  store volatile i32 3, ptr @branch_no
+  ret void
+far:
+  store volatile i32 4, ptr @branch_yes
+  ret void
+}
+
+define void @eq_i64_registers(i64 %lhs, i64 %rhs) {
+; CHECK-LABEL: eq_i64_registers:
+; CHECK:       bne a2, a4, [[EQ_FALSE:.LBB[0-9]+_[0-9]+]]
+; CHECK:       bne a3, a5, [[EQ_FALSE]]
+  %equal = icmp eq i64 %lhs, %rhs
+  br i1 %equal, label %yes, label %no, !prof !1
+yes:
+  store volatile i32 9, ptr @branch_yes
+  ret void
+no:
+  store volatile i32 10, ptr @branch_no
+  ret void
+}
+
+define i1 @ne_i64_value(i64 %lhs, i64 %rhs) {
+; CHECK-LABEL: ne_i64_value:
+; CHECK:       xor
+; CHECK:       or
+; CHECK:       ret
+  %different = icmp ne i64 %lhs, %rhs
+  ret i1 %different
+}
+
+; A comparison whose Boolean value is also observed must retain that value.
+; Eliminating its XOR/OR only for the branch would duplicate the work.
+define void @ne_i64_shared_value(i64 %lhs, i64 %rhs) {
+; CHECK-LABEL: ne_i64_shared_value:
+; CHECK:       xor
+; CHECK:       or
+; CHECK:       s32i
+; CHECK:       ret
+  %different = icmp ne i64 %lhs, %rhs
+  %value = zext i1 %different to i32
+  store volatile i32 %value, ptr @branch_yes
+  br i1 %different, label %yes, label %no, !prof !0
+yes:
+  store volatile i32 21, ptr @branch_yes
+  ret void
+no:
+  store volatile i32 22, ptr @branch_no
+  ret void
+}
+
+; One common half folds away an XOR, so the pair pattern must not match.
+define void @ne_common_low_half(i32 %low, i32 %lhs_high, i32 %rhs_high) {
+; CHECK-LABEL: ne_common_low_half:
+; CHECK:       xor [[DIFF:a[0-9]+]], a3, a4
+; CHECK-NOT:   or
+; CHECK:       bnez [[DIFF]],
+; CHECK:       ret
+  %lo = zext i32 %low to i64
+  %lhs = zext i32 %lhs_high to i64
+  %rhs = zext i32 %rhs_high to i64
+  %lhs_shifted = shl i64 %lhs, 32
+  %rhs_shifted = shl i64 %rhs, 32
+  %left = or i64 %lo, %lhs_shifted
+  %right = or i64 %lo, %rhs_shifted
+  %different = icmp ne i64 %left, %right
+  br i1 %different, label %yes, label %no, !prof !0
+yes:
+  store volatile i32 23, ptr @branch_yes
+  ret void
+no:
+  store volatile i32 24, ptr @branch_no
+  ret void
+}
+
+; The same physical source remains live through both word comparisons.
+define void @ne_repeated_left_word(i32 %word, i32 %rhs_low, i32 %rhs_high) {
+; CHECK-LABEL: ne_repeated_left_word:
+; CHECK:       bne a2, a3, [[ALIAS_TRUE:.LBB[0-9]+_[0-9]+]]
+; CHECK-NEXT:  bne a2, a4, [[ALIAS_TRUE]]
+; CHECK:       ret
+  %left_word = zext i32 %word to i64
+  %left_high = shl i64 %left_word, 32
+  %left = or i64 %left_word, %left_high
+  %right_low = zext i32 %rhs_low to i64
+  %right_high_word = zext i32 %rhs_high to i64
+  %right_high = shl i64 %right_high_word, 32
+  %right = or i64 %right_low, %right_high
+  %different = icmp ne i64 %left, %right
+  br i1 %different, label %yes, label %no, !prof !0
+yes:
+  store volatile i32 25, ptr @branch_yes
+  ret void
+no:
+  store volatile i32 26, ptr @branch_no
+  ret void
+}
+
+!0 = !{!"branch_weights", i32 1, i32 100}
+!1 = !{!"branch_weights", i32 100, i32 1}
