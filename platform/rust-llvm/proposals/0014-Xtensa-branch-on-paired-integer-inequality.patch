diff --git a/llvm/lib/Target/Xtensa/XtensaInstrInfo.td b/llvm/lib/Target/Xtensa/XtensaInstrInfo.td
--- a/llvm/lib/Target/Xtensa/XtensaInstrInfo.td
+++ b/llvm/lib/Target/Xtensa/XtensaInstrInfo.td
@@ -394,6 +394,21 @@
 
 def BEQ   : Branch_RR<0x01, "beq", SETEQ>;
 def BNE   : Branch_RR<0x09, "bne", SETNE>;
+
+// Keep both comparisons together until all operands have been scheduled and
+// allocated. Expanding two DAG branches separately can put a constant load
+// between terminators. This pseudo becomes two ordinary BNE instructions.
+def BNE_PAIR : Pseudo<(outs),
+    (ins AR:$lhslo, AR:$rhslo, AR:$lhshi, AR:$rhshi, brtarget:$target), "",
+    [(Xtensa_br_ne_pair AR:$lhslo, AR:$rhslo, AR:$lhshi, AR:$rhshi,
+                        bb:$target)]> {
+  let isBranch = 1;
+  let isTerminator = 1;
+  let hasSideEffects = 0;
+  let mayLoad = 0;
+  let mayStore = 0;
+  let Size = 6;
+}
 def BGE   : Branch_RR<0x0A, "bge", SETGE>;
 def BLT   : Branch_RR<0x02, "blt", SETLT>;
 def BGEU  : Branch_RR<0x0B, "bgeu", SETUGE>;
