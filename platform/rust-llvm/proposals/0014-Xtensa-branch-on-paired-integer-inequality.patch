diff --git a/llvm/lib/Target/Xtensa/XtensaInstrInfo.cpp b/llvm/lib/Target/Xtensa/XtensaInstrInfo.cpp
--- a/llvm/lib/Target/Xtensa/XtensaInstrInfo.cpp
+++ b/llvm/lib/Target/Xtensa/XtensaInstrInfo.cpp
@@ -49,6 +49,27 @@
 XtensaInstrInfo::XtensaInstrInfo(const XtensaSubtarget &STI)
     : XtensaGenInstrInfo(Xtensa::ADJCALLSTACKDOWN, Xtensa::ADJCALLSTACKUP),
       RI(STI), STI(STI) {}
+
+bool XtensaInstrInfo::expandPostRAPseudo(MachineInstr &MI) const {
+  if (MI.getOpcode() != Xtensa::BNE_PAIR)
+    return false;
+
+  MachineBasicBlock &MBB = *MI.getParent();
+  for (unsigned Pair = 0; Pair != 2; ++Pair) {
+    auto Branch = BuildMI(MBB, MI.getIterator(), MI.getDebugLoc(),
+                          get(Xtensa::BNE));
+    for (unsigned Op = Pair * 2; Op != Pair * 2 + 2; ++Op) {
+      MachineOperand Operand = MI.getOperand(Op);
+      // Allocation can alias operands of the two comparisons. A kill on the
+      // first branch must not invalidate a register needed by the second.
+      Operand.setIsKill(false);
+      Branch.add(Operand);
+    }
+    Branch.add(MI.getOperand(4)).setMIFlags(MI.getFlags());
+  }
+  MI.eraseFromParent();
+  return true;
+}
 
