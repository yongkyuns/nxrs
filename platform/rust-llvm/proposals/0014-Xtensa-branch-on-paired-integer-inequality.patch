From: nxrs contributors
Subject: [PATCH RFC] Xtensa: branch directly on paired integer inequality

Type legalization expands wide equality/inequality into OR(XOR, XOR). When
the Boolean is used only for control flow, compare the two register pairs
directly. Handle both DAG predicate polarities, swapping a following
unconditional branch together with an inverted equality predicate.

Keep the pair in one six-byte pseudo through scheduling and allocation;
expand after allocation to ordinary BNEs with the same destination. This
avoids materializing operands between terminators. Clear copied kill flags
because source registers may alias across the two comparisons. Leave the
compound condition unanalyzable by the single-predicate branch interface.

Regressions cover both source polarities, nonzero constants, shared/value-only
Boolean results, a common half, repeated source operands and native objects
on generic, ESP32 and ESP32-S3. The far-target case checks both independently
relaxed predicates and their common long-jump destination. No application
assembly, special literal, feature flag or target-layout change is required.
Device profitability is qualified independently; this remains an RFC.

diff --git a/llvm/lib/Target/Xtensa/XtensaISelLowering.cpp b/llvm/lib/Target/Xtensa/XtensaISelLowering.cpp
--- a/llvm/lib/Target/Xtensa/XtensaISelLowering.cpp
+++ b/llvm/lib/Target/Xtensa/XtensaISelLowering.cpp
@@ -381,9 +381,7 @@
     setTargetDAGCombine(ISD::BRCOND);
   }
 
-  if (Subtarget.hasLoop()) {
-    setTargetDAGCombine(ISD::BR_CC);
-  }
+  setTargetDAGCombine(ISD::BR_CC);
 
   // make BRCOND legal, its actually only legal for a subset of conds
   setOperationAction(ISD::BRCOND, MVT::Other, Legal);
@@ -754,6 +752,44 @@
   return SDValue();
 }
 
+static SDValue PerformInequalityBranchCombine(SDNode *N, SelectionDAG &DAG) {
+  ISD::CondCode CC = cast<CondCodeSDNode>(N->getOperand(1))->get();
+  SDValue LHS = N->getOperand(2);
+  SDValue RHS = N->getOperand(3);
+  if ((CC != ISD::SETNE && CC != ISD::SETEQ) ||
+      LHS.getValueType() != MVT::i32 || !isNullConstant(RHS) ||
+      LHS.getOpcode() != ISD::OR || !LHS.hasOneUse())
+    return SDValue();
+
+  SDValue Low = LHS.getOperand(0), High = LHS.getOperand(1);
+  if (Low.getOpcode() != ISD::XOR || High.getOpcode() != ISD::XOR ||
+      !Low.hasOneUse() || !High.hasOneUse())
+    return SDValue();
+
+  SDValue Dest = N->getOperand(4);
+  if (CC == ISD::SETEQ) {
+    // DAG construction may invert a source inequality to branch on equality.
+    // Invert the two-way terminators together, not just their predicate.
+    if (!N->hasOneUse() || N->use_begin()->getUser()->getOpcode() != ISD::BR)
+      return SDValue();
+    SDNode *Br = N->use_begin()->getUser();
+    SDValue OtherTarget = Br->getOperand(1);
+    SDValue NewBr = DAG.getNode(ISD::BR, SDLoc(Br), MVT::Other,
+                                Br->getOperand(0), Dest);
+    DAG.ReplaceAllUsesOfValueWith(SDValue(Br, 0), NewBr);
+    Dest = OtherTarget;
+  }
+
+  // Integer type legalization expands wide inequality to OR(XOR, XOR).
+  // Branch directly on each pair instead of materializing that Boolean.
+  // Both branches target the same block and retain the original fallthrough.
+  // Single-use guards avoid adding branches while keeping the Boolean work.
+  SDLoc DL(N);
+  SDValue Ops[] = {N->getOperand(0), Low.getOperand(0), Low.getOperand(1),
+                   High.getOperand(0), High.getOperand(1), Dest};
+  return DAG.getNode(XtensaISD::BR_NE_PAIR, DL, MVT::Other, Ops);
+}
+
 static SDValue PerformHWLoopCombine(SDNode *N, SelectionDAG &DAG,
                                     TargetLowering::DAGCombinerInfo &DCI,
                                     const XtensaSubtarget &Subtarget) {
@@ -968,7 +1004,11 @@
   case ISD::FSUB:
     return performSUBCombine(N, DAG, DCI, Subtarget);
   case ISD::BR_CC:
-    return PerformHWLoopCombine(N, DAG, DCI, Subtarget);
+    if (SDValue Combined = PerformInequalityBranchCombine(N, DAG))
+      return Combined;
+    if (Subtarget.hasLoop())
+      return PerformHWLoopCombine(N, DAG, DCI, Subtarget);
+    break;
   case ISD::BRCOND:
     return PerformBRCONDCombine(N, DAG, DCI, Subtarget);
   case ISD::BUILD_VECTOR:
@@ -2374,6 +2414,8 @@
     return "XtensaISD::BR_F";
   case XtensaISD::BR_CC_FP:
     return "XtensaISD::BR_CC_FP";
+  case XtensaISD::BR_NE_PAIR:
+    return "XtensaISD::BR_NE_PAIR";
   case XtensaISD::SRCL:
     return "XtensaISD::SRCL";
   case XtensaISD::SRCR:
